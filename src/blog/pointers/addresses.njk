<script>


// ═══════════════════════════════════════════════════════════════════════════
// VIZ 1: TWO VIEWS OF THE SAME CODE
// ═══════════════════════════════════════════════════════════════════════════
let v1Step=0;
let v1View='names';
const V1_STEPS=4;
const v1CodeEl=document.getElementById('v1Code');
const v1ViewEl=document.getElementById('v1View');

function setV1Step(s){
  v1Step=Math.max(0,Math.min(V1_STEPS-1,s));
  document.querySelectorAll('.v1-code-line').forEach((el,i)=>{
    el.classList.toggle('active',i===v1Step);
  });
  renderV1();
}

function renderV1(){
  const W=v1ViewEl.clientWidth;
  // state after each step
  // step 0: x=42 exists; p doesn't; y doesn't
  // step 1: p=&x
  // step 2: y = *p (y=42, x still 42)
  // step 3: *p = 99 (x now 99)
  const state={
    xVal: v1Step>=3? 99 : 42,
    xAddr: '0x1014',
    pVal: v1Step>=1 ? '0x1014' : null,
    pAddr: '0x1030',
    yVal: v1Step>=2 ? (v1Step>=3 ? 42 : 42) : null, // y captured at step 2 so always 42
    yAddr: '0x1018',
    pExists: v1Step>=1,
    yExists: v1Step>=2,
  };
  // highlight what each step touches
  const touched={
    x: v1Step===0 || v1Step===3,
    p: v1Step===1 || v1Step===2 || v1Step===3,
    y: v1Step===2,
  };

  // layout: three boxes in a row
  const isNames=v1View==='names';
  let html='';
  const boxes=[
    {name:'x', val: state.xVal, addr:state.xAddr, kind:'on', show:true, hi:touched.x},
    {name:'p', val: state.pVal || '?', addr:state.pAddr, kind:'ptr', show:state.pExists, hi:touched.p},
    {name:'y', val: state.yVal!==null? state.yVal : '?', addr:state.yAddr, kind:'on', show:state.yExists, hi:touched.y},
  ];
  const cols=boxes.filter(b=>b.show).length;
  const colWidth=100/Math.max(cols,1);
  let visIdx=0;
  boxes.forEach(b=>{
    if(!b.show)return;
    const left=visIdx*colWidth + colWidth/2;
    const label=isNames ? b.name : b.addr;
    const val = b.val;
    html+=`<div class="v1-slot ${b.kind} ${b.hi?'highlight':''}" style="left:calc(${left}% - 55px);top:50%;transform:translateY(-50%)">
      <div class="slot-label">${label}</div>
      <div class="slot-val">${val}</div>
      ${isNames ? `<div class="slot-addr">@ ${b.addr}</div>` : `<div class="slot-addr">${b.name}</div>`}
    </div>`;
    visIdx++;
  });

  // arrow from p to x if p exists
  if(state.pExists){
    // find positions
    const pIdx=boxes.findIndex(b=>b.name==='p');
    const xIdx=0;
    const visBoxes=boxes.filter(b=>b.show);
    const pVis=visBoxes.findIndex(b=>b.name==='p');
    const xVis=visBoxes.findIndex(b=>b.name==='x');
    if(pVis>=0 && xVis>=0){
      const pX=(pVis+0.5)*colWidth;
      const xX=(xVis+0.5)*colWidth;
      // svg arrow
      html+=`<svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none" viewBox="0 0 100 100" preserveAspectRatio="none">
        <defs><marker id="ar" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><polygon points="0 0, 6 3, 0 6" fill="#b5541c"/></marker></defs>
        <path d="M${pX} 30 Q ${(pX+xX)/2} 10 ${xX} 30" stroke="#b5541c" stroke-width="0.5" fill="none" marker-end="url(#ar)" opacity="0.8"/>
      </svg>`;
    }
  }

  // explanation line
  const explanations=[
    'Step 1: x is declared and set to 42. It lives at some address the compiler picked.',
    'Step 2: p is declared. &x gives us x\'s address (0x1014), and we store it in p. Now p points to x.',
    'Step 3: *p reads through the pointer. We follow p to 0x1014 and copy what\'s there (42) into y.',
    'Step 4: *p = 99 writes through the pointer. We follow p back to x\'s address and put 99 there. x is now 99.',
  ];
  html+=`<div style="position:absolute;bottom:8px;left:10px;right:10px;font-size:.78rem;color:var(--muted);font-style:italic;text-align:center;line-height:1.4">${explanations[v1Step]}</div>`;

  v1ViewEl.innerHTML=html;
}

document.querySelectorAll('.v1-toggle .btn').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('.v1-toggle .btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    v1View=b.dataset.view;
    renderV1();
  });
});
document.querySelectorAll('.v1-code-line').forEach((el,i)=>{
  el.addEventListener('click',()=>setV1Step(i));
});
document.getElementById('v1Prev').addEventListener('click',()=>setV1Step(v1Step-1));
document.getElementById('v1Next').addEventListener('click',()=>setV1Step(v1Step+1));
document.getElementById('v1Reset').addEventListener('click',()=>setV1Step(0));
setV1Step(0);
window.addEventListener('resize',renderV1);

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 2: DEREFERENCE AS NAVIGATION (canvas)
// ═══════════════════════════════════════════════════════════════════════════
const v2Canvas=document.getElementById('v2Canvas');
const v2Expr=document.getElementById('v2Expr');
const v2XEl=document.getElementById('v2X');
const v2XaEl=document.getElementById('v2Xa');
const v2PEl=document.getElementById('v2P');
const v2PaEl=document.getElementById('v2Pa');

let v2State={xVal:42, xAddr:0x1014, pVal:0x1014, pAddr:0x1030};
let v2Anim=null; // current animation

function hex(n){return '0x'+n.toString(16);}
function updateV2Stats(){
  v2XEl.textContent=v2State.xVal;
  v2XaEl.textContent=hex(v2State.xAddr);
  v2PEl.textContent=hex(v2State.pVal);
  v2PaEl.textContent=hex(v2State.pAddr);
}
updateV2Stats();

function setupV2Canvas(){
  const dpr=window.devicePixelRatio||1;
  const rect=v2Canvas.getBoundingClientRect();
  const W=Math.max(500,rect.width);
  const H=280;
  v2Canvas.width=W*dpr;v2Canvas.height=H*dpr;
  v2Canvas.style.height=H+'px';
  const ctx=v2Canvas.getContext('2d');
  ctx.setTransform(1,0,0,1,0,0);ctx.scale(dpr,dpr);
  return{ctx,W,H};
}

function drawV2(anim){
  const{ctx,W,H}=setupV2Canvas();
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  // Two boxes: x on left, p on right
  const boxW=130, boxH=80;
  const xBox={x:W*0.22-boxW/2, y:H/2-boxH/2, w:boxW, h:boxH};
  const pBox={x:W*0.72-boxW/2, y:H/2-boxH/2, w:boxW, h:boxH};

  // Draw x
  const xActive=anim && (anim.target==='x'||anim.target==='xAddr');
  drawV2Slot(ctx, xBox, 'x', String(v2State.xVal), hex(v2State.xAddr), 'blue', xActive);

  // Draw p (pointer to x)
  const pActive=anim && (anim.target==='p'||anim.target==='pAddr');
  drawV2Slot(ctx, pBox, 'p', hex(v2State.pVal), hex(v2State.pAddr), 'accent', pActive);

  // Draw fixed arrow from p to x showing the pointer relationship (subtle)
  ctx.strokeStyle='rgba(181,84,28,0.35)';
  ctx.lineWidth=1.2;
  ctx.setLineDash([4,3]);
  ctx.beginPath();
  ctx.moveTo(pBox.x, pBox.y+boxH/2);
  ctx.bezierCurveTo(pBox.x-50, pBox.y+boxH/2-40, xBox.x+boxW+50, pBox.y+boxH/2-40, xBox.x+boxW, xBox.y+boxH/2);
  ctx.stroke();
  ctx.setLineDash([]);

  // Animated traveller
  if(anim && anim.path){
    const t=Math.min(1, anim.t);
    // Bezier eval
    const pt=bezierPoint(anim.path, t);
    // draw head
    ctx.fillStyle=anim.color;
    ctx.strokeStyle=anim.color;
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.arc(pt.x, pt.y, 8, 0, Math.PI*2);
    ctx.fill();
    // label
    ctx.fillStyle='#fff';
    ctx.font='600 10px "Source Sans 3",sans-serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(anim.label||'',pt.x,pt.y);
    // trail
    ctx.strokeStyle=anim.color.replace(/[\d.]+\)/,'0.35)');
    ctx.lineWidth=1.5;
    ctx.beginPath();
    for(let i=0;i<=20;i++){
      const tt=t*(i/20);
      const p=bezierPoint(anim.path,tt);
      if(i===0)ctx.moveTo(p.x,p.y);else ctx.lineTo(p.x,p.y);
    }
    ctx.stroke();
  }

  // Expression being evaluated, floating at top
  if(anim && anim.caption){
    ctx.fillStyle='rgba(181,84,28,0.85)';
    ctx.font='italic 13px "Source Sans 3",sans-serif';
    ctx.textAlign='center';ctx.textBaseline='top';
    ctx.fillText(anim.caption, W/2, 14);
  }
}
function drawV2Slot(ctx, box, name, val, addr, color, active){
  const fills={blue:{bg:'rgba(46,90,125,0.14)',br:'rgba(46,90,125,0.7)'},accent:{bg:'rgba(181,84,28,0.14)',br:'rgba(181,84,28,0.8)'}};
  const c=fills[color];
  ctx.fillStyle=c.bg;
  ctx.strokeStyle=c.br;
  ctx.lineWidth=active?2.5:1.5;
  roundRect(ctx, box.x, box.y, box.w, box.h, 8);
  ctx.fill();ctx.stroke();
  if(active){
    ctx.strokeStyle='rgba(10,125,82,0.8)';
    ctx.lineWidth=1.5;
    roundRect(ctx, box.x-4, box.y-4, box.w+8, box.h+8, 10);
    ctx.stroke();
  }
  // name
  ctx.fillStyle='#57503f';
  ctx.font='600 13px "Source Sans 3",sans-serif';
  ctx.textAlign='center';ctx.textBaseline='top';
  ctx.fillText(name, box.x+box.w/2, box.y+8);
  // value
  ctx.font='600 15px "Courier New",monospace';
  ctx.fillStyle=color==='blue'?'#2e5a7d':'#b5541c';
  ctx.fillText(val, box.x+box.w/2, box.y+28);
  // address label
  ctx.font='400 10px "Courier New",monospace';
  ctx.fillStyle='rgba(138,129,114,0.55)';
  ctx.fillText('@ '+addr, box.x+box.w/2, box.y+box.h-16);
}
function roundRect(ctx,x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}
function bezierPoint(pts,t){
  const[p0,p1,p2,p3]=pts;
  const u=1-t;
  return{
    x:u*u*u*p0.x + 3*u*u*t*p1.x + 3*u*t*t*p2.x + t*t*t*p3.x,
    y:u*u*u*p0.y + 3*u*u*t*p1.y + 3*u*t*t*p2.y + t*t*t*p3.y
  };
}

function startExprAnim(expr){
  const{W,H}=setupV2Canvas();
  const boxW=130, boxH=80;
  const xBoxMid={x:W*0.22, y:H/2};
  const pBoxMid={x:W*0.72, y:H/2};
  let anim=null;
  let resultText='';

  if(expr==='x'){
    // just read x's value
    anim={
      target:'x',
      caption:'x  →  reads x\'s value directly',
      path:[{x:W*0.45,y:H*0.15},{x:W*0.3,y:H*0.3},{x:xBoxMid.x,y:H*0.4},{x:xBoxMid.x,y:xBoxMid.y-8}],
      label:String(v2State.xVal),
      color:'rgba(46,90,125,0.9)',
      t:0
    };
    resultText=`x = ${v2State.xVal}`;
  } else if(expr==='&x' || expr==='&amp;x'){
    anim={
      target:'xAddr',
      caption:'&x  →  returns the address where x lives',
      path:[{x:W*0.45,y:H*0.15},{x:W*0.3,y:H*0.3},{x:xBoxMid.x,y:H*0.4},{x:xBoxMid.x,y:xBoxMid.y-8}],
      label:'@',
      color:'rgba(10,125,82,0.9)',
      t:0
    };
    resultText=`&x = ${hex(v2State.xAddr)}`;
  } else if(expr==='p'){
    anim={
      target:'p',
      caption:'p  →  reads p\'s value (which is an address)',
      path:[{x:W*0.55,y:H*0.15},{x:W*0.65,y:H*0.3},{x:pBoxMid.x,y:H*0.4},{x:pBoxMid.x,y:pBoxMid.y-8}],
      label:'adr',
      color:'rgba(181,84,28,0.9)',
      t:0
    };
    resultText=`p = ${hex(v2State.pVal)}`;
  } else if(expr==='*p'){
    anim={
      target:'p',
      caption:'*p  →  hop 1: go fetch p (the address)',
      path:[{x:W*0.5,y:H*0.15},{x:W*0.55,y:H*0.25},{x:pBoxMid.x,y:H*0.35},{x:pBoxMid.x,y:pBoxMid.y-8}],
      label:'1',
      color:'rgba(181,84,28,0.9)',
      t:0,
      next:{
        target:'x',
        caption:'*p  →  hop 2: follow that address, fetch what\'s there',
        path:[{x:pBoxMid.x,y:pBoxMid.y-8},{x:W*0.55,y:H*0.7},{x:W*0.35,y:H*0.7},{x:xBoxMid.x,y:xBoxMid.y-8}],
        label:String(v2State.xVal),
        color:'rgba(10,125,82,0.9)',
        t:0
      }
    };
    resultText=`*p = ${v2State.xVal}`;
  } else if(expr==='*p=77'){
    anim={
      target:'p',
      caption:'*p = 77  →  hop 1: read p\'s address',
      path:[{x:W*0.5,y:H*0.15},{x:W*0.55,y:H*0.25},{x:pBoxMid.x,y:H*0.35},{x:pBoxMid.x,y:pBoxMid.y-8}],
      label:'1',
      color:'rgba(181,84,28,0.9)',
      t:0,
      next:{
        target:'x',
        caption:'*p = 77  →  hop 2: travel to that address',
        path:[{x:pBoxMid.x,y:pBoxMid.y-8},{x:W*0.55,y:H*0.7},{x:W*0.35,y:H*0.7},{x:xBoxMid.x,y:xBoxMid.y-8}],
        label:'77',
        color:'rgba(168,60,44,0.9)',
        t:0,
        onDone:()=>{v2State.xVal=77; updateV2Stats(); showV2Expr(`*p = 77  →  x is now 77`);}
      }
    };
    resultText=`writing 77 through p...`;
  } else if(expr==='reset'){
    v2State={xVal:42, xAddr:0x1014, pVal:0x1014, pAddr:0x1030};
    updateV2Stats();
    showV2Expr('Click an expression below to see it evaluate.');
    v2Anim=null;
    drawV2(null);
    return;
  }

  v2Anim=anim;
  showV2Expr(anim.caption+(resultText?`  →  <span class="result">${resultText}</span>`:''));
  animV2();
}

function showV2Expr(html){
  v2Expr.innerHTML=`<span>${html}</span>`;
}

function animV2(){
  if(!v2Anim){drawV2(null);return;}
  v2Anim.t+=0.025;
  if(v2Anim.t>=1){
    v2Anim.t=1;
    drawV2(v2Anim);
    if(v2Anim.next){
      if(v2Anim.onDone)v2Anim.onDone();
      const next=v2Anim.next;
      v2Anim=next;
      if(next.caption)showV2Expr(next.caption);
      requestAnimationFrame(animV2);
    }else{
      if(v2Anim.onDone)v2Anim.onDone();
      // hold briefly then clear
      setTimeout(()=>{v2Anim=null;drawV2(null);},1200);
    }
    return;
  }
  drawV2(v2Anim);
  requestAnimationFrame(animV2);
}

document.querySelectorAll('[data-expr]').forEach(b=>{
  b.addEventListener('click',()=>startExprAnim(b.dataset.expr));
});
drawV2(null);
window.addEventListener('resize',()=>drawV2(v2Anim));

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: DECLARATION PARSER
// ═══════════════════════════════════════════════════════════════════════════
const v3Input=document.getElementById('v3Input');
const v3Result=document.getElementById('v3Result');

/**
 * Parse a simple C declaration like "int* a, b;" or "int *a, *b;" or "int** pp;"
 * Returns { ok, tokens, vars, explain }
 * This is a deliberately tiny parser; covers beginner cases only.
 */
function parseDecl(s){
  // normalise
  s=s.trim().replace(/;$/,'').trim();
  if(!s)return{ok:false,err:'empty declaration'};

  const qualifiers=[];
  const keywords=['const','volatile','static','unsigned','signed'];
  const types=['int','char','float','double','long','short','void'];

  // First pass: split so that stars are always their own token (or attached to names).
  // We normalise by inserting spaces around stars, then re-splitting.
  // But we have to be careful: "int** pp" -> "int * *  pp" -> tokens ['int','*','*','pp']
  const normalised=s.replace(/\*/g,' * ').replace(/,/g,' , ').replace(/\s+/g,' ').trim();
  const parts=normalised.split(' ');

  let i=0;
  let base='';
  // pull keywords + base type
  while(i<parts.length){
    const p=parts[i];
    if(keywords.includes(p)){qualifiers.push(p);i++;continue;}
    if(types.includes(p)){base=p;i++;break;}
    break;
  }
  if(!base)return{ok:false,err:'type not recognised (try int, char, float, double, void)'};

  // Remaining tokens are stars, commas, and identifiers.
  // Group them into declarators: each declarator is (stars*) identifier
  const remaining=parts.slice(i);
  const vars=[];
  let stars=0;
  for(let k=0;k<remaining.length;k++){
    const tok=remaining[k];
    if(tok==='*'){stars++;continue;}
    if(tok===','){stars=0;continue;}
    // must be an identifier
    if(!/^[A-Za-z_][A-Za-z0-9_]*$/.test(tok)){
      return{ok:false,err:`cannot parse "${tok}"`};
    }
    vars.push({name:tok, stars, type: base + '*'.repeat(stars)});
    stars=0;
  }
  if(vars.length===0)return{ok:false,err:'missing variable name'};

  // Build token list for display. We always render stars attached to the variable,
  // which reflects how C actually parses them, regardless of what the user typed.
  const rendered=[];
  qualifiers.forEach(q=>rendered.push({kind:'kw',text:q}));
  rendered.push({kind:'type',text:base});
  vars.forEach((v,idx)=>{
    if(idx>0)rendered.push({kind:'comma',text:','});
    for(let k=0;k<v.stars;k++)rendered.push({kind:'star',text:'*'});
    rendered.push({kind:'var',text:v.name});
  });

  return{ok:true, tokens:rendered, vars, base, qualifiers};
}

function renderV3(){
  const s=v3Input.value;
  const parsed=parseDecl(s);
  if(!parsed.ok){
    v3Result.innerHTML=`<div class="v3-error">Parse error: ${parsed.err}. Try something like <code>int* p;</code> or <code>int *a, *b;</code></div>`;
    return;
  }

  // Render the annotated reading line
  let readingHTML='';
  parsed.tokens.forEach(t=>{
    readingHTML+=`<span class="tok ${t.kind}">${t.text}</span>`;
  });

  // Render variable cards
  let varsHTML='';
  parsed.vars.forEach(v=>{
    const isPtr=v.stars>0;
    const kind=isPtr?'ptr':'val';
    const kindLabel=isPtr?(v.stars===1?'pointer':`pointer-to-pointer (${v.stars}×)`):'plain value';
    varsHTML+=`<div class="v3-var-card ${kind}">
      <div class="v3-var-name">${v.name}</div>
      <div class="v3-var-type">${v.type}</div>
      <div class="v3-var-kind">${kindLabel}</div>
    </div>`;
  });

  // Build an explanation
  let explainHTML='';
  const nPtrs=parsed.vars.filter(v=>v.stars>0).length;
  const nVals=parsed.vars.filter(v=>v.stars===0).length;

  if(parsed.vars.length===1){
    const v=parsed.vars[0];
    if(v.stars===0){
      explainHTML=`Straightforward. <code>${v.name}</code> is a plain <code>${parsed.base}</code>.`;
    }else if(v.stars===1){
      explainHTML=`<code>${v.name}</code> is a pointer to <code>${parsed.base}</code>. Reading the declaration right-to-left: "${v.name} is a pointer to ${parsed.base}."`;
    }else{
      explainHTML=`<code>${v.name}</code> is a pointer to a pointer ${v.stars>2?`(${v.stars} levels deep)`:''}. Each <code>*</code> adds a level of indirection.`;
    }
  }else{
    if(nPtrs>0 && nVals>0){
      const ptrNames=parsed.vars.filter(v=>v.stars>0).map(v=>`<code>${v.name}</code>`).join(', ');
      const valNames=parsed.vars.filter(v=>v.stars===0).map(v=>`<code>${v.name}</code>`).join(', ');
      explainHTML=`<strong>Classic trap.</strong> ${ptrNames} ${nPtrs===1?'is a pointer':'are pointers'}, but ${valNames} ${nVals===1?'is':'are'} plain <code>${parsed.base}</code>${nVals>1?'s':''}. The <code>*</code> only binds to the variable immediately next to it, not to the type. If you meant all pointers, each name needs its own <code>*</code>.`;
    }else if(nPtrs===parsed.vars.length){
      explainHTML=`All variables are pointers. Each name got its own <code>*</code>, which is the safe way to write multi-declarations.`;
    }else{
      explainHTML=`All variables are plain <code>${parsed.base}</code>s. No pointers here.`;
    }
  }

  v3Result.innerHTML=`
    <div class="v3-reading">${readingHTML}</div>
    <div class="v3-vars">${varsHTML}</div>
    <div class="v3-explain">${explainHTML}</div>
  `;
}

v3Input.addEventListener('input',renderV3);
document.querySelectorAll('[data-decl]').forEach(b=>{
  b.addEventListener('click',()=>{
    v3Input.value=b.dataset.decl;
    renderV3();
  });
});
renderV3();

// ═══════════════════════════════════════════════════════════════════════════
// QUIZ: option selection + reveal
// ═══════════════════════════════════════════════════════════════════════════
// Single-select and multi-select quiz questions
document.querySelectorAll('.quiz-options').forEach(group=>{
  const isMulti=group.classList.contains('multi');
  const correctAnswers=group.dataset.answer.split(',');
  group.querySelectorAll('.quiz-option').forEach(opt=>{
    opt.addEventListener('click',()=>{
      if(isMulti){
        opt.classList.toggle('selected');
      }else{
        group.querySelectorAll('.quiz-option').forEach(o=>o.classList.remove('selected'));
        opt.classList.add('selected');
      }
      // Don't reveal correctness yet, wait for the reveal button
    });
  });
});

// Reveal buttons
document.querySelectorAll('[data-reveal]').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const id=btn.dataset.reveal;
    const answer=document.getElementById(id);
    if(!answer)return;
    answer.classList.toggle('show');
    btn.textContent=answer.classList.contains('show')?'Hide answer':'Reveal answer';

    // Also grade any quiz-options inside the same card
    const card=btn.closest('.quiz-card');
    if(card){
      const group=card.querySelector('.quiz-options');
      if(group && answer.classList.contains('show')){
        const correct=group.dataset.answer.split(',');
        group.querySelectorAll('.quiz-option').forEach(opt=>{
          const val=opt.dataset.val;
          const isSelected=opt.classList.contains('selected');
          const isCorrect=correct.includes(val);
          if(isCorrect){
            opt.classList.add('correct');
          }else if(isSelected){
            opt.classList.add('incorrect');
          }
        });
      }else if(group && !answer.classList.contains('show')){
        // Reset on hide
        group.querySelectorAll('.quiz-option').forEach(opt=>{
          opt.classList.remove('correct','incorrect');
        });
      }
    }
  });
});

</script>
