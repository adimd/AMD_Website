<script>

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 1: Contiguity vs pointing-to
// ═══════════════════════════════════════════════════════════════════════════
const v1ArrCanvas=document.getElementById('v1Arr');
const v1PtrCanvas=document.getElementById('v1Ptr');

function setupCanvas(c, height){
  const dpr=window.devicePixelRatio||1;
  const rect=c.getBoundingClientRect();
  const W=Math.max(320,rect.width);
  const H=height;
  c.width=W*dpr;c.height=H*dpr;
  c.style.height=H+'px';
  const ctx=c.getContext('2d');
  ctx.setTransform(1,0,0,1,0,0);ctx.scale(dpr,dpr);
  return{ctx,W,H};
}
function roundRect(ctx,x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}

function drawV1Arr(){
  const{ctx,W,H}=setupCanvas(v1ArrCanvas,120);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  // Draw array as one green region with 5 cells
  const padL=24, padR=24;
  const regionW=W-padL-padR;
  const cellW=regionW/5;
  const cellY=32, cellH=50;
  const values=[10,20,30,40,50];

  // overall region glow
  ctx.fillStyle='rgba(10,125,82,0.08)';
  roundRect(ctx, padL-4, cellY-4, regionW+8, cellH+8, 8);
  ctx.fill();

  for(let i=0;i<5;i++){
    const x=padL+i*cellW;
    ctx.fillStyle='rgba(10,125,82,0.22)';
    ctx.strokeStyle='rgba(10,125,82,0.7)';
    ctx.lineWidth=1.5;
    roundRect(ctx, x+2, cellY, cellW-4, cellH, 4);
    ctx.fill();ctx.stroke();
    ctx.fillStyle='#0a7d52';
    ctx.font='600 14px "Courier New",monospace';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(values[i], x+cellW/2, cellY+cellH/2);
    // address below
    ctx.fillStyle='rgba(138,129,114,0.5)';
    ctx.font='400 10px "Courier New",monospace';
    ctx.fillText('0x'+(0x1000+i*4).toString(16), x+cellW/2, cellY+cellH+14);
  }

  // label on top
  ctx.fillStyle='rgba(10,125,82,0.9)';
  ctx.font='italic 11px "Source Sans 3",sans-serif';
  ctx.textAlign='center';ctx.textBaseline='top';
  ctx.fillText('arr  (type: int[5], size: 20 bytes, one contiguous region)', W/2, 10);

  // braces showing the whole region
  ctx.strokeStyle='rgba(10,125,82,0.6)';
  ctx.lineWidth=1.5;
  const bY=cellY+cellH+24;
  ctx.beginPath();
  ctx.moveTo(padL,bY);ctx.lineTo(padL,bY+6);ctx.lineTo(W-padR,bY+6);ctx.lineTo(W-padR,bY);
  ctx.stroke();
  ctx.fillStyle='rgba(10,125,82,0.8)';
  ctx.font='600 10px "Courier New",monospace';
  ctx.textAlign='center';ctx.textBaseline='top';
  ctx.fillText('sizeof(arr) = 20', W/2, bY+9);
}

function drawV1Ptr(){
  const{ctx,W,H}=setupCanvas(v1PtrCanvas,120);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  // Draw pointer on left (small amber box), arrow to array on the right
  const padL=24, padR=24;
  const ptrW=84, ptrH=50;
  const ptrX=padL, ptrY=32;
  // pointer box
  ctx.fillStyle='rgba(181,84,28,0.2)';
  ctx.strokeStyle='rgba(181,84,28,0.8)';
  ctx.lineWidth=1.5;
  roundRect(ctx, ptrX, ptrY, ptrW, ptrH, 6);
  ctx.fill();ctx.stroke();
  ctx.fillStyle='#b5541c';
  ctx.font='600 12px "Courier New",monospace';
  ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText('p', ptrX+ptrW/2, ptrY+16);
  ctx.font='600 11px "Courier New",monospace';
  ctx.fillStyle='rgba(181,84,28,0.9)';
  ctx.fillText('0x1000', ptrX+ptrW/2, ptrY+34);
  ctx.fillStyle='rgba(138,129,114,0.5)';
  ctx.font='400 10px "Courier New",monospace';
  ctx.fillText('8 bytes', ptrX+ptrW/2, ptrY+ptrH+14);

  // Array on right side (dimmed, dashed border since the pointer "just knows about it")
  const arrStart=ptrX+ptrW+80;
  const regionW=W-padR-arrStart;
  const cellW=regionW/5;
  const cellY=32, cellH=50;
  const values=[10,20,30,40,50];

  for(let i=0;i<5;i++){
    const x=arrStart+i*cellW;
    ctx.fillStyle='rgba(46,90,125,0.1)';
    ctx.strokeStyle='rgba(46,90,125,0.45)';
    ctx.lineWidth=1.2;
    ctx.setLineDash([3,2]);
    roundRect(ctx, x+2, cellY, cellW-4, cellH, 4);
    ctx.fill();ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle='rgba(138,129,114,0.8)';
    ctx.font='600 13px "Courier New",monospace';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(values[i], x+cellW/2, cellY+cellH/2);
  }

  // arrow from p to arr[0]
  const sx=ptrX+ptrW, sy=ptrY+ptrH/2;
  const ex=arrStart+2, ey=cellY+cellH/2;
  ctx.strokeStyle='rgba(181,84,28,0.85)';
  ctx.lineWidth=2;
  ctx.beginPath();
  ctx.moveTo(sx,sy);
  ctx.bezierCurveTo(sx+30,sy,ex-30,ey,ex,ey);
  ctx.stroke();
  // arrowhead
  ctx.fillStyle='rgba(181,84,28,0.9)';
  ctx.beginPath();
  ctx.moveTo(ex,ey);
  ctx.lineTo(ex-8,ey-5);
  ctx.lineTo(ex-8,ey+5);
  ctx.closePath();
  ctx.fill();

  // label
  ctx.fillStyle='rgba(181,84,28,0.9)';
  ctx.font='italic 11px "Source Sans 3",sans-serif';
  ctx.textAlign='center';ctx.textBaseline='top';
  ctx.fillText('p  (type: int*, size: 8 bytes, holds an address)', W/2, 10);

  ctx.fillStyle='rgba(46,90,125,0.7)';
  ctx.font='italic 10px "Source Sans 3",sans-serif';
  ctx.fillText('p doesn\'t know this is an array of 5. Could be 1, could be 10000.', W/2, cellY+cellH+14);
}
drawV1Arr();drawV1Ptr();
window.addEventListener('resize',()=>{drawV1Arr();drawV1Ptr();});

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 2: sizeof REPL
// ═══════════════════════════════════════════════════════════════════════════
const v2ResultEl=document.getElementById('v2Result');
const v2Data={
  'sizeof(arr)':{val:'20 bytes', explain:'<code>arr</code> has type <code>int[5]</code>. <code>sizeof</code> sees the real array type and returns <code>5 * sizeof(int) = 20</code>. This is one of the rare places arrays don\'t decay.'},
  'sizeof(p)':{val:'8 bytes', explain:'<code>p</code> has type <code>int*</code>. <code>sizeof</code> returns the size of a pointer, 8 on 64-bit systems. <strong>It does not matter</strong> that <code>p</code> happens to point at a 5-element array. <code>p</code> is just 8 bytes.'},
  'sizeof(arr[0])':{val:'4 bytes', explain:'<code>arr[0]</code> is one int. <code>sizeof(int)</code> is 4 on most systems. This is why <code>sizeof(arr) / sizeof(arr[0])</code> = 5 gives you the element count for a real array.'},
  'sizeof(*p)':{val:'4 bytes', explain:'<code>*p</code> has type <code>int</code>. So <code>sizeof(*p)</code> is <code>sizeof(int)</code> = 4. Note this works even though <code>p</code> is a pointer. <code>sizeof</code> uses the <em>type</em>, and the type of <code>*p</code> is <code>int</code>.'},
  'sizeof(s)':{val:'6 bytes', explain:'<code>s</code> is declared as <code>char s[] = "hello"</code>, which gives it type <code>char[6]</code>, five letters plus the null terminator. So <code>sizeof(s)</code> is 6.'},
  'sizeof(sp)':{val:'8 bytes', explain:'<code>sp</code> is a <code>char*</code>. <code>sizeof</code> returns the size of a pointer, 8. <span class="warn">This is why <code>sizeof(string_argument)</code> inside a function doesn\'t give you the string length. It gives you 8.</span> Use <code>strlen</code> for runtime string length.'},
  'sizeof(&arr)':{val:'8 bytes', explain:'<code>&amp;arr</code> is a pointer to the whole array, with type <code>int (*)[5]</code>. It\'s still a pointer, so <code>sizeof</code> returns 8. But its <em>type</em> is different from <code>int*</code>. Arithmetic on it jumps by 20 bytes at a time, not 4.'},
  'sizeof(arr) / sizeof(arr[0])':{val:'5', explain:'The classic idiom for array length. 20 / 4 = 5. <strong>Works only when <code>arr</code> is a real array in scope.</strong> If you pass <code>arr</code> to a function, it decays to <code>int*</code>, and this becomes 8 / 4 = 2. Broken.'},
};
document.querySelectorAll('.v2-expr-btn').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('.v2-expr-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    // convert &amp; back in dataset
    const key=b.dataset.expr.replace(/&amp;/g,'&');
    const data=v2Data[key];
    if(!data)return;
    v2ResultEl.innerHTML=`
      <div class="v2-result-row">
        <span class="v2-result-expr">${key}</span>
        <span class="v2-result-arrow">→</span>
        <span class="v2-result-val">${data.val}</span>
      </div>
      <div class="v2-result-explain">${data.explain}</div>
    `;
  });
});

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: pointer arithmetic ruler
// ═══════════════════════════════════════════════════════════════════════════
const v3Canvas=document.getElementById('v3Canvas');
const v3Slider=document.getElementById('v3Slider');
const v3K=document.getElementById('v3K');
const v3KR=document.getElementById('v3KR');
const v3Addr=document.getElementById('v3Addr');
const v3Calc=document.getElementById('v3Calc');

const TYPE_SIZES={char:1, int:4, double:8};
let v3Type='char';
let v3Offset=0;

function drawV3(){
  const{ctx,W,H}=setupCanvas(v3Canvas,180);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  // Draw 32 byte cells across
  const BYTES=32;
  const pad=20;
  const availW=W-pad*2;
  const cellW=availW/BYTES;
  const cellY=60, cellH=44;
  const baseAddr=0x1000;

  // draw byte cells
  for(let i=0;i<BYTES;i++){
    const x=pad+i*cellW;
    ctx.fillStyle='rgba(138,129,114,0.04)';
    ctx.strokeStyle='rgba(138,129,114,0.1)';
    ctx.lineWidth=0.5;
    ctx.fillRect(x,cellY,cellW-0.5,cellH);
    ctx.strokeRect(x,cellY,cellW-0.5,cellH);
  }

  // Group cells into elements based on type
  const stride=TYPE_SIZES[v3Type];
  const elements=Math.floor(BYTES/stride);
  for(let i=0;i<elements;i++){
    const x=pad+i*cellW*stride;
    const elW=cellW*stride-1;
    ctx.fillStyle=`rgba(46,90,125,${i===v3Offset?0.35:0.1})`;
    ctx.strokeStyle=`rgba(46,90,125,${i===v3Offset?0.9:0.4})`;
    ctx.lineWidth=i===v3Offset?2:1;
    roundRect(ctx, x+1, cellY+1, elW-2, cellH-2, 3);
    ctx.fill();ctx.stroke();
    // element index
    ctx.fillStyle=i===v3Offset?'#2e5a7d':'rgba(138,129,114,0.55)';
    ctx.font=`600 ${i===v3Offset?13:11}px "Courier New",monospace`;
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(`[${i}]`, x+elW/2, cellY+cellH/2);
  }

  // Draw base pointer at element 0
  const p0X=pad+cellW*stride*0;
  const p0W=cellW*stride;
  ctx.fillStyle='rgba(181,84,28,0.3)';
  ctx.strokeStyle='var(--accent)';
  ctx.lineWidth=1.5;
  ctx.beginPath();
  ctx.moveTo(p0X+p0W/2, cellY-16);
  ctx.lineTo(p0X+p0W/2-6, cellY-6);
  ctx.lineTo(p0X+p0W/2+6, cellY-6);
  ctx.closePath();
  ctx.fill();ctx.stroke();
  ctx.fillStyle='rgba(181,84,28,0.9)';
  ctx.font='600 11px "Courier New",monospace';
  ctx.textAlign='center';ctx.textBaseline='bottom';
  ctx.fillText('p', p0X+p0W/2, cellY-18);

  // Draw p+k with an arrow
  if(v3Offset>0 && v3Offset<elements){
    const pkX=pad+cellW*stride*v3Offset;
    // arrow above
    ctx.fillStyle='rgba(10,125,82,0.4)';
    ctx.strokeStyle='var(--green)';
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.moveTo(pkX+p0W/2, cellY-16);
    ctx.lineTo(pkX+p0W/2-6, cellY-6);
    ctx.lineTo(pkX+p0W/2+6, cellY-6);
    ctx.closePath();
    ctx.fill();ctx.stroke();
    ctx.fillStyle='rgba(10,125,82,0.95)';
    ctx.font='600 11px "Courier New",monospace';
    ctx.textAlign='center';ctx.textBaseline='bottom';
    ctx.fillText(`p+${v3Offset}`, pkX+p0W/2, cellY-18);

    // jump indicator - bracket showing byte distance
    ctx.strokeStyle='rgba(10,125,82,0.55)';
    ctx.lineWidth=1;
    const brY=cellY+cellH+16;
    ctx.beginPath();
    ctx.moveTo(p0X+p0W/2, brY);
    ctx.lineTo(p0X+p0W/2, brY+5);
    ctx.lineTo(pkX+p0W/2, brY+5);
    ctx.lineTo(pkX+p0W/2, brY);
    ctx.stroke();
    ctx.fillStyle='rgba(10,125,82,0.8)';
    ctx.font='600 11px "Courier New",monospace';
    ctx.textAlign='center';ctx.textBaseline='top';
    ctx.fillText(`${v3Offset * stride} bytes`, (p0X+pkX)/2+p0W/2, brY+8);
  }

  // Type label at top
  ctx.fillStyle='rgba(138,129,114,0.65)';
  ctx.font='600 12px "Courier New",monospace';
  ctx.textAlign='left';ctx.textBaseline='top';
  ctx.fillText(`${v3Type}* p;  // sizeof(*p) = ${stride}`, pad, 14);

  // Show one-byte grid labels at the bottom (subtle)
  ctx.fillStyle='rgba(138,129,114,0.25)';
  ctx.font='400 8px "Courier New",monospace';
  ctx.textAlign='center';ctx.textBaseline='top';
  for(let i=0;i<=BYTES;i+=4){
    ctx.fillText('+'+i, pad+i*cellW, cellY+cellH+36);
  }
}

function updateV3Readout(){
  const stride=TYPE_SIZES[v3Type];
  const maxElements=Math.floor(32/stride);
  v3Slider.max=maxElements-1;
  if(v3Offset>maxElements-1)v3Offset=maxElements-1;
  v3K.textContent=v3Offset;
  v3KR.textContent=v3Offset;
  const addr=0x1000 + v3Offset * stride;
  v3Addr.textContent='0x'+addr.toString(16);
  v3Calc.textContent=`= 0x1000 + ${v3Offset} × ${stride} byte${stride>1?'s':''} = +${v3Offset*stride} bytes`;
}

v3Slider.addEventListener('input',()=>{
  v3Offset=parseInt(v3Slider.value);
  updateV3Readout();
  drawV3();
});
document.querySelectorAll('[data-type]').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('[data-type]').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    v3Type=b.dataset.type;
    // reset offset to 0 to avoid overshoot
    v3Offset=0;
    v3Slider.value=0;
    updateV3Readout();
    drawV3();
  });
});
updateV3Readout();
drawV3();
window.addEventListener('resize',drawV3);

// ═══════════════════════════════════════════════════════════════════════════
// Copy-to-clipboard for runnable code block
// ═══════════════════════════════════════════════════════════════════════════
const copyBtn=document.getElementById('copyCodeBtn');
const codeSrc=document.getElementById('codeSrc');
if(copyBtn && codeSrc){
  copyBtn.addEventListener('click',()=>{
    const text=codeSrc.innerText;
    (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject()).then(()=>{
      copyBtn.textContent='Copied!';
      copyBtn.classList.add('copied');
      setTimeout(()=>{copyBtn.textContent='Copy';copyBtn.classList.remove('copied');},1800);
    }).catch(()=>{
      // Fallback for older browsers
      const ta=document.createElement('textarea');
      ta.value=text;document.body.appendChild(ta);
      ta.select();document.execCommand('copy');document.body.removeChild(ta);
      copyBtn.textContent='Copied!';
      setTimeout(()=>{copyBtn.textContent='Copy';},1800);
    });
  });
}

// ═══════════════════════════════════════════════════════════════════════════
// QUIZ
// ═══════════════════════════════════════════════════════════════════════════
document.querySelectorAll('.quiz-options').forEach(group=>{
  const isMulti=group.classList.contains('multi');
  group.querySelectorAll('.quiz-option').forEach(opt=>{
    opt.addEventListener('click',()=>{
      if(isMulti){
        opt.classList.toggle('selected');
      }else{
        group.querySelectorAll('.quiz-option').forEach(o=>o.classList.remove('selected'));
        opt.classList.add('selected');
      }
    });
  });
});
document.querySelectorAll('[data-reveal]').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const id=btn.dataset.reveal;
    const answer=document.getElementById(id);
    if(!answer)return;
    answer.classList.toggle('show');
    btn.textContent=answer.classList.contains('show')?'Hide answer':'Reveal answer';
    const card=btn.closest('.quiz-card');
    if(card){
      const group=card.querySelector('.quiz-options');
      if(group && answer.classList.contains('show')){
        const correct=group.dataset.answer.split(',');
        group.querySelectorAll('.quiz-option').forEach(opt=>{
          const val=opt.dataset.val;
          const isSelected=opt.classList.contains('selected');
          const isCorrect=correct.includes(val);
          if(isCorrect)opt.classList.add('correct');
          else if(isSelected)opt.classList.add('incorrect');
        });
      }else if(group && !answer.classList.contains('show')){
        group.querySelectorAll('.quiz-option').forEach(opt=>{
          opt.classList.remove('correct','incorrect');
        });
      }
    }
  });
});

</script>
