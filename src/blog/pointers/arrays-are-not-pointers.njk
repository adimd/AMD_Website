<span class="section"># 2. But sizeof reveals different types</span>
sizeof(arr)     = <span class="highlight">20</span>
sizeof(&arr[0]) = <span class="highlight">8</span>
sizeof(&arr)    = <span class="highlight">8</span>

<span class="section"># 3. Pointer arithmetic is the real tell</span>
arr + 1      = <span class="addr">0x7ffd2e4a8ab4</span>  (+4 bytes: one int)
