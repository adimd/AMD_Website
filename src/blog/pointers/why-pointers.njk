const recSlider=document.getElementById('recSlider');
const speedSlider=document.getElementById('speedSlider');
const recSizeVal=document.getElementById('recSizeVal');
const speedVal=document.getElementById('speedVal');
const copyBytesEl=document.getElementById('copyBytes');
const copyCanvas=document.getElementById('copyCanvas');
const ptrCanvas=document.getElementById('ptrCanvas');

let recordSize=500;
let speedMul=1.0;

function setupCanvas(c){
  const dpr=window.devicePixelRatio||1;
  const rect=c.getBoundingClientRect();
  const W=Math.max(320,rect.width);
  const H=110;
  c.width=W*dpr;c.height=H*dpr;
  c.style.height=H+'px';
  const ctx=c.getContext('2d');
  ctx.setTransform(1,0,0,1,0,0);
  ctx.scale(dpr,dpr);
  return{ctx,W,H};
}

// Draw the static frame: caller record on left, function frame on right, wire between
function drawFrame(ctx,W,H,opts){
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  const pad=14;
  const boxW=Math.min(130,W*0.22);
  const boxH=H-pad*2;
  const callerX=pad, callerY=pad;
  const calleeX=W-pad-boxW, calleeY=pad;

  // caller: solid blue record
  ctx.fillStyle='rgba(46,90,125,0.18)';
  ctx.strokeStyle='rgba(46,90,125,0.7)';
  ctx.lineWidth=1.5;
  roundRect(ctx,callerX,callerY,boxW,boxH,6);ctx.fill();ctx.stroke();
  ctx.fillStyle='#57503f';
  ctx.font='600 11px "Source Sans 3",sans-serif';
  ctx.textAlign='center';ctx.textBaseline='top';
  ctx.fillText('caller',callerX+boxW/2,callerY+8);
  ctx.font='400 10px "Courier New",monospace';
  ctx.fillStyle='rgba(138,129,114,0.7)';
  ctx.fillText('record '+formatBytes(recordSize),callerX+boxW/2,callerY+22);

  // if copy mode: draw the record fill proportional to size
  const fillPct=Math.min(1,recordSize/5000);
  if(opts.mode==='copy'){
    // show "contents" as little stacked rows in the caller
    ctx.fillStyle='rgba(46,90,125,0.35)';
    const rowsCaller=Math.max(3,Math.floor(fillPct*18));
    const innerY=callerY+36, innerH=boxH-44;
    const rowH=Math.max(2,innerH/Math.max(rowsCaller,1)-1);
    for(let i=0;i<rowsCaller;i++){
      ctx.fillRect(callerX+8,innerY+i*(rowH+1),boxW-16,rowH);
    }
  }

  // callee: dashed frame, fills over time in copy mode
  ctx.save();
  ctx.setLineDash([4,3]);
  ctx.strokeStyle='rgba(138,129,114,0.28)';
  ctx.fillStyle='rgba(138,129,114,0.03)';
  ctx.lineWidth=1.2;
  roundRect(ctx,calleeX,calleeY,boxW,boxH,6);ctx.fill();ctx.stroke();
  ctx.restore();
  ctx.fillStyle='#57503f';
  ctx.font='600 11px "Source Sans 3",sans-serif';
  ctx.textAlign='center';ctx.textBaseline='top';
  ctx.fillText('function',calleeX+boxW/2,calleeY+8);
  ctx.font='400 10px "Courier New",monospace';
  ctx.fillStyle='rgba(138,129,114,0.6)';
  ctx.fillText(opts.mode==='copy'?'local copy':'holds pointer',calleeX+boxW/2,calleeY+22);

  return{callerX,callerY,calleeX,calleeY,boxW,boxH};
}
function roundRect(ctx,x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}
function formatBytes(b){
  if(b>=1024)return(b/1024).toFixed(1)+' KB';
  return b+' B';
}

// copy lane state
let copyParticles=[]; // each: {progress, lane, bornAt}
let copyLastSpawn=0;
let copyFilled=0; // 0..1 how full the callee box is
let copyCallStart=performance.now();

// ptr lane state
let ptrArrowProgress=-1; // -1 = idle, 0..1 traveling
let ptrLastFire=0;

function spawnCopyParticles(now){
  // spawn rate proportional to record size (bigger record = denser stream)
  // particles per second: size-dependent
  const interval=Math.max(8,120-Math.min(100,recordSize/50)); // ms between spawns
  if(now-copyLastSpawn>interval/speedMul){
    copyLastSpawn=now;
    // spawn 1-3 particles per tick, in different lanes
    const n=1+Math.floor(Math.random()*2);
    for(let k=0;k<n;k++){
      copyParticles.push({
        progress:0,
        lane:(Math.random()*0.7)+0.15, // 0.15..0.85 of the vertical space
        bornAt:now
      });
    }
  }
}

function drawCopyLane(now){
  const{ctx,W,H}=setupCanvas(copyCanvas);
  const f=drawFrame(ctx,W,H,{mode:'copy'});

  // fill level of callee based on recordSize and elapsed since call start
  // One "call" duration scales with record size
  const callDurMs=Math.min(6000,300+recordSize*1.5)/speedMul;
  const elapsed=now-copyCallStart;
  copyFilled=Math.min(1,elapsed/callDurMs);

  // draw callee fill (red-ish, representing copied bytes accumulating)
  const innerX=f.calleeX+8, innerY=f.calleeY+36;
  const innerW=f.boxW-16, innerH=f.boxH-44;
  ctx.fillStyle='rgba(168,60,44,0.3)';
  ctx.fillRect(innerX,innerY+innerH*(1-copyFilled),innerW,innerH*copyFilled);
  // bright top edge of the fill
  ctx.fillStyle='rgba(168,60,44,0.7)';
  ctx.fillRect(innerX,innerY+innerH*(1-copyFilled)-1,innerW,1.5);

  // reset call when full
  if(copyFilled>=1 && elapsed>callDurMs+200/speedMul){
    copyCallStart=now;
    copyParticles=[];
  }

  // spawn & draw particles moving caller -> callee
  spawnCopyParticles(now);
  const srcX=f.callerX+f.boxW;
  const dstX=f.calleeX;
  const laneTop=f.callerY+8, laneH=f.boxH-16;

  copyParticles=copyParticles.filter(p=>{
    // Each particle takes ~ (record size scaled) travel time
    const travelMs=Math.max(300,80+recordSize*0.1)/speedMul;
    p.progress=(now-p.bornAt)/travelMs;
    if(p.progress>=1)return false;
    const x=srcX+(dstX-srcX)*p.progress;
    const y=laneTop+laneH*p.lane;
    // draw little red byte-square
    ctx.fillStyle=`rgba(168,60,44,${0.65*(1-Math.abs(0.5-p.progress))+0.35})`;
    ctx.fillRect(x-3,y-2,6,4);
    // faint trail
    ctx.fillStyle='rgba(168,60,44,0.18)';
    ctx.fillRect(x-14,y-1.5,11,3);
    return true;
  });

  // label the stream
  ctx.fillStyle='rgba(168,60,44,0.7)';
  ctx.font='italic 10px "Source Sans 3",sans-serif';
  ctx.textAlign='center';ctx.textBaseline='bottom';
  ctx.fillText('copying '+formatBytes(recordSize)+'…',W/2,H-6);
}

function drawPtrLane(now){
  const{ctx,W,H}=setupCanvas(ptrCanvas);
  const f=drawFrame(ctx,W,H,{mode:'ptr'});

  // the callee shows a tiny pointer box (fixed 8 B)
  const arrowW=46, arrowH=18;
  const calleeMidY=f.calleeY+f.boxH/2;

  // fire a new arrow every ~ same interval as copy call's "visible impact",
  // but the arrow itself flies quickly regardless of record size
  const fireInterval=600/speedMul;
  if(now-ptrLastFire>fireInterval && ptrArrowProgress<0){
    ptrArrowProgress=0;
    ptrLastFire=now;
  }

  // if arrow is flying, advance it
  const srcX=f.callerX+f.boxW;
  const dstX=f.calleeX;
  const travelMs=280/speedMul; // fixed fast travel, independent of record size
  if(ptrArrowProgress>=0){
    ptrArrowProgress+=(16.67/travelMs); // assume ~60fps, add per-frame
    if(ptrArrowProgress>=1){
      ptrArrowProgress=-1;
    }else{
      const x=srcX+(dstX-srcX)*ptrArrowProgress;
      const y=calleeMidY;
      // arrow body
      ctx.fillStyle='rgba(181,84,28,0.25)';
      ctx.strokeStyle='rgba(181,84,28,0.9)';
      ctx.lineWidth=1.2;
      roundRect(ctx,x-arrowW/2,y-arrowH/2,arrowW,arrowH,3);
      ctx.fill();ctx.stroke();
      ctx.fillStyle='#57503f';
      ctx.font='600 9.5px "Courier New",monospace';
      ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText('0x7ffe',x,y);
      // motion trail
      ctx.strokeStyle='rgba(181,84,28,0.3)';
      ctx.lineWidth=1;
      ctx.beginPath();
      ctx.moveTo(x-arrowW/2-6,y);
      ctx.lineTo(x-arrowW/2-22,y);
      ctx.stroke();
    }
  }

  // Persistent tiny pointer slot in the callee (once an arrow has arrived at least once)
  const showSlot=ptrLastFire>0;
  if(showSlot){
    const sx=f.calleeX+(f.boxW-arrowW)/2;
    const sy=calleeMidY-arrowH/2;
    ctx.fillStyle='rgba(181,84,28,0.12)';
    ctx.strokeStyle='rgba(181,84,28,0.45)';
    ctx.lineWidth=1;
    roundRect(ctx,sx,sy,arrowW,arrowH,3);
    ctx.fill();ctx.stroke();
    ctx.fillStyle='rgba(181,84,28,0.8)';
    ctx.font='600 9.5px "Courier New",monospace';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText('0x7ffe',sx+arrowW/2,sy+arrowH/2);
  }

  // label
  ctx.fillStyle='rgba(10,125,82,0.75)';
  ctx.font='italic 10px "Source Sans 3",sans-serif';
  ctx.textAlign='center';ctx.textBaseline='bottom';
  ctx.fillText('sending 8 B · same speed, any record size',W/2,H-6);
}

function tick(now){
  drawCopyLane(now);
  drawPtrLane(now);
  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);

function updateCopyStats(){
  recordSize=parseInt(recSlider.value);
  speedMul=parseInt(speedSlider.value)/100;
  recSizeVal.textContent=formatBytes(recordSize);
  speedVal.textContent=speedMul.toFixed(2)+'x';
  copyBytesEl.textContent=formatBytes(recordSize);
  // restart copy animation when record size changes so user sees effect immediately
  copyCallStart=performance.now();
  copyParticles=[];
}
recSlider.addEventListener('input',updateCopyStats);
speedSlider.addEventListener('input',updateCopyStats);
updateCopyStats();
window.addEventListener('resize',()=>{});  // canvas re-measures each frame

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 2: MEMORY GRID
// ═══════════════════════════════════════════════════════════════════════════
const memGrid=document.getElementById('memGrid');
const ADDR_BASE=0x1000;
// we'll show 16 cells; x lives at index 5, p lives at index 10
const X_IDX=5, P_IDX=10;
function addrStr(i){return '0x'+(ADDR_BASE+i*4).toString(16);}
function renderMemGrid(step){
  memGrid.innerHTML='';
  for(let i=0;i<16;i++){
    const cell=document.createElement('div');
    cell.className='mem-cell';
    const addr=document.createElement('div');
    addr.className='addr';
    addr.textContent=addrStr(i);
    const val=document.createElement('div');
    val.className='val';
    val.textContent='?';
    cell.appendChild(addr);
    cell.appendChild(val);

    if(i===X_IDX){
      if(step>=0)cell.classList.add('filled');
      if(step===0)val.textContent='?';
      else if(step>=1&&step<4)val.textContent='42';
      else if(step===4)val.textContent='99';
      if(step>=3)cell.classList.add('target');
    }
    if(i===P_IDX){
      if(step>=2)cell.classList.add('ptr');
      if(step===2)val.textContent='?';
      else if(step>=3){val.textContent=addrStr(X_IDX);}
    }
    memGrid.appendChild(cell);
  }
  // highlight code line
  document.querySelectorAll('.mem-code-line').forEach(l=>l.classList.remove('active'));
  const active=document.querySelector(`.mem-code-line[data-line="${step}"]`);
  if(active)active.classList.add('active');
}
document.querySelectorAll('.mem-btn').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('.mem-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    renderMemGrid(parseInt(b.dataset.step));
  });
});
renderMemGrid(0);

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: LOCALITY
// ═══════════════════════════════════════════════════════════════════════════
const arrCanvas=document.getElementById('arrCanvas');
const llCanvas=document.getElementById('llCanvas');
const btnTraverse=document.getElementById('btnTraverse');
const btnReset=document.getElementById('btnReset');
const arrHitsEl=document.getElementById('arrHits');
const arrMissEl=document.getElementById('arrMiss');
const arrTimeEl=document.getElementById('arrTime');
const llHitsEl=document.getElementById('llHits');
const llMissEl=document.getElementById('llMiss');
const llTimeEl=document.getElementById('llTime');

const N=16;
const CACHE_LINE=4; // prefetch 4 elements at a time
// positions for array: contiguous row
function arrPositions(W,H){
  const pts=[];
  const pad=20;
  const startY=H/2;
  const step=(W-pad*2)/(N-1);
  for(let i=0;i<N;i++)pts.push({x:pad+i*step,y:startY,idx:i});
  return pts;
}
// positions for LL: scattered
function llPositions(W,H){
  const pts=[];
  const pad=20;
  const seed=[0.2,0.7,0.35,0.85,0.15,0.6,0.45,0.9,0.25,0.55,0.8,0.3,0.65,0.5,0.75,0.4];
  const order=[7,2,11,4,9,1,13,6,15,0,8,3,14,5,10,12]; // scrambled heap order
  for(let i=0;i<N;i++){
    const o=order[i];
    pts.push({x:pad+(o/(N-1))*(2*W/2.2-pad*2)+pad*0.1,y:pad+seed[o]*(H-pad*2),idx:i});
  }
  // re-assign by traversal order, keep logical i
  const remap=[];
  for(let i=0;i<N;i++){
    remap[i]={...pts[i]};
  }
  return remap;
}

function drawNodes(canvas,positions,state){
  const dpr=window.devicePixelRatio||1;
  const W=canvas.clientWidth||520, H=180;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');
  ctx.setTransform(1,0,0,1,0,0);
  ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  // edges
  ctx.strokeStyle='rgba(138,129,114,0.18)';
  ctx.lineWidth=1.4;
  for(let i=0;i<positions.length-1;i++){
    ctx.beginPath();
    ctx.moveTo(positions[i].x,positions[i].y);
    ctx.lineTo(positions[i+1].x,positions[i+1].y);
    ctx.stroke();
  }

  // nodes
  positions.forEach((p,i)=>{
    const s=state[i];
    let fill='rgba(138,129,114,0.06)',stroke='rgba(138,129,114,0.22)';
    if(s==='hit'){fill='rgba(10,125,82,0.22)';stroke='rgba(10,125,82,0.7)';}
    else if(s==='miss'){fill='rgba(168,60,44,0.22)';stroke='rgba(168,60,44,0.75)';}
    else if(s==='current'){fill='rgba(181,84,28,0.28)';stroke='rgba(181,84,28,0.9)';}
    ctx.fillStyle=fill;
    ctx.strokeStyle=stroke;
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.arc(p.x,p.y,12,0,Math.PI*2);
    ctx.fill();ctx.stroke();
    ctx.fillStyle='#57503f';
    ctx.font='600 10px "Courier New",monospace';
    ctx.textAlign='center';
    ctx.textBaseline='middle';
    ctx.fillText(p.idx,p.x,p.y);
  });
}

function resetLoc(){
  const W=arrCanvas.clientWidth||520;
  const arrPos=arrPositions(W,180);
  const llPos=llPositions(W,180);
  drawNodes(arrCanvas,arrPos,new Array(N).fill('idle'));
  drawNodes(llCanvas,llPos,new Array(N).fill('idle'));
  arrHitsEl.textContent='0';arrMissEl.textContent='0';arrTimeEl.textContent='0 ns';
  llHitsEl.textContent='0';llMissEl.textContent='0';llTimeEl.textContent='0 ns';
}

async function traverse(canvas,positions,hitsEl,missEl,timeEl,isArray){
  const state=new Array(N).fill('idle');
  let hits=0,miss=0,time=0;
  for(let i=0;i<N;i++){
    state[i]='current';
    let isHit;
    if(isArray){
      // array: first of each cache line is a miss, next CACHE_LINE-1 are hits
      isHit=(i%CACHE_LINE)!==0;
    }else{
      // linked list: nearly every hop is a miss because nodes are scattered
      isHit=Math.random()<0.1;
    }
    if(isHit){state[i]='hit';hits++;time+=4;}
    else{state[i]='miss';miss++;time+=100;}
    hitsEl.textContent=hits;
    missEl.textContent=miss;
    timeEl.textContent=time+' ns';
    drawNodes(canvas,positions,state);
    await new Promise(r=>setTimeout(r,140));
  }
}

btnTraverse.addEventListener('click',async()=>{
  btnTraverse.disabled=true;
  btnTraverse.textContent='Traversing…';
  resetLoc();
  const W=arrCanvas.clientWidth||520;
  const arrPos=arrPositions(W,180);
  const llPos=llPositions(W,180);
  await Promise.all([
    traverse(arrCanvas,arrPos,arrHitsEl,arrMissEl,arrTimeEl,true),
    traverse(llCanvas,llPos,llHitsEl,llMissEl,llTimeEl,false)
  ]);
  btnTraverse.disabled=false;
  btnTraverse.textContent='Traverse again';
});
btnReset.addEventListener('click',resetLoc);
window.addEventListener('resize',resetLoc);
resetLoc();

</script>
{% endraw %}
