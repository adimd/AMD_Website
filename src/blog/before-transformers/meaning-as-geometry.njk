rray="3 3"/><rect x="554" y="140" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="584" y="140" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="404" y="164" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="434" y="164" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="464" y="164" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="494" y="164" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="524" y="164" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="554" y="164" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="584" y="164" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="404" y="188" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="434" y="188" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="464" y="188" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="494" y="188" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="524" y="188" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="554" y="188" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/><rect x="584" y="188" width="28" height="22" rx="4" fill="none" stroke="#c5c0b4" stroke-width="1" stroke-dasharray="3 3"/>
