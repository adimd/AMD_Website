            <span class="vec-b">c</span><sub>context</sub> = <span id="vcB">(1.6, 1.5)</span><br>
            <span class="vec-a">v</span><sub>centre</sub><sup>⊤</sup> <span class="vec-b">c</span><sub>context</sub> = <span class="result" id="vcDot">4.68</span>
