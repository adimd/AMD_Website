<script>


// ═══════════════════════════════════════════════════════════════════════════
// VIZ 1: APPLE DRIFT
// ═══════════════════════════════════════════════════════════════════════════
// Each context word has counts in the 1990 corpus vs the 2025 corpus.
// The slider mixes between them. Same word, different meaning baked in.
const DRIFT_CONTEXTS=[
  {word:'tree',   old:18, new:1,  type:'fruit'},
  {word:'fruit',  old:22, new:2,  type:'fruit'},
  {word:'orchard',old:12, new:0,  type:'fruit'},
  {word:'pie',    old:15, new:3,  type:'fruit'},
  {word:'juice',  old:14, new:4,  type:'fruit'},
  {word:'phone',  old:0,  new:28, type:'tech'},
  {word:'iphone', old:0,  new:24, type:'tech'},
  {word:'software',old:1, new:19, type:'tech'},
  {word:'device', old:0,  new:17, type:'tech'},
  {word:'store',  old:3,  new:15, type:'tech'}
];
function renderDrift(){
  const slider=document.getElementById('driftSlider');
  const t=slider.value/100; // 0 = old, 1 = new
  const year=Math.round(1990+(2025-1990)*t);
  document.getElementById('driftEraYear').textContent=year;
  const host=document.getElementById('driftRow');
  // compute counts for each context
  const counts=DRIFT_CONTEXTS.map(c=>{
    // linear interpolation between old-only and new-only corpus
    return{...c,val:Math.round(c.old*(1-t)+c.new*t)};
  });
  const max=Math.max(...counts.map(c=>c.val),1);
  host.innerHTML='';
  // row label
  const lbl=document.createElement('div');
  lbl.className='drift-row-label';
  lbl.textContent='apple';
  host.appendChild(lbl);
  counts.forEach(c=>{
    const cell=document.createElement('div');
    cell.className='drift-context-cell '+c.type;
    cell.innerHTML=`
      <div class="drift-context-word">${c.word}</div>
      <div class="drift-context-count">${c.val}</div>
      <div class="drift-context-bar"><div class="drift-context-fill" style="width:${(c.val/max)*100}%"></div></div>
    `;
    host.appendChild(cell);
  });
  // insight
  const fruitSum=counts.filter(c=>c.type==='fruit').reduce((a,b)=>a+b.val,0);
  const techSum=counts.filter(c=>c.type==='tech').reduce((a,b)=>a+b.val,0);
  const ins=document.getElementById('driftInsight');
  if(t<0.2){
    ins.innerHTML=`<strong>Fruit apple dominates.</strong> In 1990, "apple" sits in an orchard, next to pies and juice. Tech contexts barely exist.`;
  }else if(t>0.8){
    ins.innerHTML=`<strong>Tech apple dominates.</strong> By 2025, "apple" is a phone, a store, a piece of software. The fruit still exists but the matrix no longer reflects which meaning matters.`;
  }else{
    ins.innerHTML=`<strong>Both meanings mixed in one row.</strong> Fruit counts: ${fruitSum}. Tech counts: ${techSum}. The matrix can't tell you which is the "right" apple, it just sums everything together.`;
  }
}
document.getElementById('driftSlider').addEventListener('input',renderDrift);
renderDrift();

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 2: v·c inner product playground
// ═══════════════════════════════════════════════════════════════════════════
const vcCanvas=document.getElementById('vcCanvas');
const vcCtx=vcCanvas.getContext('2d');
const VCW=380,VCH=380;
// Work in canvas math coords (origin at centre, y up). Store vectors as {x,y}.
let vcA={x:80,y:60},vcB={x:70,y:55};
let vcDragging=null;

function vcDraw(){
  vcCtx.fillStyle='#ffffff';vcCtx.fillRect(0,0,VCW,VCH);
  const cx=VCW/2,cy=VCH/2;
  // grid
  vcCtx.strokeStyle='rgba(138,129,114,.04)';vcCtx.lineWidth=1;
  for(let i=30;i<VCW;i+=30){
    vcCtx.beginPath();vcCtx.moveTo(i,0);vcCtx.lineTo(i,VCH);vcCtx.stroke();
    vcCtx.beginPath();vcCtx.moveTo(0,i);vcCtx.lineTo(VCW,i);vcCtx.stroke();
  }
  // axes
  vcCtx.strokeStyle='rgba(138,129,114,.18)';vcCtx.lineWidth=1.5;
  vcCtx.beginPath();vcCtx.moveTo(0,cy);vcCtx.lineTo(VCW,cy);vcCtx.stroke();
  vcCtx.beginPath();vcCtx.moveTo(cx,0);vcCtx.lineTo(cx,VCH);vcCtx.stroke();
  // axis labels
  vcCtx.fillStyle='rgba(138,129,114,.6)';vcCtx.font='italic 11px "Instrument Serif",serif';
  vcCtx.textAlign='left';vcCtx.fillText('dim 1',VCW-40,cy-6);
  vcCtx.textAlign='left';vcCtx.fillText('dim 2',cx+6,14);

  // compute dot product (in vector-unit scale, /50)
  const ax=vcA.x/50,ay=vcA.y/50,bx=vcB.x/50,by=vcB.y/50;
  const dot=ax*bx+ay*by;
  // cosine for color guidance
  const na=Math.hypot(ax,ay),nb=Math.hypot(bx,by);
  const cos=na*nb>0?dot/(na*nb):0;

  // vector A (centre, orange)
  drawVcArrow(vcA,'#b5541c',4,'v','centre');
  // vector B (context, blue)
  drawVcArrow(vcB,'#2e5a7d',4,'c','context');

  // angle indicator (faint arc)
  if(na>0.3&&nb>0.3){
    const angA=Math.atan2(-vcA.y,vcA.x),angB=Math.atan2(-vcB.y,vcB.x);
    vcCtx.strokeStyle='rgba(10,125,82,.4)';vcCtx.lineWidth=2;
    vcCtx.beginPath();
    const start=Math.min(angA,angB),end=Math.max(angA,angB);
    vcCtx.arc(cx,cy,28,start,end);
    vcCtx.stroke();
  }

  // origin
  vcCtx.fillStyle='#57503f';
  vcCtx.beginPath();vcCtx.arc(cx,cy,3,0,Math.PI*2);vcCtx.fill();

  // panel updates
  document.getElementById('vcA').textContent=`(${ax.toFixed(2)}, ${ay.toFixed(2)})`;
  document.getElementById('vcB').textContent=`(${bx.toFixed(2)}, ${by.toFixed(2)})`;
  document.getElementById('vcDot').textContent=dot.toFixed(2);

  // cell square colouring based on dot product value
  const sq=document.getElementById('vcCellSquare');
  const host=document.getElementById('vcCellHost');
  const txt=document.getElementById('vcCellText');
  sq.textContent=dot.toFixed(2);
  sq.className='vc-cell-square';host.className='vc-cell';
  if(dot>2){
    sq.classList.add('high');host.classList.add('high');
    txt.innerHTML=`<strong>Strong implicit co-occurrence.</strong> The vectors point in similar directions, so their dot product is large. In the V×V table, this would be a dark orange cell.`;
  }else if(dot>0.5){
    sq.classList.add('mid');
    txt.innerHTML=`<strong>Moderate association.</strong> The vectors agree partially. In the matrix, this would be a light orange cell, these words appear together sometimes.`;
  }else if(dot<-0.5){
    sq.classList.add('low');host.classList.add('low');
    txt.innerHTML=`<strong>Negative association.</strong> The vectors point in opposite directions. These words actively avoid each other in context.`;
  }else{
    txt.innerHTML=`<strong>Near zero.</strong> The vectors are roughly perpendicular. These words don't care about each other, effectively an empty cell.`;
  }
}
function drawVcArrow(v,col,w,label,role){
  const cx=VCW/2,cy=VCH/2;
  const tx=cx+v.x,ty=cy-v.y;
  vcCtx.strokeStyle=col;vcCtx.lineWidth=w;
  vcCtx.beginPath();vcCtx.moveTo(cx,cy);vcCtx.lineTo(tx,ty);vcCtx.stroke();
  // arrowhead
  const ang=Math.atan2(ty-cy,tx-cx),ahL=12;
  vcCtx.beginPath();
  vcCtx.moveTo(tx,ty);
  vcCtx.lineTo(tx-ahL*Math.cos(ang-0.4),ty-ahL*Math.sin(ang-0.4));
  vcCtx.lineTo(tx-ahL*Math.cos(ang+0.4),ty-ahL*Math.sin(ang+0.4));
  vcCtx.closePath();vcCtx.fillStyle=col;vcCtx.fill();
  // tip handle
  vcCtx.fillStyle=col;
  vcCtx.beginPath();vcCtx.arc(tx,ty,6,0,Math.PI*2);vcCtx.fill();
  vcCtx.fillStyle='#ffffff';
  vcCtx.beginPath();vcCtx.arc(tx,ty,3,0,Math.PI*2);vcCtx.fill();
  // label
  vcCtx.fillStyle=col;
  vcCtx.font='italic 18px "Instrument Serif",serif';
  vcCtx.textAlign='left';vcCtx.textBaseline='middle';
  const lx=tx+(v.x>=0?10:-26),ly=ty+(v.y>=0?-4:16);
  vcCtx.fillText(label,lx,ly);
  vcCtx.font='11px "Source Sans 3",sans-serif';
  vcCtx.fillStyle='rgba(138,129,114,.5)';
  vcCtx.fillText(role,lx+(label==='v'?14:12),ly);
}
function vcPointer(e){
  const r=vcCanvas.getBoundingClientRect();
  const p=e.touches?e.touches[0]:e;
  return{x:(p.clientX-r.left)*(VCW/r.width),y:(p.clientY-r.top)*(VCH/r.height)};
}
function vcHit(p){
  const cx=VCW/2,cy=VCH/2;
  const at={x:cx+vcA.x,y:cy-vcA.y};
  const bt={x:cx+vcB.x,y:cy-vcB.y};
  if(Math.hypot(p.x-at.x,p.y-at.y)<14)return'A';
  if(Math.hypot(p.x-bt.x,p.y-bt.y)<14)return'B';
  return null;
}
vcCanvas.addEventListener('mousedown',e=>{vcDragging=vcHit(vcPointer(e));});
vcCanvas.addEventListener('touchstart',e=>{vcDragging=vcHit(vcPointer(e));if(vcDragging)e.preventDefault();},{passive:false});
function vcMove(e){
  if(!vcDragging)return;
  const p=vcPointer(e);
  const cx=VCW/2,cy=VCH/2;
  const v={x:p.x-cx,y:cy-p.y};
  if(vcDragging==='A')vcA=v;else vcB=v;
  vcDraw();
  e.preventDefault&&e.preventDefault();
}
vcCanvas.addEventListener('mousemove',vcMove);
vcCanvas.addEventListener('touchmove',vcMove,{passive:false});
window.addEventListener('mouseup',()=>{vcDragging=null;});
window.addEventListener('touchend',()=>{vcDragging=null;});
document.querySelectorAll('.vc-preset').forEach(b=>{
  b.addEventListener('click',()=>{
    const p=b.dataset.preset;
    if(p==='love-my'){vcA={x:90,y:60};vcB={x:80,y:55};}
    else if(p==='love-dog'){vcA={x:90,y:60};vcB={x:-50,y:80};}
    else if(p==='dog-cat'){vcA={x:70,y:-50};vcB={x:75,y:-55};}
    else if(p==='opposite'){vcA={x:90,y:40};vcB={x:-90,y:-40};}
    vcDraw();
  });
});
vcDraw();

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: evolution animation
// ═══════════════════════════════════════════════════════════════════════════
// Tiny simulated corpus. Each sentence is a set of co-occurring words.
// At each step, we pick a sentence and pull its words slightly toward each
// other. Unrelated words (not in the same sentence ever) drift apart via
// a mild repulsion. Over ~150-200 steps, clusters emerge.
const EVOL_WORDS=[
  // royals cluster
  {id:'king',     group:'royals', color:'#b5541c'},
  {id:'queen',    group:'royals', color:'#b5541c'},
  {id:'prince',   group:'royals', color:'#b5541c'},
  {id:'princess', group:'royals', color:'#b5541c'},
  // pets
  {id:'dog',      group:'pets',   color:'#2e5a7d'},
  {id:'cat',      group:'pets',   color:'#2e5a7d'},
  {id:'puppy',    group:'pets',   color:'#2e5a7d'},
  {id:'kitten',   group:'pets',   color:'#2e5a7d'},
  // foods
  {id:'bread',    group:'foods',  color:'#0a7d52'},
  {id:'pasta',    group:'foods',  color:'#0a7d52'},
  {id:'pizza',    group:'foods',  color:'#0a7d52'},
  {id:'cake',     group:'foods',  color:'#0a7d52'}
];
const EVOL_SENTENCES=[
  ['king','queen','throne'],
  ['prince','princess','crown'],
  ['king','prince','royal'],
  ['queen','princess','royal'],
  ['dog','puppy','bark'],
  ['cat','kitten','meow'],
  ['dog','cat','pet'],
  ['puppy','kitten','cute'],
  ['bread','cake','bake'],
  ['pasta','pizza','italian'],
  ['bread','pasta','kitchen'],
  ['pizza','cake','dinner']
];

let evolPos=[];
let evolStep=0;
let evolAnimHandle=null;
let evolPaused=false;
const EVOL_MAX_STEPS=200;

function evolInit(){
  evolPos=EVOL_WORDS.map(w=>({
    ...w,
    x:(Math.random()-0.5)*0.8, // in normalised -1..1 space
    y:(Math.random()-0.5)*0.8,
    vx:0,vy:0
  }));
  evolStep=0;
  evolPaused=false;
  document.getElementById('evolPause').textContent='Pause';
}
function evolStepOnce(){
  if(evolStep>=EVOL_MAX_STEPS)return;
  // Pick a random sentence. Words in the sentence pull each other.
  // Only words in EVOL_WORDS matter; the extras ('throne', 'bark', ...) are
  // "background context" and don't move.
  const sent=EVOL_SENTENCES[Math.floor(Math.random()*EVOL_SENTENCES.length)];
  const inScene=sent.filter(s=>evolPos.find(p=>p.id===s)).map(s=>evolPos.find(p=>p.id===s));
  // attraction within sentence
  const attract=0.022*(1-evolStep/EVOL_MAX_STEPS*0.5); // slightly decays
  for(let i=0;i<inScene.length;i++){
    for(let j=i+1;j<inScene.length;j++){
      const a=inScene[i],b=inScene[j];
      const dx=b.x-a.x,dy=b.y-a.y;
      a.x+=dx*attract;a.y+=dy*attract;
      b.x-=dx*attract;b.y-=dy*attract;
    }
  }
  // mild repulsion between all pairs not in same group, keeps clusters separate
  const repel=0.0005;
  for(let i=0;i<evolPos.length;i++){
    for(let j=i+1;j<evolPos.length;j++){
      const a=evolPos[i],b=evolPos[j];
      if(a.group===b.group)continue;
      const dx=b.x-a.x,dy=b.y-a.y;
      const d2=dx*dx+dy*dy+0.02;
      const f=repel/d2;
      a.x-=dx*f;a.y-=dy*f;
      b.x+=dx*f;b.y+=dy*f;
    }
  }
  // soft clamp to -1..1
  evolPos.forEach(p=>{
    p.x=Math.max(-0.95,Math.min(0.95,p.x));
    p.y=Math.max(-0.95,Math.min(0.95,p.y));
  });
  evolStep++;
}
function evolDraw(){
  const canvas=document.getElementById('evolCanvas');
  const dpr=window.devicePixelRatio||1;
  const W=canvas.clientWidth||700,H=420;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);
  // axes
  ctx.strokeStyle='rgba(138,129,114,.04)';ctx.lineWidth=1;
  for(let i=0;i<=W;i+=40){ctx.beginPath();ctx.moveTo(i,0);ctx.lineTo(i,H);ctx.stroke();}
  for(let i=0;i<=H;i+=40){ctx.beginPath();ctx.moveTo(0,i);ctx.lineTo(W,i);ctx.stroke();}
  ctx.strokeStyle='rgba(138,129,114,.12)';
  ctx.beginPath();ctx.moveTo(0,H/2);ctx.lineTo(W,H/2);ctx.stroke();
  ctx.beginPath();ctx.moveTo(W/2,0);ctx.lineTo(W/2,H);ctx.stroke();

  // map normalised -1..1 -> pixel
  const pad=50;
  const mx=x=>pad+((x+1)/2)*(W-pad*2);
  const my=y=>pad+((1-(y+1)/2))*(H-pad*2);

  // draw cluster halos once clusters have formed (evolStep > ~80)
  if(evolStep>70){
    const groups={};
    evolPos.forEach(p=>{
      if(!groups[p.group])groups[p.group]={pts:[],color:p.color};
      groups[p.group].pts.push(p);
    });
    Object.values(groups).forEach(g=>{
      const cx=g.pts.reduce((a,b)=>a+b.x,0)/g.pts.length;
      const cy=g.pts.reduce((a,b)=>a+b.y,0)/g.pts.length;
      const r=Math.max(...g.pts.map(p=>Math.hypot(p.x-cx,p.y-cy)))+0.15;
      ctx.fillStyle=g.color+'22';
      ctx.strokeStyle=g.color+'55';
      ctx.lineWidth=1.5;
      ctx.beginPath();
      ctx.ellipse(mx(cx),my(cy),r*(W-pad*2)/2,r*(H-pad*2)/2,0,0,Math.PI*2);
      ctx.fill();ctx.stroke();
    });
  }

  // draw points + labels
  evolPos.forEach(p=>{
    const x=mx(p.x),y=my(p.y);
    ctx.fillStyle=p.color;
    ctx.beginPath();ctx.arc(x,y,6,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,.8)';ctx.lineWidth=2;
    ctx.stroke();
    // label
    ctx.fillStyle='#57503f';
    ctx.font='600 12px "Source Sans 3",sans-serif';
    ctx.textAlign='center';
    ctx.fillText(p.id,x,y-12);
  });

  // status
  document.getElementById('evolStep').textContent=evolStep;
  const status=document.getElementById('evolStatus');
  if(evolStep<20)status.textContent='shuffling…';
  else if(evolStep<70)status.textContent='drifting…';
  else if(evolStep<150)status.textContent='clusters forming';
  else status.textContent='settled';
}
function evolTick(){
  if(!evolPaused&&evolStep<EVOL_MAX_STEPS){
    // run several steps per frame for speed
    for(let i=0;i<2;i++)evolStepOnce();
  }
  evolDraw();
  if(evolStep<EVOL_MAX_STEPS||!evolPaused){
    evolAnimHandle=requestAnimationFrame(evolTick);
  }
}
function evolStart(){
  if(evolAnimHandle)cancelAnimationFrame(evolAnimHandle);
  evolInit();
  evolTick();
}
document.getElementById('evolPlay').addEventListener('click',evolStart);
document.getElementById('evolPause').addEventListener('click',()=>{
  evolPaused=!evolPaused;
  document.getElementById('evolPause').textContent=evolPaused?'Resume':'Pause';
  if(!evolPaused&&evolStep<EVOL_MAX_STEPS)evolTick();
});
evolStart();

window.addEventListener('resize',()=>{evolDraw();});

</script>
{% endraw %}
