<script>


// ═══════════════════════════════════════════════════════════════════════════
// VIZ 1: candidate penalty functions
// ═══════════════════════════════════════════════════════════════════════════
const PEN_FUNCS=[
  {key:'lin',    label:'f(p) = 1 − p',       col:'#7c4dbc', fn:p=>1-p,                cap:1.01},
  {key:'sq',     label:'f(p) = (1 − p)²',    col:'#2e5a7d', fn:p=>(1-p)*(1-p),        cap:1.01},
  {key:'inv',    label:'f(p) = 1/p',          col:'#a83c2c', fn:p=>1/p,                cap:10},
  {key:'neglog', label:'f(p) = −log p',       col:'#b5541c', fn:p=>-Math.log(p),       cap:10}
];
let penOn={lin:true,sq:true,inv:true,neglog:true};
let penP=0.30;

function renderPenToggles(){
  const host=document.getElementById('penToggles');
  host.innerHTML='';
  PEN_FUNCS.forEach(f=>{
    const el=document.createElement('button');
    el.className='pen-toggle'+(penOn[f.key]?' on':'');
    el.innerHTML=`<span class="swatch" style="background:${f.col}"></span>${f.label}`;
    el.addEventListener('click',()=>{
      penOn[f.key]=!penOn[f.key];
      renderPenToggles();
      drawPen();
    });
    host.appendChild(el);
  });
}

function drawPen(){
  const canvas=document.getElementById('penCanvas');
  const dpr=window.devicePixelRatio||1;
  const W=canvas.clientWidth||700,H=380;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  const padL=60,padR=30,padT=30,padB=55;
  const plotW=W-padL-padR,plotH=H-padT-padB;
  const X_MIN=0.001, X_MAX=1.0;
  const Y_MAX=5.5; // visible y cap

  // grid
  ctx.strokeStyle='rgba(138,129,114,.06)';ctx.lineWidth=1;
  for(let i=1;i<=10;i++){
    const x=padL+(i/10)*plotW;
    ctx.beginPath();ctx.moveTo(x,padT);ctx.lineTo(x,padT+plotH);ctx.stroke();
  }
  for(let i=0;i<=5;i++){
    const y=padT+(i/5)*plotH;
    ctx.beginPath();ctx.moveTo(padL,y);ctx.lineTo(padL+plotW,y);ctx.stroke();
  }
  // axes
  ctx.strokeStyle='rgba(138,129,114,.2)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(padL,padT+plotH);ctx.lineTo(padL+plotW,padT+plotH);ctx.stroke();
  ctx.beginPath();ctx.moveTo(padL,padT);ctx.lineTo(padL,padT+plotH);ctx.stroke();

  // x-labels
  ctx.fillStyle='rgba(138,129,114,.7)';
  ctx.font='10px "Courier New",monospace';
  ctx.textAlign='center';
  for(let i=0;i<=10;i+=2){
    const x=padL+(i/10)*plotW;
    ctx.fillText((i/10).toFixed(1),x,padT+plotH+16);
  }
  ctx.font='11px "Source Sans 3",sans-serif';
  ctx.fillStyle='var(--muted)';
  ctx.fillText('p  (probability of the true word)',padL+plotW/2,padT+plotH+36);

  // y-labels
  ctx.textAlign='right';
  ctx.font='10px "Courier New",monospace';
  ctx.fillStyle='rgba(138,129,114,.7)';
  for(let i=0;i<=5;i++){
    const y=padT+plotH-(i/5)*plotH;
    ctx.fillText(i.toFixed(0),padL-6,y+3);
  }
  ctx.save();
  ctx.translate(18,padT+plotH/2);
  ctx.rotate(-Math.PI/2);
  ctx.textAlign='center';
  ctx.font='11px "Source Sans 3",sans-serif';
  ctx.fillStyle='var(--muted)';
  ctx.fillText('penalty  f(p)',0,0);
  ctx.restore();

  // draw curves
  PEN_FUNCS.forEach(f=>{
    if(!penOn[f.key])return;
    ctx.strokeStyle=f.col;
    ctx.lineWidth=2.5;
    ctx.beginPath();
    let first=true;
    for(let i=0;i<=400;i++){
      const p=X_MIN+(X_MAX-X_MIN)*i/400;
      let y=f.fn(p);
      if(y>Y_MAX)y=Y_MAX;
      if(y<0)y=0;
      const cx=padL+((p-X_MIN)/(X_MAX-X_MIN))*plotW;
      const cy=padT+plotH-(y/Y_MAX)*plotH;
      if(first){ctx.moveTo(cx,cy);first=false;}
      else{ctx.lineTo(cx,cy);}
    }
    ctx.stroke();
  });

  // vertical line at current p
  const xCur=padL+((penP-X_MIN)/(X_MAX-X_MIN))*plotW;
  ctx.strokeStyle='rgba(138,129,114,.3)';
  ctx.setLineDash([4,4]);
  ctx.lineWidth=1;
  ctx.beginPath();ctx.moveTo(xCur,padT);ctx.lineTo(xCur,padT+plotH);ctx.stroke();
  ctx.setLineDash([]);

  // dots on each active curve at p=penP
  PEN_FUNCS.forEach(f=>{
    if(!penOn[f.key])return;
    let y=f.fn(penP);
    if(y>Y_MAX)y=Y_MAX;
    if(y<0)y=0;
    const cy=padT+plotH-(y/Y_MAX)*plotH;
    ctx.fillStyle=f.col;
    ctx.beginPath();ctx.arc(xCur,cy,5,0,Math.PI*2);ctx.fill();
    ctx.strokeStyle='#ffffff';
    ctx.lineWidth=2;
    ctx.stroke();
  });

  // p label above axis
  ctx.fillStyle='#57503f';
  ctx.font='600 11px "Courier New",monospace';
  ctx.textAlign='center';
  ctx.fillText('p = '+penP.toFixed(3),xCur,padT-8);

  // readout cards
  const host=document.getElementById('penReadout');
  host.innerHTML='';
  PEN_FUNCS.forEach(f=>{
    if(!penOn[f.key])return;
    const val=f.fn(penP);
    const valStr=val>100?val.toExponential(1):val.toFixed(2);
    const card=document.createElement('div');
    card.className='pen-card';
    card.style.borderLeft='3px solid '+f.col;
    card.innerHTML=`
      <div class="pen-card-label">${f.label}</div>
      <div class="pen-card-val" style="color:${f.col}">${valStr}</div>
    `;
    host.appendChild(card);
  });
}

document.getElementById('penSlider').addEventListener('input',e=>{
  penP=parseFloat(e.target.value)/1000;
  document.getElementById('penPVal').textContent=penP.toFixed(3);
  drawPen();
});
renderPenToggles();
drawPen();
window.addEventListener('resize',drawPen);

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 2: cross-entropy comparator (Model A vs Model B vs P_data)
// ═══════════════════════════════════════════════════════════════════════════
const CE_WORDS=['love','dog','cat','friends'];
const CE_PDATA=[0.50, 0.25, 0.25, 0.00];
// Presets for Model A and Model B (must sum to ~1)
const CE_PRESETS={
  'prose':{
    name:'Uniform vs almost-right',
    A:[0.25,0.25,0.25,0.25],
    B:[0.48,0.24,0.24,0.04]
  },
  'confident-wrong':{
    name:'B is confidently wrong',
    A:[0.30,0.30,0.30,0.10],
    B:[0.05,0.05,0.05,0.85]
  },
  'close-to-truth':{
    name:'Both close-ish',
    A:[0.40,0.30,0.20,0.10],
    B:[0.45,0.28,0.25,0.02]
  },
  'matched':{
    name:'B matches P_data',
    A:[0.25,0.25,0.25,0.25],
    B:[0.50,0.25,0.25,0.001]
  }
};
let ceModelA=[...CE_PRESETS.prose.A];
let ceModelB=[...CE_PRESETS.prose.B];
let ceActivePreset='prose';

function normaliseCE(arr){
  // clamp each to [0.001, ~0.999] and renormalise
  let clipped=arr.map(v=>Math.max(0.001,Math.min(0.999,v)));
  const s=clipped.reduce((a,b)=>a+b,0);
  return clipped.map(v=>v/s);
}

function renderCEBars(hostId,probs,cls){
  const host=document.getElementById(hostId);
  host.innerHTML='';
  probs.forEach((p,i)=>{
    const row=document.createElement('div');
    row.className='ce-bar-row';
    row.innerHTML=`
      <span class="ce-bar-word">${CE_WORDS[i]}</span>
      <div class="ce-bar-track"><div class="ce-bar-fill ${cls}" style="width:${p*100}%"></div></div>
      <span class="ce-bar-val">${(p*100).toFixed(0)}%</span>
    `;
    host.appendChild(row);
  });
}

function renderCESliders(hostId,getArr,setArr){
  const host=document.getElementById(hostId);
  host.innerHTML='';
  const cur=getArr();
  cur.forEach((p,i)=>{
    const row=document.createElement('div');
    row.className='ce-slider-row';
    row.innerHTML=`
      <span class="word">${CE_WORDS[i]}</span>
      <input type="range" min="1" max="990" step="1" value="${Math.round(p*1000)}" data-idx="${i}">
      <span class="val">${(p*100).toFixed(1)}%</span>
    `;
    host.appendChild(row);
  });
  host.querySelectorAll('input').forEach(inp=>{
    inp.addEventListener('input',e=>{
      const idx=parseInt(e.target.dataset.idx);
      const arr=[...getArr()];
      arr[idx]=parseFloat(e.target.value)/1000;
      const norm=normaliseCE(arr);
      setArr(norm);
      // mark no preset active
      ceActivePreset=null;
      renderCE();
    });
  });
}

function crossEntropy(pData,pModel){
  let ce=0;
  for(let i=0;i<pData.length;i++){
    if(pData[i]>0)ce+=-pData[i]*Math.log(pModel[i]);
  }
  return ce;
}

function renderCELoss(hostId,probs){
  const host=document.getElementById(hostId);
  host.innerHTML='';
  // show each contributing term
  let rows='';
  let total=0;
  for(let i=0;i<CE_WORDS.length;i++){
    if(CE_PDATA[i]>0){
      const term=-CE_PDATA[i]*Math.log(probs[i]);
      total+=term;
      rows+=`<div class="ce-loss-row"><span>−${CE_PDATA[i].toFixed(2)} · log(${probs[i].toFixed(3)})</span><strong>${term.toFixed(3)}</strong></div>`;
    }
  }
  rows+=`<div class="ce-loss-row total">Cross-entropy H(P<sub>data</sub>, P<sub>model</sub>)<strong>${total.toFixed(3)}</strong></div>`;
  host.innerHTML=rows;
  return total;
}

function renderCE(){
  const normA=normaliseCE(ceModelA);
  const normB=normaliseCE(ceModelB);
  renderCEBars('ceDataBars',CE_PDATA,'data');
  renderCEBars('ceModelABars',normA,'model-a');
  renderCEBars('ceModelBBars',normB,'model-b');
  renderCESliders('ceModelASliders',()=>ceModelA,v=>{ceModelA=v;});
  renderCESliders('ceModelBSliders',()=>ceModelB,v=>{ceModelB=v;});
  const lossA=renderCELoss('ceModelALoss',normA);
  const lossB=renderCELoss('ceModelBLoss',normB);

  // update preset button styling
  document.querySelectorAll('.ce-preset').forEach(b=>{
    b.classList.toggle('active',b.dataset.preset===ceActivePreset);
  });

  // verdict
  const verdict=document.getElementById('ceVerdict');
  const diff=Math.abs(lossA-lossB);
  const winner=lossA<lossB?'Model A':'Model B';
  let msg;
  if(diff<0.01){
    msg='<span>The two models are basically tied.</span><strong>Δ H = '+diff.toFixed(3)+'</strong>';
  }else if(diff<0.1){
    msg=`<span>${winner} is slightly ahead.</span><strong>Δ H = ${diff.toFixed(3)}</strong>`;
  }else{
    msg=`<span>${winner} wins by a clear margin.</span><strong>Δ H = ${diff.toFixed(3)}</strong>`;
  }
  verdict.innerHTML=msg;
}

// preset buttons
function renderCEPresets(){
  const host=document.getElementById('cePresets');
  host.innerHTML='';
  for(const [k,p] of Object.entries(CE_PRESETS)){
    const b=document.createElement('button');
    b.className='ce-preset';
    b.dataset.preset=k;
    b.textContent=p.name;
    b.addEventListener('click',()=>{
      ceModelA=[...p.A];
      ceModelB=[...p.B];
      ceActivePreset=k;
      renderCE();
    });
    host.appendChild(b);
  }
}
renderCEPresets();
renderCE();

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: one-hot collapse
// ═══════════════════════════════════════════════════════════════════════════
const OH_WORDS=['love','dog','cat','friends','music'];
// A fixed P_model so readers focus on the collapse, not the probabilities
const OH_PMODEL=[0.45, 0.25, 0.15, 0.10, 0.05];
let ohTrueIdx=1; // "dog"

function renderOHPicker(){
  const host=document.getElementById('ohTruePicker');
  host.innerHTML='';
  OH_WORDS.forEach((w,i)=>{
    const b=document.createElement('button');
    b.className='oh-true-btn'+(i===ohTrueIdx?' active':'');
    b.textContent=w;
    b.addEventListener('click',()=>{ohTrueIdx=i;renderOH();});
    host.appendChild(b);
  });
}

function renderOH(){
  renderOHPicker();
  const host=document.getElementById('ohTerms');
  host.innerHTML='';
  let surviving=0;
  OH_WORDS.forEach((w,i)=>{
    const q=i===ohTrueIdx?1:0;
    const p=OH_PMODEL[i];
    const logp=Math.log(p);
    const term=q*logp;
    const alive=q===1;
    const row=document.createElement('div');
    row.className='oh-term '+(alive?'alive':'dead');
    row.innerHTML=`
      <span class="oh-idx">k=${i+1}</span>
      <span style="color:var(--ink)">${w}</span>
      <span class="mult">·</span>
      <span class="oh-q ${q===0?'zero':''}">q=${q}</span>
      <span class="mult">·</span>
      <span class="oh-logp">log(${p.toFixed(2)})</span>
      <span class="eq">=</span>
      <span class="oh-prod ${q===0?'zero':''}">${term===0?'0':term.toFixed(3)}</span>
    `;
    host.appendChild(row);
    if(alive)surviving=term;
  });

  // sum display
  const sumHost=document.getElementById('ohSum');
  const finalLoss=-surviving;
  const pTrue=OH_PMODEL[ohTrueIdx];
  const wTrue=OH_WORDS[ohTrueIdx];
  sumHost.innerHTML=`
    H(q, p) = −Σ q<sub>k</sub> · log(p<sub>k</sub>) &nbsp;=&nbsp; −[ <span class="highlight">${surviving.toFixed(3)}</span> ] &nbsp;=&nbsp; <strong>−log p<sub>${wTrue}</sub> = ${finalLoss.toFixed(3)}</strong>
    <br><span style="font-size:.85rem;color:var(--muted);font-style:italic">The sum over ${OH_WORDS.length} terms reduces to a single one: the model's log-probability for "${wTrue}".</span>
  `;
}
renderOH();

</script>
