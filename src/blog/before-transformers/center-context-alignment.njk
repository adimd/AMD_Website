<script>


// ═══════════════════════════════════════════════════════════════════════════
// SHARED: drawArrow helper for 2D vector canvases
// ═══════════════════════════════════════════════════════════════════════════
function drawArrow(ctx,cx,cy,vx,vy,col,w,label,labelCol){
  const tx=cx+vx,ty=cy-vy;
  ctx.strokeStyle=col;ctx.lineWidth=w;
  ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(tx,ty);ctx.stroke();
  const ang=Math.atan2(ty-cy,tx-cx),ahL=10;
  ctx.beginPath();
  ctx.moveTo(tx,ty);
  ctx.lineTo(tx-ahL*Math.cos(ang-0.4),ty-ahL*Math.sin(ang-0.4));
  ctx.lineTo(tx-ahL*Math.cos(ang+0.4),ty-ahL*Math.sin(ang+0.4));
  ctx.closePath();ctx.fillStyle=col;ctx.fill();
  if(label){
    ctx.fillStyle=labelCol||col;
    ctx.font='italic 13px "Instrument Serif",serif';
    ctx.textBaseline='middle';
    const lx=tx+(vx>=0?8:-8),ly=ty+(vy>=0?-6:10);
    ctx.textAlign=vx>=0?'left':'right';
    ctx.fillText(label,lx,ly);
  }
}
function drawAxes(ctx,W,H){
  ctx.strokeStyle='rgba(138,129,114,.05)';ctx.lineWidth=1;
  for(let i=25;i<W;i+=25){ctx.beginPath();ctx.moveTo(i,0);ctx.lineTo(i,H);ctx.stroke();}
  for(let i=25;i<H;i+=25){ctx.beginPath();ctx.moveTo(0,i);ctx.lineTo(W,i);ctx.stroke();}
  ctx.strokeStyle='rgba(138,129,114,.15)';ctx.lineWidth=1.2;
  ctx.beginPath();ctx.moveTo(0,H/2);ctx.lineTo(W,H/2);ctx.stroke();
  ctx.beginPath();ctx.moveTo(W/2,0);ctx.lineTo(W/2,H);ctx.stroke();
}

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 1: Candidate A vs B
// ═══════════════════════════════════════════════════════════════════════════
const SCALE=40; // pixels per unit
const CANDIDATE_A={
  centre:{word:'love',vec:[2,1],col:'#b5541c'},
  contexts:[
    {word:'my',vec:[1,1],col:'#2e5a7d'},
    {word:'dog',vec:[1,0],col:'#0a7d52'},
    {word:'cat',vec:[1,0],col:'#7c4dbc'},  // overlaps with dog, intentional
    {word:'you',vec:[-1,0],col:'#a83c2c'}
  ]
};
const CANDIDATE_B={
  centre:{word:'love',vec:[1,0],col:'#b5541c'},
  contexts:[
    {word:'my',vec:[1,0],col:'#2e5a7d'},
    {word:'dog',vec:[1,0],col:'#0a7d52'},
    {word:'cat',vec:[1,0],col:'#7c4dbc'},
    {word:'you',vec:[1,0],col:'#a83c2c'}
  ]
};
function drawABCanvas(canvasId,config){
  const canvas=document.getElementById(canvasId);
  const dpr=window.devicePixelRatio||1;
  const W=canvas.clientWidth||380,H=280;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);
  drawAxes(ctx,W,H);
  const cx=W/2,cy=H/2;
  // Draw all context vectors first (so centre sits on top)
  // Collect overlap groups (same vec)
  const drawn=new Map();
  config.contexts.forEach(c=>{
    const key=c.vec.join(',');
    if(!drawn.has(key))drawn.set(key,[]);
    drawn.get(key).push(c);
  });
  drawn.forEach((group,key)=>{
    const [vx,vy]=group[0].vec;
    const px=vx*SCALE,py=vy*SCALE;
    if(group.length===1){
      drawArrow(ctx,cx,cy,px,py,group[0].col,3,'c_'+group[0].word,group[0].col);
    }else{
      // Overlapping vectors, draw main arrow, then offset labels
      drawArrow(ctx,cx,cy,px,py,'#57503f',3);
      // label each with a little offset
      group.forEach((g,idx)=>{
        ctx.fillStyle=g.col;
        ctx.font='italic 13px "Instrument Serif",serif';
        ctx.textAlign=vx>=0?'left':'right';
        const ox=vx>=0?8:-8;
        const oy=(idx-(group.length-1)/2)*18;
        ctx.fillText('c_'+g.word,cx+px+ox,cy-py+oy+4);
      });
    }
  });
  // Draw centre with thicker line
  const [cvx,cvy]=config.centre.vec;
  drawArrow(ctx,cx,cy,cvx*SCALE,cvy*SCALE,config.centre.col,4.5,'v_'+config.centre.word,config.centre.col);
  // Origin
  ctx.fillStyle='#57503f';
  ctx.beginPath();ctx.arc(cx,cy,3,0,Math.PI*2);ctx.fill();
}
function renderABScores(hostId,config){
  const host=document.getElementById(hostId);
  const [vx,vy]=config.centre.vec;
  const rows=config.contexts.map(c=>{
    const dot=vx*c.vec[0]+vy*c.vec[1];
    return{word:c.word,dot};
  });
  const maxAbs=Math.max(...rows.map(r=>Math.abs(r.dot)),1);
  host.innerHTML=rows.map(r=>{
    const pct=(Math.abs(r.dot)/maxAbs)*100;
    const neg=r.dot<0?' neg':'';
    return `<div class="ab-score-row">
      <span class="ab-score-pair">love · ${r.word}</span>
      <div class="ab-score-bar"><div class="ab-score-bar-fill${neg}" style="width:${pct}%"></div></div>
      <span class="ab-score-val">${r.dot>=0?'+':''}${r.dot.toFixed(0)}</span>
    </div>`;
  }).join('');
}
function renderAB(){
  drawABCanvas('abCanvasA',CANDIDATE_A);
  drawABCanvas('abCanvasB',CANDIDATE_B);
  renderABScores('abScoresA',CANDIDATE_A);
  renderABScores('abScoresB',CANDIDATE_B);
}
renderAB();
window.addEventListener('resize',renderAB);

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 2: Alignment animation
// ═══════════════════════════════════════════════════════════════════════════
// Shows a small vocabulary with a centre vector and several context vectors.
// We rotate through centres. For each centre, we fire arrows toward its
// sentence-mate contexts. Crucially, dog and cat are never drawn as "paired"
// with each other in a single animation step.
const ALIGN_WORDS={
  // centre vectors (orange family, solid)
  'v_love':{type:'centre',word:'love',   angle: 0.6, len:1.0, col:'#b5541c'},
  'v_dog' :{type:'centre',word:'dog',    angle: 1.7, len:1.0, col:'#b5541c'},
  'v_cat' :{type:'centre',word:'cat',    angle: 1.9, len:1.0, col:'#b5541c'},
  // context vectors (blue)
  'c_I'   :{type:'context',word:'I',     angle: 3.4, len:0.9, col:'#2e5a7d'},
  'c_you' :{type:'context',word:'you',   angle: 3.9, len:0.9, col:'#2e5a7d'},
  'c_love':{type:'context',word:'love',  angle: 0.4, len:1.05,col:'#2e5a7d'},
  'c_my'  :{type:'context',word:'my',    angle: 1.0, len:1.1, col:'#2e5a7d'},
  'c_dog' :{type:'context',word:'dog',   angle: 1.5, len:0.95,col:'#2e5a7d'},
  'c_cat' :{type:'context',word:'cat',   angle: 2.1, len:0.95,col:'#2e5a7d'}
};
// Training steps. Each step: one centre, a list of context words that
// co-occur with it in the toy corpus.
// Corpus: "I love my dog", "You love my dog", "I love my cat", "You love my cat"
const ALIGN_STEPS=[
  {centre:'love', contexts:['I','my','dog']},   // from "I love my dog"
  {centre:'dog',  contexts:['love','my']},      // from "I love my dog" (dog's centre perspective)
  {centre:'love', contexts:['you','my','dog']}, // from "You love my dog"
  {centre:'love', contexts:['I','my','cat']},   // from "I love my cat"
  {centre:'cat',  contexts:['love','my']},      // from "I love my cat" (cat's centre perspective)
  {centre:'love', contexts:['you','my','cat']}  // from "You love my cat"
];

let alignStep=0,alignPhase=0,alignPaused=false,alignHandle=null;
const ALIGN_PHASE_FRAMES=80; // frames per step
function alignTick(){
  if(!alignPaused){
    alignPhase++;
    if(alignPhase>=ALIGN_PHASE_FRAMES){
      alignPhase=0;
      alignStep=(alignStep+1)%ALIGN_STEPS.length;
    }
  }
  drawAlign();
  alignHandle=requestAnimationFrame(alignTick);
}
function drawAlign(){
  const canvas=document.getElementById('alignCanvas');
  const dpr=window.devicePixelRatio||1;
  const W=canvas.clientWidth||700,H=420;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);
  drawAxes(ctx,W,H);
  const cx=W/2,cy=H/2;
  const radius=Math.min(W,H)*0.32;

  const step=ALIGN_STEPS[alignStep];
  const centreKey='v_'+step.centre;
  const centreVec=ALIGN_WORDS[centreKey];

  // compute all positions from angle+len
  const pos={};
  for(const [k,w] of Object.entries(ALIGN_WORDS)){
    pos[k]={x:Math.cos(w.angle)*radius*w.len,y:Math.sin(w.angle)*radius*w.len,word:w.word,col:w.col,type:w.type};
  }

  // progress 0..1 within phase
  const t=alignPhase/ALIGN_PHASE_FRAMES;

  // Draw all vectors (dimmed for those not involved this step)
  for(const [k,p] of Object.entries(pos)){
    const isCentre=k===centreKey;
    const isActiveContext=p.type==='context'&&step.contexts.includes(p.word);
    let col=p.col,thick=2,dimAlpha=1;
    if(!isCentre&&!isActiveContext){
      // uninvolved, dim
      col='rgba(138,129,114,.28)';
      thick=1.5;
    }else if(isCentre){
      thick=5;
    }else{
      thick=3;
    }
    drawArrow(ctx,cx,cy,p.x,p.y,col,thick,p.type==='centre'?('v_'+p.word):('c_'+p.word),isCentre||isActiveContext?p.col:'rgba(138,129,114,.4)');
  }

  // Draw "pulling" arrows from centre toward each active context during phase
  if(t>0.1&&t<0.85){
    const animT=Math.min(1,(t-0.1)/0.6);
    const c=pos[centreKey];
    step.contexts.forEach(ctxWord=>{
      const ctxKey='c_'+ctxWord;
      const p=pos[ctxKey];
      if(!p)return;
      // draw a pulling arrow as a dashed line from tip of centre toward tip of context
      const sx=cx+c.x,sy=cy-c.y;
      const ex=cx+p.x,ey=cy-p.y;
      // animated length
      const ax=sx+(ex-sx)*animT,ay=sy+(ey-sy)*animT;
      ctx.setLineDash([6,4]);
      ctx.strokeStyle='rgba(10,125,82,.7)';
      ctx.lineWidth=2;
      ctx.beginPath();ctx.moveTo(sx,sy);ctx.lineTo(ax,ay);ctx.stroke();
      ctx.setLineDash([]);
      // pulse dot at moving tip
      ctx.fillStyle='rgba(10,125,82,1)';
      ctx.beginPath();ctx.arc(ax,ay,4,0,Math.PI*2);ctx.fill();
    });
  }

  // Sentence bubble showing current step
  ctx.fillStyle='rgba(255,255,255,.8)';
  ctx.strokeStyle='rgba(138,129,114,.12)';
  ctx.lineWidth=1;
  const bubbleY=24,bubbleH=38;
  ctx.beginPath();
  if(typeof ctx.roundRect==='function'){ctx.roundRect(20,bubbleY,W-40,bubbleH,10);}
  else{ctx.rect(20,bubbleY,W-40,bubbleH);}
  ctx.fill();ctx.stroke();
  ctx.fillStyle='#57503f';
  ctx.font='14px "Source Sans 3",sans-serif';
  ctx.textAlign='left';ctx.textBaseline='middle';
  ctx.fillText('Centre:',32,bubbleY+bubbleH/2);
  ctx.fillStyle='#b5541c';
  ctx.font='700 14px "Source Sans 3",sans-serif';
  ctx.fillText(step.centre,88,bubbleY+bubbleH/2);
  ctx.fillStyle='#57503f';
  ctx.font='14px "Source Sans 3",sans-serif';
  ctx.fillText(' · pulling toward contexts:',88+ctx.measureText(step.centre).width+2,bubbleY+bubbleH/2);
  ctx.fillStyle='#2e5a7d';
  ctx.font='700 14px "Source Sans 3",sans-serif';
  ctx.fillText(step.contexts.join(', '),88+ctx.measureText(step.centre).width+2+ctx.measureText(' · pulling toward contexts:').width+4,bubbleY+bubbleH/2);

  // Origin
  ctx.fillStyle='#57503f';
  ctx.beginPath();ctx.arc(cx,cy,3,0,Math.PI*2);ctx.fill();

  // Update panel
  document.getElementById('alignStep').textContent=alignStep+1+' / '+ALIGN_STEPS.length;
  document.getElementById('alignCentre').textContent=step.centre;
}
document.getElementById('alignRestart').addEventListener('click',()=>{
  alignStep=0;alignPhase=0;alignPaused=false;
  document.getElementById('alignPause').textContent='Pause';
});
document.getElementById('alignPause').addEventListener('click',()=>{
  alignPaused=!alignPaused;
  document.getElementById('alignPause').textContent=alignPaused?'Resume':'Pause';
});
alignTick();
window.addEventListener('resize',drawAlign);

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: score-scale problem
// ═══════════════════════════════════════════════════════════════════════════
// Three centre vectors all pointing in similar direction as c_my,
// but with different lengths. All produce different scores despite
// similar geometric alignment.
const SCALE_WORDS=[
  {key:'love',  baseAngle:0.5, col:'#b5541c'},
  {key:'eat',   baseAngle:0.7, col:'#7c4dbc'},
  {key:'sleep', baseAngle:0.3, col:'#2e5a7d'}
];
// context vector c_my, fixed direction
const C_MY={angle:0.6, length:1.2};

let scaleFactors={love:1.0,eat:1.0,sleep:1.0};

function drawScale(){
  const canvas=document.getElementById('scaleCanvas');
  const dpr=window.devicePixelRatio||1;
  const W=canvas.clientWidth||700,H=300;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);
  drawAxes(ctx,W,H);
  const cx=W/2,cy=H*0.62;
  const unit=40; // pixels per unit

  // draw c_my first
  const cmx=Math.cos(C_MY.angle)*C_MY.length*unit;
  const cmy=Math.sin(C_MY.angle)*C_MY.length*unit;
  drawArrow(ctx,cx,cy,cmx,cmy,'#0a7d52',4,'c_my','#0a7d52');

  // draw three centre vectors
  SCALE_WORDS.forEach(w=>{
    const s=scaleFactors[w.key];
    const vx=Math.cos(w.baseAngle)*s*unit;
    const vy=Math.sin(w.baseAngle)*s*unit;
    drawArrow(ctx,cx,cy,vx,vy,w.col,3,'v_'+w.key,w.col);
  });

  // draw scale readouts
  const rhost=document.getElementById('scaleReadout');
  rhost.innerHTML='';
  SCALE_WORDS.forEach(w=>{
    const s=scaleFactors[w.key];
    const vx=Math.cos(w.baseAngle)*s;
    const vy=Math.sin(w.baseAngle)*s;
    const cmvx=Math.cos(C_MY.angle)*C_MY.length;
    const cmvy=Math.sin(C_MY.angle)*C_MY.length;
    const dot=vx*cmvx+vy*cmvy;
    const norm=Math.hypot(vx,vy);
    const card=document.createElement('div');
    card.className='scale-card';
    card.style.borderLeft='3px solid '+w.col;
    card.innerHTML=`
      <div class="scale-card-word">v_${w.key} · c_my</div>
      <div class="scale-card-norm">‖v_${w.key}‖ = ${norm.toFixed(2)}</div>
      <div class="scale-card-score" style="color:${w.col}">score = ${dot.toFixed(2)}</div>
    `;
    rhost.appendChild(card);
  });
}
['love','eat','sleep'].forEach(k=>{
  const slider=document.getElementById('scaleSlider'+k[0].toUpperCase()+k.slice(1));
  slider.addEventListener('input',()=>{
    const v=slider.value/100;
    scaleFactors[k]=v;
    document.getElementById('scaleV'+k[0].toUpperCase()+k.slice(1)).textContent=v.toFixed(1);
    drawScale();
  });
});
drawScale();
window.addEventListener('resize',drawScale);

</script>
{% endraw %}
