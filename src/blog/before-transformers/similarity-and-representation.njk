<script>
// image zoom
(function(){
  const modal=document.getElementById('img-modal'),mImg=document.getElementById('img-modal-img'),mCap=document.getElementById('img-modal-cap'),mClose=document.querySelector('.img-modal-close');
  if(!modal)return;
  document.querySelectorAll('.img-frame img').forEach(img=>{
    img.addEventListener('click',()=>{
      mImg.src=img.src;mImg.alt=img.alt||'';
      const cap=img.closest('.img-block')?.querySelector('.img-caption');
      mCap.textContent=cap?cap.textContent.trim():(img.alt||'');
      modal.classList.add('open');modal.setAttribute('aria-hidden','false');
    });
  });
  function close(){modal.classList.remove('open');modal.setAttribute('aria-hidden','true');mImg.src='';mCap.textContent='';}
  mClose.addEventListener('click',close);
  modal.addEventListener('click',e=>{if(e.target===modal)close();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))close();});
})();


// ── VIZ 1: MNIST flatten ─────────────────────────────────────────────────────
// Clean stylised digit templates: 28-row × 28-col ASCII art.
// '#' = lit pixel. Chosen so the pairwise cosine similarity matrix
// produces pedagogically meaningful results (3 and 8 sit near each other,
// 1 is an outlier, etc.).
const DIGIT_ASCII={
  0:["                            ","                            ","                            ","                            ","          #####             ","         #     #            ","        #       #           ","        #       #           ","        #       #           ","        #       #           ","        #       #           ","        #       #           ","        #       #           ","        #       #           ","        #       #           ","        #       #           ","        #       #           ","         #     #            ","          #####             ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            "],
  1:["                            ","                            ","                            ","                            ","            ##              ","           ###              ","          ####              ","            ##              ","            ##              ","            ##              ","            ##              ","            ##              ","            ##              ","            ##              ","            ##              ","            ##              ","            ##              ","            ##              ","            ##              ","         ########           ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            "],
  3:["                            ","                            ","                            ","                            ","         ########           ","                 #          ","                 #          ","                 #          ","                 #          ","                ##          ","         ########           ","                ##          ","                 #          ","                 #          ","                 #          ","                 #          ","                 #          ","                ##          ","         ########           ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            "],
  4:["                            ","                            ","                            ","                            ","              ##            ","             ###            ","            # ##            ","           #  ##            ","          #   ##            ","         #    ##            ","        #     ##            ","       #      ##            ","      #       ##            ","     ############           ","              ##            ","              ##            ","              ##            ","              ##            ","              ##            ","              ##            ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            "],
  7:["                            ","                            ","                            ","                            ","       #############        ","                   #        ","                  #         ","                 #          ","                #           ","               #            ","              #             ","             #              ","            #               ","           #                ","          #                 ","         #                  ","        #                   ","       #                    ","      #                     ","      #                     ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            "],
  8:["                            ","                            ","                            ","                            ","         ########           ","        #        #          ","        #        #          ","        #        #          ","        #        #          ","         #      #           ","          ######            ","         #      #           ","        #        #          ","        #        #          ","        #        #          ","        #        #          ","        #        #          ","         #      #           ","          ######            ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            "],
  9:["                            ","                            ","                            ","                            ","          #######           ","         #       #          ","        #         #         ","        #         #         ","        #         #         ","        #         #         ","         #       #          ","          ########          ","                  #         ","                  #         ","                 #          ","                #           ","               #            ","              #             ","            ##              ","         ####               ","                            ","                            ","                            ","                            ","                            ","                            ","                            ","                            "]
};
const GRID=28,GRID_PX=224,CELL=GRID_PX/GRID; // 8px cells

function buildDigitGrid(digit){
  // returns 28*28 float array in [0,1]
  const arr=new Float32Array(GRID*GRID);
  const rows=DIGIT_ASCII[digit];
  if(!rows)return arr;
  for(let y=0;y<GRID;y++){
    const row=rows[y];
    if(!row)continue;
    for(let x=0;x<GRID;x++){
      if(row[x]==='#')arr[y*GRID+x]=1.0;
    }
  }
  return arr;
}

let currentDigit=3,currentGridData=null,hoverIdx=-1;
const availableDigits=Object.keys(DIGIT_ASCII).map(Number);

// digit picker
const picker=document.getElementById('digitPicker');
availableDigits.forEach(d=>{
  const btn=document.createElement('button');
  btn.className='digit-btn'+(d===currentDigit?' active':'');
  btn.textContent=d;
  btn.dataset.digit=d;
  btn.addEventListener('click',()=>{
    currentDigit=d;
    document.querySelectorAll('.digit-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    renderMnist();
  });
  picker.appendChild(btn);
});

function renderMnist(){
  currentGridData=buildDigitGrid(currentDigit);
  drawGrid();
  drawVector();
  updateStats();
}
function drawGrid(){
  const c=document.getElementById('mnistGrid'),ctx=c.getContext('2d');
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,GRID_PX,GRID_PX);
  for(let i=0;i<GRID*GRID;i++){
    const v=currentGridData[i];
    const x=(i%GRID)*CELL,y=Math.floor(i/GRID)*CELL;
    if(v>0){
      const a=Math.min(1,v);
      ctx.fillStyle=`rgba(181,84,28,${a*0.95})`;
      ctx.fillRect(x,y,CELL,CELL);
    }
    if(i===hoverIdx){
      ctx.strokeStyle='#0a7d52';ctx.lineWidth=2;
      ctx.strokeRect(x+1,y+1,CELL-2,CELL-2);
    }
  }
  // faint grid
  ctx.strokeStyle='rgba(138,129,114,0.04)';ctx.lineWidth=1;
  for(let i=0;i<=GRID;i+=4){
    ctx.beginPath();ctx.moveTo(i*CELL,0);ctx.lineTo(i*CELL,GRID_PX);ctx.stroke();
    ctx.beginPath();ctx.moveTo(0,i*CELL);ctx.lineTo(GRID_PX,i*CELL);ctx.stroke();
  }
}
function drawVector(){
  const c=document.getElementById('mnistVector');
  // handle DPI and responsive width
  const dpr=window.devicePixelRatio||1;
  const W=c.clientWidth||600,H=170;
  c.width=W*dpr;c.height=H*dpr;c.style.height=H+'px';
  const ctx=c.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);
  const n=GRID*GRID;
  const barW=W/n;
  for(let i=0;i<n;i++){
    const v=currentGridData[i];
    if(v>0){
      const h=v*(H-20);
      ctx.fillStyle=i===hoverIdx?'#0a7d52':`rgba(181,84,28,${0.3+v*0.6})`;
      ctx.fillRect(i*barW,H-h-10,Math.max(barW*0.9,1),h);
    }
  }
  // base line
  ctx.strokeStyle='rgba(138,129,114,0.15)';ctx.lineWidth=1;
  ctx.beginPath();ctx.moveTo(0,H-10);ctx.lineTo(W,H-10);ctx.stroke();
  // indices
  ctx.fillStyle='rgba(138,129,114,0.6)';ctx.font='10px "Courier New",monospace';
  ctx.fillText('x₁',2,H-1);
  ctx.textAlign='right';
  ctx.fillText('x₇₈₄',W-2,H-1);
  ctx.textAlign='left';
  // hover highlight marker
  if(hoverIdx>=0){
    ctx.strokeStyle='#0a7d52';ctx.lineWidth=2;
    ctx.beginPath();
    ctx.moveTo(hoverIdx*barW+barW/2,0);
    ctx.lineTo(hoverIdx*barW+barW/2,H-10);
    ctx.stroke();
  }
}
function updateStats(){
  let lit=0,sumsq=0;
  for(let i=0;i<currentGridData.length;i++){
    if(currentGridData[i]>0.01)lit++;
    sumsq+=currentGridData[i]*currentGridData[i];
  }
  document.getElementById('mnistLit').textContent=lit;
  document.getElementById('mnistNorm').textContent=Math.sqrt(sumsq).toFixed(2);
}
// hover handling
const mg=document.getElementById('mnistGrid');
mg.addEventListener('mousemove',e=>{
  const rect=mg.getBoundingClientRect();
  const x=Math.floor((e.clientX-rect.left)/rect.width*GRID);
  const y=Math.floor((e.clientY-rect.top)/rect.height*GRID);
  if(x>=0&&x<GRID&&y>=0&&y<GRID){
    hoverIdx=y*GRID+x;
    const v=currentGridData[hoverIdx];
    document.getElementById('mnistHoverInfo').innerHTML=
      `Pixel <span class="hi">(${x+1}, ${y+1})</span> → coordinate <span class="hi">x<sub>${hoverIdx+1}</sub></span> = <span class="hi">${v.toFixed(2)}</span>`;
    drawGrid();drawVector();
  }
});
mg.addEventListener('mouseleave',()=>{
  hoverIdx=-1;
  document.getElementById('mnistHoverInfo').textContent='Hover any pixel to see its coordinate.';
  drawGrid();drawVector();
});

renderMnist();
window.addEventListener('resize',()=>drawVector());

// ── VIZ 2: Cosine vs Euclidean ───────────────────────────────────────────────
const cosCanvas=document.getElementById('cosCanvas');
const cosCtx=cosCanvas.getContext('2d');
const CW=380,CH=380,cx=CW/2,cy=CH/2;
let vA={x:120,y:-60},vB={x:60,y:-140}; // in canvas "math" coords (y up)
let dragging=null;

function drawCos(){
  cosCtx.fillStyle='#ffffff';cosCtx.fillRect(0,0,CW,CH);
  // grid
  cosCtx.strokeStyle='rgba(138,129,114,0.05)';cosCtx.lineWidth=1;
  for(let i=0;i<=CW;i+=30){
    cosCtx.beginPath();cosCtx.moveTo(i,0);cosCtx.lineTo(i,CH);cosCtx.stroke();
    cosCtx.beginPath();cosCtx.moveTo(0,i);cosCtx.lineTo(CW,i);cosCtx.stroke();
  }
  // axes
  cosCtx.strokeStyle='rgba(138,129,114,0.2)';cosCtx.lineWidth=1.5;
  cosCtx.beginPath();cosCtx.moveTo(0,cy);cosCtx.lineTo(CW,cy);cosCtx.stroke();
  cosCtx.beginPath();cosCtx.moveTo(cx,0);cosCtx.lineTo(cx,CH);cosCtx.stroke();

  // compute metrics
  const dot=vA.x*vB.x+vA.y*vB.y;
  const nA=Math.hypot(vA.x,vA.y),nB=Math.hypot(vB.x,vB.y);
  const cos=nA*nB>0?dot/(nA*nB):0;
  const euc=Math.hypot(vA.x-vB.x,vA.y-vB.y)/50; // scale for readability

  // angle arc
  const angA=Math.atan2(-vA.y,vA.x),angB=Math.atan2(-vB.y,vB.x);
  let start=angA,end=angB;
  // arc radius
  cosCtx.strokeStyle='rgba(181,84,28,0.35)';cosCtx.lineWidth=2;
  cosCtx.beginPath();
  cosCtx.arc(cx,cy,35,start,end,start>end);
  cosCtx.stroke();

  // draw vector A (orange)
  drawArrow(vA,'#b5541c',4,'x');
  // draw vector B (blue)
  drawArrow(vB,'#2e5a7d',4,'y');

  // euclidean dashed line between tips
  cosCtx.setLineDash([4,4]);
  cosCtx.strokeStyle='rgba(46,90,125,0.4)';cosCtx.lineWidth=1.5;
  cosCtx.beginPath();
  cosCtx.moveTo(cx+vA.x,cy-vA.y);
  cosCtx.lineTo(cx+vB.x,cy-vB.y);
  cosCtx.stroke();
  cosCtx.setLineDash([]);

  // label for euclidean midway
  const mx=cx+(vA.x+vB.x)/2,my=cy-(vA.y+vB.y)/2;
  cosCtx.fillStyle='rgba(46,90,125,0.6)';
  cosCtx.font='10px "Courier New",monospace';
  cosCtx.fillText('‖x−y‖',mx+6,my-2);

  // θ label
  const midAng=(angA+angB)/2;
  cosCtx.fillStyle='rgba(181,84,28,0.7)';
  cosCtx.font='italic 14px "Instrument Serif",serif';
  cosCtx.fillText('θ',cx+Math.cos(midAng)*50,cy-Math.sin(midAng)*50+5);

  // origin
  cosCtx.fillStyle='#57503f';
  cosCtx.beginPath();cosCtx.arc(cx,cy,3,0,Math.PI*2);cosCtx.fill();

  // update readouts
  document.getElementById('cosVal').textContent=cos.toFixed(2);
  document.getElementById('eucVal').textContent=euc.toFixed(2);
  // interpretive hints
  let cosHint='Only the angle matters.';
  if(cos>0.95)cosHint='Nearly identical direction.';
  else if(cos>0.5)cosHint='Same general direction.';
  else if(cos>-0.1&&cos<0.1)cosHint='Roughly perpendicular, unrelated.';
  else if(cos<-0.5)cosHint='Pointing the opposite way.';
  document.getElementById('cosSub').textContent=cosHint;
  let eucHint='Length differences count.';
  if(euc<0.5)eucHint='Points are very close.';
  else if(euc>4)eucHint='Points are far apart.';
  document.getElementById('eucSub').textContent=eucHint;
}
function drawArrow(v,col,w,label){
  const tx=cx+v.x,ty=cy-v.y;
  cosCtx.strokeStyle=col;cosCtx.lineWidth=w;
  cosCtx.beginPath();cosCtx.moveTo(cx,cy);cosCtx.lineTo(tx,ty);cosCtx.stroke();
  // arrowhead
  const ang=Math.atan2(ty-cy,tx-cx),ahL=12;
  cosCtx.beginPath();
  cosCtx.moveTo(tx,ty);
  cosCtx.lineTo(tx-ahL*Math.cos(ang-0.4),ty-ahL*Math.sin(ang-0.4));
  cosCtx.lineTo(tx-ahL*Math.cos(ang+0.4),ty-ahL*Math.sin(ang+0.4));
  cosCtx.closePath();cosCtx.fillStyle=col;cosCtx.fill();
  // tip grab handle
  cosCtx.fillStyle=col;
  cosCtx.beginPath();cosCtx.arc(tx,ty,6,0,Math.PI*2);cosCtx.fill();
  cosCtx.fillStyle='#ffffff';
  cosCtx.beginPath();cosCtx.arc(tx,ty,3,0,Math.PI*2);cosCtx.fill();
  // label
  cosCtx.fillStyle=col;
  cosCtx.font='italic 18px "Instrument Serif",serif';
  cosCtx.fillText(label,tx+10,ty-4);
}
function getPointer(e){
  const rect=cosCanvas.getBoundingClientRect();
  const pt=e.touches?e.touches[0]:e;
  return{x:(pt.clientX-rect.left)*(CW/rect.width),y:(pt.clientY-rect.top)*(CH/rect.height)};
}
function hitTest(p){
  // convert vA,vB tip to canvas coords
  const aT={x:cx+vA.x,y:cy-vA.y},bT={x:cx+vB.x,y:cy-vB.y};
  if(Math.hypot(p.x-aT.x,p.y-aT.y)<14)return 'A';
  if(Math.hypot(p.x-bT.x,p.y-bT.y)<14)return 'B';
  return null;
}
cosCanvas.addEventListener('mousedown',e=>{dragging=hitTest(getPointer(e));});
cosCanvas.addEventListener('touchstart',e=>{dragging=hitTest(getPointer(e));if(dragging)e.preventDefault();},{passive:false});
function onMove(e){
  if(!dragging)return;
  const p=getPointer(e);
  const v={x:p.x-cx,y:cy-p.y};
  if(dragging==='A')vA=v;else vB=v;
  drawCos();
  e.preventDefault&&e.preventDefault();
}
cosCanvas.addEventListener('mousemove',onMove);
cosCanvas.addEventListener('touchmove',onMove,{passive:false});
window.addEventListener('mouseup',()=>{dragging=null;});
window.addEventListener('touchend',()=>{dragging=null;});

document.querySelectorAll('.cos-preset').forEach(b=>{
  b.addEventListener('click',()=>{
    const p=b.dataset.preset;
    if(p==='aligned'){vA={x:120,y:60};vB={x:100,y:50};}
    else if(p==='scaled'){vA={x:140,y:70};vB={x:70,y:35};}
    else if(p==='perp'){vA={x:130,y:0};vB={x:0,y:130};}
    else if(p==='opposite'){vA={x:120,y:60};vB={x:-120,y:-60};}
    drawCos();
  });
});
drawCos();

// ── VIZ 3: digit similarity grid ─────────────────────────────────────────────
const simDigits=[0,1,3,4,7,8,9];
let simMetric='cos';

function computeSim(a,b,metric){
  let dot=0,nA=0,nB=0,dsq=0;
  for(let i=0;i<a.length;i++){
    dot+=a[i]*b[i];
    nA+=a[i]*a[i];
    nB+=b[i]*b[i];
    dsq+=(a[i]-b[i])*(a[i]-b[i]);
  }
  if(metric==='cos'){
    return nA*nB>0?dot/(Math.sqrt(nA)*Math.sqrt(nB)):0;
  }else{
    // normalise euclidean to 0..1 roughly
    return Math.sqrt(dsq);
  }
}
function drawSmallDigit(canvas,data){
  const ctx=canvas.getContext('2d');
  const W=canvas.width,H=canvas.height;
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);
  const cell=W/GRID;
  for(let i=0;i<GRID*GRID;i++){
    if(data[i]>0){
      const x=(i%GRID)*cell,y=Math.floor(i/GRID)*cell;
      ctx.fillStyle=`rgba(181,84,28,${Math.min(1,data[i])*0.95})`;
      ctx.fillRect(x,y,cell,cell);
    }
  }
}
function renderSimGrid(){
  const host=document.getElementById('simGrid');
  const n=simDigits.length;
  host.style.gridTemplateColumns=`40px repeat(${n},1fr)`;
  host.innerHTML='';
  // top-left empty
  const corner=document.createElement('div');corner.className='sim-cell header';host.appendChild(corner);
  // column headers
  simDigits.forEach(d=>{
    const h=document.createElement('div');h.className='sim-cell header';h.textContent=d;host.appendChild(h);
  });
  // compute grids up front
  const grids=simDigits.map(d=>buildDigitGrid(d));
  // precompute euclidean max for normalisation
  let eucMax=0;
  for(let i=0;i<n;i++)for(let j=0;j<n;j++){
    if(i!==j){
      const v=computeSim(grids[i],grids[j],'euc');
      if(v>eucMax)eucMax=v;
    }
  }

  simDigits.forEach((rowDigit,ri)=>{
    // row header
    const rh=document.createElement('div');rh.className='sim-cell header';rh.textContent=rowDigit;host.appendChild(rh);
    simDigits.forEach((colDigit,ci)=>{
      const cell=document.createElement('div');
      cell.className='sim-cell'+(ri===ci?' self':'');
      const canv=document.createElement('canvas');
      canv.width=32;canv.height=32;
      drawSmallDigit(canv,grids[ri]); // show row digit
      cell.appendChild(canv);
      const sim=computeSim(grids[ri],grids[ci],simMetric);
      const label=document.createElement('div');
      label.className='sim-val';
      let displayVal;
      if(simMetric==='cos'){
        displayVal=sim.toFixed(2);
        if(sim>0.75)label.classList.add('high');
        else if(sim>0.4)label.classList.add('mid');
        else label.classList.add('low');
      }else{
        displayVal=sim.toFixed(1);
        if(sim<eucMax*0.3)label.classList.add('high');
        else if(sim<eucMax*0.7)label.classList.add('mid');
        else label.classList.add('low');
      }
      label.textContent=ri===ci?(simMetric==='cos'?'1.00':'0.0'):displayVal;
      cell.appendChild(label);
      host.appendChild(cell);
    });
  });
}
document.querySelectorAll('.sim-switch-btn').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('.sim-switch-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    simMetric=b.dataset.metric;
    renderSimGrid();
  });
});
renderSimGrid();

</script>
