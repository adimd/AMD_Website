<script>


// ═══════════════════════════════════════════════════════════════════════════
// Shared utilities
// ═══════════════════════════════════════════════════════════════════════════
function tokenise(s){return s.trim().split(/\s+/).filter(Boolean);}
function buildVocab(sents){
  const seen=new Map(),order=[];
  sents.forEach(s=>{
    tokenise(s).forEach(w=>{
      const k=w.toLowerCase();
      if(!seen.has(k)){seen.set(k,w);order.push(k);}
    });
  });
  return{order,display:k=>seen.get(k)};
}
function buildCoocCounts(sents,vocab,win=1){
  const n=vocab.order.length;
  const M=Array.from({length:n},()=>new Array(n).fill(0));
  const idx=new Map(vocab.order.map((w,i)=>[w,i]));
  sents.forEach(s=>{
    const toks=tokenise(s).map(t=>t.toLowerCase());
    for(let i=0;i<toks.length;i++){
      const ii=idx.get(toks[i]);
      if(ii===undefined)continue;
      for(let j=i+1;j<=Math.min(toks.length-1,i+win);j++){
        const jj=idx.get(toks[j]);
        if(jj===undefined)continue;
        M[ii][jj]++;M[jj][ii]++;
      }
    }
  });
  return M;
}
function rowNormalise(M){
  return M.map(r=>{
    const s=r.reduce((a,b)=>a+b,0);
    return s>0?r.map(v=>v/s):r.slice();
  });
}
// seeded RNG for reproducible "random" model
let seedState=1;
function seededRand(){
  seedState=(seedState*9301+49297)%233280;
  return seedState/233280;
}
function setSeed(n){seedState=n;}

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 1: row-normalised matrix builder
// ═══════════════════════════════════════════════════════════════════════════
const RNM_PRESETS={
  default:['I love my dog','I love my cat','You love my dog','You love my cat'],
  'more-pets':['I love my dog','I love my cat','You love my dog','You love my cat','I love my rabbit','You love my rabbit'],
  clear:[]
};
let rnmSents=[...RNM_PRESETS.default];

function renderRNMSentences(){
  const host=document.getElementById('rnmSentences');
  if(rnmSents.length===0){
    host.innerHTML='<span style="color:var(--muted);font-style:italic;font-size:.85rem">No sentences yet.</span>';
    return;
  }
  host.innerHTML=rnmSents.map((s,i)=>
    `<span class="rnm-sentence-chip">${s.replace(/</g,'&lt;')}<button class="rnm-sentence-remove" data-idx="${i}" title="Remove">×</button></span>`
  ).join('');
  host.querySelectorAll('.rnm-sentence-remove').forEach(b=>{
    b.addEventListener('click',()=>{
      rnmSents.splice(parseInt(b.dataset.idx),1);
      renderRNM();
    });
  });
}
function classifyProb(p){
  if(p===0)return'v0';
  if(p>=0.75)return'v4';
  if(p>=0.45)return'v3';
  if(p>=0.25)return'v2';
  return'v1';
}
function renderRNM(){
  renderRNMSentences();
  const vocab=buildVocab(rnmSents);
  const host=document.getElementById('rnmMatrixHost');
  if(vocab.order.length===0){
    host.innerHTML='<div style="padding:1.5rem;text-align:center;color:var(--muted);font-style:italic">No vocabulary yet, add a sentence above.</div>';
    return;
  }
  const counts=buildCoocCounts(rnmSents,vocab,1);
  const probs=rowNormalise(counts);
  let html='<table class="rnm-matrix"><thead><tr><th></th>';
  vocab.order.forEach(w=>{html+=`<th>${vocab.display(w)}</th>`;});
  html+='<th style="color:var(--green)">Σ</th></tr></thead><tbody>';
  vocab.order.forEach((w,i)=>{
    html+=`<tr><th>${vocab.display(w)}</th>`;
    let rowSum=0;
    probs[i].forEach(p=>{
      rowSum+=p;
      const cls=classifyProb(p);
      const txt=p===0?'0':p.toFixed(2);
      html+=`<td class="${cls}">${txt}</td>`;
    });
    html+=`<td class="rowsum">${rowSum.toFixed(2)}</td></tr>`;
  });
  html+='</tbody></table>';
  host.innerHTML=html;
}
document.getElementById('rnmAdd').addEventListener('click',()=>{
  const v=document.getElementById('rnmInput').value.trim();
  if(!v||tokenise(v).length===0)return;
  rnmSents.push(v);
  document.getElementById('rnmInput').value='';
  renderRNM();
});
document.getElementById('rnmInput').addEventListener('keydown',e=>{
  if(e.key==='Enter')document.getElementById('rnmAdd').click();
});
document.querySelectorAll('.rnm-btn[data-preset]').forEach(b=>{
  b.addEventListener('click',()=>{
    rnmSents=[...RNM_PRESETS[b.dataset.preset]];
    renderRNM();
  });
});
renderRNM();

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 2: P_data vs P_model side by side
// ═══════════════════════════════════════════════════════════════════════════
// Use the same default corpus so P_data is consistent with the prose example.
const CMP_SENTS=['I love my dog','I love my cat','You love my dog','You love my cat'];
const CMP_VOCAB=buildVocab(CMP_SENTS);
const CMP_COUNTS=buildCoocCounts(CMP_SENTS,CMP_VOCAB,1);
const CMP_PDATA=rowNormalise(CMP_COUNTS);

let cmpCentreIdx=CMP_VOCAB.order.indexOf('my');
let cmpProgress=0;
let cmpModelInit=null; // initial random distribution for this "seed"
let cmpAnimHandle=null;

function initCmpModel(){
  // generate a noisy distribution for each centre (softmax over random logits)
  const n=CMP_VOCAB.order.length;
  const perCentre=[];
  for(let i=0;i<n;i++){
    const logits=Array.from({length:n},()=>seededRand()*4-2);
    const m=Math.max(...logits);
    const exps=logits.map(l=>Math.exp(l-m));
    const Z=exps.reduce((a,b)=>a+b,0);
    perCentre.push(exps.map(e=>e/Z));
  }
  cmpModelInit=perCentre;
}
function cmpCurrentModel(centreIdx){
  // Interpolate between cmpModelInit[centreIdx] and CMP_PDATA[centreIdx] by progress/100.
  const t=cmpProgress/100;
  const init=cmpModelInit[centreIdx];
  const target=CMP_PDATA[centreIdx];
  return init.map((v,i)=>(1-t)*v+t*target[i]);
}

function renderCmpCentrePicker(){
  const host=document.getElementById('cmpCentrePicker');
  host.innerHTML='';
  CMP_VOCAB.order.forEach((w,i)=>{
    const b=document.createElement('button');
    b.className='cmp-centre-btn'+(i===cmpCentreIdx?' active':'');
    b.textContent=CMP_VOCAB.display(w);
    b.addEventListener('click',()=>{
      cmpCentreIdx=i;
      renderCmpCentrePicker();
      drawCmp();
    });
    host.appendChild(b);
  });
}
function drawCmp(){
  const canvas=document.getElementById('cmpCanvas');
  const dpr=window.devicePixelRatio||1;
  const W=canvas.clientWidth||700,H=320;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  const pData=CMP_PDATA[cmpCentreIdx];
  const pModel=cmpCurrentModel(cmpCentreIdx);
  const n=CMP_VOCAB.order.length;

  // layout
  const padL=60,padR=30,padT=40,padB=60;
  const plotW=W-padL-padR,plotH=H-padT-padB;
  const groupW=plotW/n;
  const barW=groupW*0.38;
  const gap=groupW*0.06;

  // grid
  ctx.strokeStyle='rgba(138,129,114,.06)';ctx.lineWidth=1;
  for(let i=0;i<=5;i++){
    const y=padT+plotH*i/5;
    ctx.beginPath();ctx.moveTo(padL,y);ctx.lineTo(W-padR,y);ctx.stroke();
  }
  // y-axis labels
  ctx.fillStyle='rgba(138,129,114,.6)';
  ctx.font='10px "Courier New",monospace';
  ctx.textAlign='right';
  for(let i=0;i<=5;i++){
    const y=padT+plotH*i/5;
    const v=1-i/5;
    ctx.fillText(v.toFixed(1),padL-6,y+3);
  }

  // baseline
  ctx.strokeStyle='rgba(138,129,114,.2)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(padL,padT+plotH);ctx.lineTo(W-padR,padT+plotH);ctx.stroke();

  // "1" line
  ctx.strokeStyle='rgba(10,125,82,.4)';ctx.lineWidth=1;
  ctx.setLineDash([4,4]);
  ctx.beginPath();ctx.moveTo(padL,padT);ctx.lineTo(W-padR,padT);ctx.stroke();
  ctx.setLineDash([]);

  // bars
  for(let i=0;i<n;i++){
    const gx=padL+i*groupW+groupW/2;
    const dataBarX=gx-barW-gap/2;
    const modelBarX=gx+gap/2;
    // data bar (orange)
    const dh=pData[i]*plotH;
    ctx.fillStyle='rgba(181,84,28,0.75)';
    ctx.strokeStyle='var(--accent)';
    ctx.lineWidth=1;
    ctx.beginPath();
    const dataY=padT+plotH-dh;
    if(ctx.roundRect)ctx.roundRect(dataBarX,dataY,barW,dh,4);
    else ctx.rect(dataBarX,dataY,barW,dh);
    ctx.fill();
    // model bar (blue)
    const mh=pModel[i]*plotH;
    ctx.fillStyle='rgba(46,90,125,0.75)';
    ctx.beginPath();
    const modelY=padT+plotH-mh;
    if(ctx.roundRect)ctx.roundRect(modelBarX,modelY,barW,mh,4);
    else ctx.rect(modelBarX,modelY,barW,mh);
    ctx.fill();
    // x labels
    ctx.fillStyle='#57503f';
    ctx.font='600 12px "Source Sans 3",sans-serif';
    ctx.textAlign='center';
    ctx.fillText(CMP_VOCAB.display(CMP_VOCAB.order[i]),gx,padT+plotH+20);
    // values above bars (only if > 5%)
    if(pData[i]>0.05){
      ctx.fillStyle='#b5541c';
      ctx.font='10px "Courier New",monospace';
      ctx.textAlign='center';
      ctx.fillText(pData[i].toFixed(2),dataBarX+barW/2,dataY-4);
    }
    if(pModel[i]>0.05){
      ctx.fillStyle='#2e5a7d';
      ctx.font='10px "Courier New",monospace';
      ctx.textAlign='center';
      ctx.fillText(pModel[i].toFixed(2),modelBarX+barW/2,modelY-4);
    }
  }

  // title
  const centreLabel=CMP_VOCAB.display(CMP_VOCAB.order[cmpCentreIdx]);
  ctx.fillStyle='rgba(138,129,114,.6)';
  ctx.font='13px "Source Sans 3",sans-serif';
  ctx.textAlign='left';
  ctx.fillText(`P( · | ${centreLabel} )`,padL,padT-12);

  // compute total disagreement (L1 / 2 = total variation distance, but we'll show L1)
  let gap2=0;
  for(let i=0;i<n;i++)gap2+=Math.abs(pData[i]-pModel[i]);
  document.getElementById('cmpGap').textContent=gap2.toFixed(3);
  const verdict=document.getElementById('cmpGapVerdict');
  if(gap2<0.05){verdict.innerHTML='<span class="good">near perfect agreement</span>';}
  else if(gap2<0.3){verdict.textContent='close but not aligned';}
  else if(gap2<0.8){verdict.textContent='moderate disagreement';}
  else{verdict.textContent='large disagreement';}
}

// progress slider
document.getElementById('cmpProgress').addEventListener('input',e=>{
  cmpProgress=parseFloat(e.target.value);
  document.getElementById('cmpProgressVal').textContent=cmpProgress.toFixed(0)+'%';
  drawCmp();
});
// auto-train
document.getElementById('cmpAnimate').addEventListener('click',()=>{
  if(cmpAnimHandle){clearInterval(cmpAnimHandle);cmpAnimHandle=null;}
  cmpProgress=0;
  document.getElementById('cmpProgress').value=0;
  const step=()=>{
    cmpProgress=Math.min(100,cmpProgress+1.5);
    document.getElementById('cmpProgress').value=cmpProgress;
    document.getElementById('cmpProgressVal').textContent=cmpProgress.toFixed(0)+'%';
    drawCmp();
    if(cmpProgress>=100){clearInterval(cmpAnimHandle);cmpAnimHandle=null;}
  };
  cmpAnimHandle=setInterval(step,30);
});
// reshuffle
document.getElementById('cmpReshuffle').addEventListener('click',()=>{
  setSeed(Math.floor(Math.random()*100000));
  initCmpModel();
  cmpProgress=0;
  document.getElementById('cmpProgress').value=0;
  document.getElementById('cmpProgressVal').textContent='0%';
  drawCmp();
});

setSeed(42);
initCmpModel();
renderCmpCentrePicker();
drawCmp();
window.addEventListener('resize',drawCmp);

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: live timeline, probability rising one encounter at a time
// ═══════════════════════════════════════════════════════════════════════════
// Centre is "my". Under window=1, the only neighbours of "my" across the four
// sentences are "love", "dog", "cat". Total adjacent pairs:
//   (my, love) × 4  (from the 4 "love my …" and "my dog/cat" overlap, see below)
//   (my, dog)  × 2
//   (my, cat)  × 2
// Sequence interleaves them to feel like drawing from a shuffled corpus.
const TL_CONTEXTS=['love','dog','cat'];
// Sequence grouped: 4×love first (matching the prose's numerical checkpoint at step 4),
// then 2×dog and 2×cat. After step 4, P(love)=0.42, P(dog)=P(cat)=0.29, exactly as
// claimed in the prose. After all 8 steps, the distribution is still approaching
// P_data = [0.50, 0.25, 0.25] but hasn't converged, realistic for a low learn rate.
const TL_SEQUENCE=['love','love','love','love','dog','dog','cat','cat'];

let tlStep=0;
let tlProbs=[0.34,0.33,0.33]; // matches prose's initialisation exactly
const TL_LEARN_RATE=0.02;
let tlAutoHandle=null;
let tlRecentChange=null; // {idx, delta} for popup annotation

function tlReset(){
  tlStep=0;
  tlProbs=[0.34,0.33,0.33];
  tlRecentChange=null;
  if(tlAutoHandle){clearInterval(tlAutoHandle);tlAutoHandle=null;document.getElementById('tlAuto').textContent='Auto-play';}
  document.getElementById('tlLog').innerHTML='Press "Next encounter" to start.';
  document.getElementById('tlStep').textContent='0';
  drawTL();
}
function tlNextStep(){
  if(tlStep>=TL_SEQUENCE.length)return false;
  const ctx=TL_SEQUENCE[tlStep];
  const idx=TL_CONTEXTS.indexOf(ctx);
  // Increase P(ctx) by learn rate; redistribute from the rest proportionally
  const before=[...tlProbs];
  const delta=TL_LEARN_RATE;
  tlProbs[idx]+=delta;
  // subtract delta/4 from each of the other 4
  const shareOut=delta/(TL_CONTEXTS.length-1);
  for(let i=0;i<tlProbs.length;i++){
    if(i!==idx)tlProbs[i]-=shareOut;
  }
  // safety clamp & renormalise
  tlProbs=tlProbs.map(p=>Math.max(0.001,p));
  const s=tlProbs.reduce((a,b)=>a+b,0);
  tlProbs=tlProbs.map(p=>p/s);
  tlStep++;
  tlRecentChange={idx,delta,ctx,before};
  // update log
  const actualDelta=tlProbs[idx]-before[idx];
  const logHost=document.getElementById('tlLog');
  const losers=before.map((v,i)=>{
    if(i===idx)return null;
    return {word:TL_CONTEXTS[i],d:tlProbs[i]-v};
  }).filter(Boolean);
  logHost.innerHTML=
    `Step <strong>${tlStep}</strong>: drew (<strong>my</strong>, <strong>${ctx}</strong>). `+
    `P(${ctx}) <span class="up">+${(actualDelta*100).toFixed(1)}%</span>. `+
    `Others each <span class="down">−${Math.abs(losers[0].d*100).toFixed(2)}%</span>.`;
  document.getElementById('tlStep').textContent=tlStep;
  drawTL();
  return true;
}
function drawTL(){
  const canvas=document.getElementById('tlCanvas');
  const dpr=window.devicePixelRatio||1;
  const W=canvas.clientWidth||700,H=260;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  const padL=60,padR=30,padT=40,padB=60;
  const plotW=W-padL-padR,plotH=H-padT-padB;

  // grid
  ctx.strokeStyle='rgba(138,129,114,.06)';ctx.lineWidth=1;
  for(let i=0;i<=5;i++){
    const y=padT+plotH*i/5;
    ctx.beginPath();ctx.moveTo(padL,y);ctx.lineTo(W-padR,y);ctx.stroke();
  }
  // y-labels
  ctx.fillStyle='rgba(138,129,114,.6)';
  ctx.font='10px "Courier New",monospace';
  ctx.textAlign='right';
  for(let i=0;i<=5;i++){
    const y=padT+plotH*i/5;
    ctx.fillText((1-i/5).toFixed(1),padL-6,y+3);
  }
  // axis
  ctx.strokeStyle='rgba(138,129,114,.2)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(padL,padT+plotH);ctx.lineTo(W-padR,padT+plotH);ctx.stroke();

  // bars
  const n=TL_CONTEXTS.length;
  const barW=plotW/n*0.6;
  const gap=plotW/n*0.4;
  const colors=['#b5541c','#2e5a7d','#7c4dbc','#0a7d52','#a83c2c'];
  for(let i=0;i<n;i++){
    const x=padL+i*(plotW/n)+(plotW/n-barW)/2;
    const h=tlProbs[i]*plotH;
    const y=padT+plotH-h;
    ctx.fillStyle=colors[i]+'cc';
    ctx.strokeStyle=colors[i];
    ctx.lineWidth=1.5;
    ctx.beginPath();
    if(ctx.roundRect)ctx.roundRect(x,y,barW,h,5);
    else ctx.rect(x,y,barW,h);
    ctx.fill();ctx.stroke();
    // word label
    ctx.fillStyle='#57503f';
    ctx.font='600 12px "Source Sans 3",sans-serif';
    ctx.textAlign='center';
    ctx.fillText(TL_CONTEXTS[i],x+barW/2,padT+plotH+20);
    // value
    ctx.fillStyle=colors[i];
    ctx.font='600 11px "Courier New",monospace';
    ctx.fillText(tlProbs[i].toFixed(2),x+barW/2,y-6);
    // delta annotation for the most recent change (appears as "+X" floating up)
    if(tlRecentChange&&i===tlRecentChange.idx){
      ctx.fillStyle='#0a7d52';
      ctx.font='700 13px "Courier New",monospace';
      ctx.fillText('+'+(tlRecentChange.delta*100).toFixed(0)+'%',x+barW/2,y-22);
    }
  }

  // title
  ctx.fillStyle='rgba(138,129,114,.6)';
  ctx.font='13px "Source Sans 3",sans-serif';
  ctx.textAlign='left';
  ctx.fillText('P_model( · | my ), evolving through encounters',padL,padT-14);
}
document.getElementById('tlNext').addEventListener('click',()=>{
  if(!tlNextStep()){
    document.getElementById('tlLog').innerHTML='End of sequence. Press <strong>Reset</strong> to start over.';
  }
});
document.getElementById('tlAuto').addEventListener('click',()=>{
  const btn=document.getElementById('tlAuto');
  if(tlAutoHandle){
    clearInterval(tlAutoHandle);tlAutoHandle=null;btn.textContent='Auto-play';return;
  }
  btn.textContent='Pause';
  tlAutoHandle=setInterval(()=>{
    if(!tlNextStep()){clearInterval(tlAutoHandle);tlAutoHandle=null;btn.textContent='Auto-play';}
  },650);
});
document.getElementById('tlReset').addEventListener('click',tlReset);
drawTL();
window.addEventListener('resize',drawTL);

</script>
{% endraw %}
