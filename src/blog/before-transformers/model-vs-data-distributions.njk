    <rect x="24" y="48" width="160" height="96" rx="10" fill="#ffffff" stroke="#ece4d6" stroke-width="1.5"/>
    <text x="104" y="72" text-anchor="middle" font-family="JetBrains Mono" font-size="10" fill="#57503f">I love my dog</text>
    <text x="104" y="90" text-anchor="middle" font-family="JetBrains Mono" font-size="10" fill="#57503f">I love my cat</text>
