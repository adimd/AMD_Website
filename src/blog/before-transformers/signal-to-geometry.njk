<script>
// ═══════════════════════════════════════════════════════════════════════════
// SHARED: 2D canvas helpers
// ═══════════════════════════════════════════════════════════════════════════
function setupCanvas(canvas,W,H){
  const dpr=window.devicePixelRatio||1;
  const cW=canvas.clientWidth||W;
  canvas.width=cW*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,cW,H);
  return{ctx,W:cW,H};
}
function drawAxes(ctx,W,H){
  ctx.strokeStyle='rgba(138,129,114,.04)';ctx.lineWidth=1;
  for(let i=25;i<W;i+=25){ctx.beginPath();ctx.moveTo(i,0);ctx.lineTo(i,H);ctx.stroke();}
  for(let i=25;i<H;i+=25){ctx.beginPath();ctx.moveTo(0,i);ctx.lineTo(W,i);ctx.stroke();}
  ctx.strokeStyle='rgba(138,129,114,.12)';ctx.lineWidth=1;
  ctx.beginPath();ctx.moveTo(0,H/2);ctx.lineTo(W,H/2);ctx.stroke();
  ctx.beginPath();ctx.moveTo(W/2,0);ctx.lineTo(W/2,H);ctx.stroke();
}
function drawArrow(ctx,cx,cy,vx,vy,col,w,label,dashed){
  const tx=cx+vx,ty=cy-vy;
  ctx.save();
  ctx.strokeStyle=col;ctx.lineWidth=w;ctx.fillStyle=col;
  if(dashed)ctx.setLineDash([6,4]);
  ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(tx,ty);ctx.stroke();
  ctx.setLineDash([]);
  // arrowhead
  const ang=Math.atan2(ty-cy,tx-cx),ahL=10;
  ctx.beginPath();
  ctx.moveTo(tx,ty);
  ctx.lineTo(tx-ahL*Math.cos(ang-0.4),ty-ahL*Math.sin(ang-0.4));
  ctx.lineTo(tx-ahL*Math.cos(ang+0.4),ty-ahL*Math.sin(ang+0.4));
  ctx.closePath();ctx.fill();
  if(label){
    ctx.font='italic 14px "Instrument Serif",serif';
    ctx.textBaseline='middle';
    ctx.textAlign=vx>=0?'left':'right';
    const lx=tx+(vx>=0?8:-8),ly=ty+(vy>=0?-8:12);
    ctx.fillText(label,lx,ly);
  }
  ctx.restore();
}
function softmax(s){const m=Math.max(...s);const e=s.map(x=>Math.exp(x-m));const Z=e.reduce((a,b)=>a+b,0);return e.map(x=>x/Z);}

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 1: C_k update decomposition
// ═══════════════════════════════════════════════════════════════════════════
const CK_ETA=0.4;
const CK_SCALE=60; // px per unit
let ckIsTrue=true;
let ckPk=0.20;
let ckW=[1.6,0.9];     // centre vector
let ckCk=[-0.6,1.3];   // initial context vector
let ckCkInit=[...ckCk];

function drawCK(){
  const canvas=document.getElementById('ckCanvas');
  const {ctx,W,H}=setupCanvas(canvas,700,380);
  drawAxes(ctx,W,H);
  const cx=W/2,cy=H/2;

  // Always draw W (orange) and C_k (blue)
  drawArrow(ctx,cx,cy,ckW[0]*CK_SCALE,ckW[1]*CK_SCALE,'#b5541c',4,'W');
  drawArrow(ctx,cx,cy,ckCk[0]*CK_SCALE,ckCk[1]*CK_SCALE,'#2e5a7d',3,'C_k');

  // Draw correction vector: ΔC_k = -η(p_k - q_k) W
  const q=ckIsTrue?1:0;
  const gap=ckPk-q;
  const delta=[-CK_ETA*gap*ckW[0],-CK_ETA*gap*ckW[1]];
  // Display as dashed arrow starting at the tip of C_k
  const ckTipX=cx+ckCk[0]*CK_SCALE;
  const ckTipY=cy-ckCk[1]*CK_SCALE;
  const dx=delta[0]*CK_SCALE;
  const dy=delta[1]*CK_SCALE;
  if(Math.hypot(dx,dy)>1){
    drawArrow(ctx,ckTipX,ckTipY,dx,dy,ckIsTrue?'#0a7d52':'#a83c2c',2.5,'ΔC_k',true);
    // Also show where C_k would land (faint blue)
    const newCk=[ckCk[0]+delta[0],ckCk[1]+delta[1]];
    ctx.save();
    ctx.globalAlpha=0.35;
    drawArrow(ctx,cx,cy,newCk[0]*CK_SCALE,newCk[1]*CK_SCALE,'#2e5a7d',2,null);
    ctx.restore();
  }

  // Origin
  ctx.fillStyle='#57503f';
  ctx.beginPath();ctx.arc(cx,cy,3,0,Math.PI*2);ctx.fill();

  // Formula readout
  const host=document.getElementById('ckFormula');
  const gapStr=(gap>=0?'+':'')+gap.toFixed(3);
  const deltaMag=Math.hypot(delta[0],delta[1]);
  const direction=ckIsTrue?'<span class="up">toward W (pulled in)</span>':'<span class="down">away from W (pushed out)</span>';
  host.innerHTML=`
    ΔC<sub>k</sub> = −η (p<sub>k</sub> − q<sub>k</sub>) · W &nbsp; = &nbsp; −${CK_ETA} × (${ckPk.toFixed(2)} − ${q}) · W &nbsp; = &nbsp; <strong>${gapStr}</strong> · W × (−η)
    <br>Direction: C<sub>k</sub> moves ${direction}. Magnitude |ΔC<sub>k</sub>| = ${deltaMag.toFixed(3)}.
  `;
}
document.getElementById('ckTrue').addEventListener('click',()=>{
  ckIsTrue=true;
  document.getElementById('ckTrue').classList.add('on');
  document.getElementById('ckFalse').classList.remove('on');
  drawCK();
});
document.getElementById('ckFalse').addEventListener('click',()=>{
  ckIsTrue=false;
  document.getElementById('ckFalse').classList.add('on');
  document.getElementById('ckTrue').classList.remove('on');
  drawCK();
});
document.getElementById('ckSlider').addEventListener('input',e=>{
  ckPk=parseFloat(e.target.value)/1000;
  document.getElementById('ckPVal').textContent=ckPk.toFixed(2);
  drawCK();
});
document.getElementById('ckStep').addEventListener('click',()=>{
  const q=ckIsTrue?1:0;
  const gap=ckPk-q;
  ckCk[0]-=CK_ETA*gap*ckW[0];
  ckCk[1]-=CK_ETA*gap*ckW[1];
  drawCK();
});
document.getElementById('ckReset').addEventListener('click',()=>{
  ckCk=[...ckCkInit];
  drawCK();
});
drawCK();
window.addEventListener('resize',drawCK);

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 2: W update as weighted sum
// ═══════════════════════════════════════════════════════════════════════════
const WU_ETA=0.3;
const WU_SCALE=55;
const WU_WORDS=['love','dog','cat','friends'];
const WU_COLORS=['#b5541c','#0a7d52','#7c4dbc','#a83c2c'];
// Context vectors in 2D
let wuCk=[[1.5,0.4],[0.8,1.3],[1.1,1.1],[-0.7,-1.2]];
let wuCkInit=wuCk.map(v=>[...v]);
let wuScores=[1.5, 0.8, 0.6, -0.2];
let wuW=[0.5,0.3];
let wuWInit=[...wuW];
let wuTrueIdx=0;

function drawWU(){
  const canvas=document.getElementById('wuCanvas');
  const {ctx,W,H}=setupCanvas(canvas,700,420);
  drawAxes(ctx,W,H);
  const cx=W/2,cy=H/2;

  // Probabilities
  const p=softmax(wuScores);
  // Individual contribution vectors: (p_k - q_k) * C_k
  const contribs=p.map((pv,i)=>{
    const q=i===wuTrueIdx?1:0;
    return [(pv-q)*wuCk[i][0], (pv-q)*wuCk[i][1]];
  });
  // Total correction (we'll move W in the NEGATIVE direction of this)
  const totalCorr=[
    contribs.reduce((s,c)=>s+c[0],0),
    contribs.reduce((s,c)=>s+c[1],0)
  ];

  // Draw all C_k vectors (dimmer)
  wuCk.forEach((v,i)=>{
    const col=WU_COLORS[i];
    const isTrue=i===wuTrueIdx;
    ctx.save();
    ctx.globalAlpha=isTrue?0.9:0.55;
    drawArrow(ctx,cx,cy,v[0]*WU_SCALE,v[1]*WU_SCALE,col,isTrue?3:2,'C_'+WU_WORDS[i]);
    ctx.restore();
  });

  // Draw W
  drawArrow(ctx,cx,cy,wuW[0]*WU_SCALE,wuW[1]*WU_SCALE,'#57503f',4,'W');

  // Draw the full correction vector (dashed grey) from tip of W
  const corrMag=Math.hypot(totalCorr[0],totalCorr[1]);
  if(corrMag>0.01){
    const wTipX=cx+wuW[0]*WU_SCALE;
    const wTipY=cy-wuW[1]*WU_SCALE;
    // ΔW = -η * totalCorr
    const dw=[-WU_ETA*totalCorr[0],-WU_ETA*totalCorr[1]];
    drawArrow(ctx,wTipX,wTipY,dw[0]*WU_SCALE,dw[1]*WU_SCALE,'#57503f',2.5,'ΔW',true);
    // Show where W would land
    const newW=[wuW[0]+dw[0],wuW[1]+dw[1]];
    ctx.save();
    ctx.globalAlpha=0.3;
    drawArrow(ctx,cx,cy,newW[0]*WU_SCALE,newW[1]*WU_SCALE,'#57503f',2,null);
    ctx.restore();
  }

  // Origin
  ctx.fillStyle='#57503f';
  ctx.beginPath();ctx.arc(cx,cy,3,0,Math.PI*2);ctx.fill();

  
// ── Render contribution bars ──
  const contribHost=document.getElementById('wuContribs');
  contribHost.innerHTML='';
  const maxAbsGap=Math.max(...p.map((pv,i)=>Math.abs(pv-(i===wuTrueIdx?1:0))),0.01);
  p.forEach((pv,i)=>{
    const q=i===wuTrueIdx?1:0;
    const gap=pv-q;
    const isTrue=i===wuTrueIdx;
    const pct=Math.abs(gap)/maxAbsGap*48;
    const barHTML=gap>0
      ? `<div class="wu-contrib-zero"></div><div class="wu-contrib-fill pos" style="left:50%;width:${pct}%"></div>`
      : `<div class="wu-contrib-zero"></div><div class="wu-contrib-fill neg" style="right:50%;width:${pct}%"></div>`;
    const row=document.createElement('div');
    row.className='wu-contrib-row'+(isTrue?' true':'');
    row.innerHTML=`
      <span class="w ${isTrue?'true':''}">C_${WU_WORDS[i]}</span>
      <div class="wu-contrib-bar">${barHTML}</div>
      <span class="wu-contrib-gap">${gap>=0?'+':''}${gap.toFixed(3)}</span>
      <span class="wu-contrib-val">p=${(pv*100).toFixed(0)}%</span>
    `;
    contribHost.appendChild(row);
  });

  // Summary
  const sumHost=document.getElementById('wuSummary');
  const lossNow=-Math.log(Math.max(1e-12,p[wuTrueIdx]));
  sumHost.innerHTML=`
    ΔW = −η · Σ<sub>k</sub>(p<sub>k</sub> − q<sub>k</sub>) · C<sub>k</sub> &nbsp; <br>
    Total correction vector = [${totalCorr[0].toFixed(3)}, ${totalCorr[1].toFixed(3)}] &nbsp; · &nbsp; |ΔW| = <strong>${(WU_ETA*corrMag).toFixed(3)}</strong> &nbsp; · &nbsp; current loss = <strong>${lossNow.toFixed(3)}</strong>
  `;
}
function renderWUSliders(){
  const host=document.getElementById('wuSliders');
  host.innerHTML='';
  wuScores.forEach((s,i)=>{
    const row=document.createElement('div');
    row.className='wu-slider-row';
    row.innerHTML=`
      <span class="w" style="color:${WU_COLORS[i]}">s_${WU_WORDS[i]}</span>
      <input type="range" min="-30" max="40" step="1" value="${Math.round(s*10)}" data-idx="${i}">
      <span class="v" id="wuSliderV${i}">${s.toFixed(1)}</span>
    `;
    host.appendChild(row);
  });
  host.querySelectorAll('input').forEach(inp=>{
    inp.addEventListener('input',e=>{
      const k=parseInt(e.target.dataset.idx);
      wuScores[k]=parseFloat(e.target.value)/10;
      document.getElementById('wuSliderV'+k).textContent=wuScores[k].toFixed(1);
      drawWU();
    });
  });
}
function renderWUTruePicker(){
  const host=document.getElementById('wuTruePicker');
  host.innerHTML='';
  WU_WORDS.forEach((w,i)=>{
    const b=document.createElement('button');
    b.className='sp-true-btn'+(i===wuTrueIdx?' active':'');
    b.style.cssText=`padding:.3rem .7rem;border-radius:6px;background:${i===wuTrueIdx?'var(--accent-dim)':'var(--bg-card)'};border:1px solid ${i===wuTrueIdx?'var(--accent)':'var(--border-hover)'};color:${i===wuTrueIdx?'var(--accent)':'var(--muted)'};font-size:.8rem;cursor:pointer;font-family:inherit`;
    b.textContent=w;
    b.addEventListener('click',()=>{
      wuTrueIdx=i;
      renderWUTruePicker();
      drawWU();
    });
    host.appendChild(b);
  });
}
document.getElementById('wuStep').addEventListener('click',()=>{
  const p=softmax(wuScores);
  const corr=[0,0];
  for(let k=0;k<wuCk.length;k++){
    const q=k===wuTrueIdx?1:0;
    corr[0]+=(p[k]-q)*wuCk[k][0];
    corr[1]+=(p[k]-q)*wuCk[k][1];
  }
  wuW[0]-=WU_ETA*corr[0];
  wuW[1]-=WU_ETA*corr[1];
  drawWU();
});
document.getElementById('wuReset').addEventListener('click',()=>{
  wuW=[...wuWInit];
  wuCk=wuCkInit.map(v=>[...v]);
  drawWU();
});
renderWUTruePicker();
renderWUSliders();
drawWU();
window.addEventListener('resize',drawWU);

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: full corpus training
// ═══════════════════════════════════════════════════════════════════════════
const CORP_WORDS=['I','You','love','my','dog','cat'];
const CORP_N=CORP_WORDS.length;
const CORP_D=2; // embedding dim
const CORP_ETA=0.05;
const CORP_SENTENCES=[
  ['I','love','my','dog'],
  ['I','love','my','cat'],
  ['You','love','my','dog'],
  ['You','love','my','cat']
];
// Build (centre, context) pairs with window=1
function buildPairs(){
  const pairs=[];
  for(const s of CORP_SENTENCES){
    for(let i=0;i<s.length;i++){
      for(let j=Math.max(0,i-1);j<=Math.min(s.length-1,i+1);j++){
        if(i!==j)pairs.push([s[i],s[j]]);
      }
    }
  }
  return pairs;
}
const CORP_PAIRS=buildPairs();
let corpWIdx=Object.fromEntries(CORP_WORDS.map((w,i)=>[w,i]));

// State: W (centre embeddings) and C (context embeddings), both [N x D]
let corpW=null, corpC=null;
let corpEpoch=0;
let corpRunning=false;
let corpRunHandle=null;

function seededRand(seed){
  // Deterministic random so reset returns to same init
  let s=seed;
  return ()=>{s=(s*9301+49297)%233280;return s/233280;};
}
function initCorp(seed=42){
  const rand=seededRand(seed);
  corpW=[];corpC=[];
  for(let i=0;i<CORP_N;i++){
    corpW.push([rand()*2-1,rand()*2-1]);
    corpC.push([rand()*2-1,rand()*2-1]);
  }
  corpEpoch=0;
  document.getElementById('corpEpoch').textContent='0';
  document.getElementById('corpLoss').textContent='-';
}
function corpForward(centreIdx){
  const w=corpW[centreIdx];
  const scores=corpC.map(c=>w[0]*c[0]+w[1]*c[1]);
  return{scores,probs:softmax(scores)};
}
function corpTrainOneStep(centreIdx,targetIdx){
  const {probs}=corpForward(centreIdx);
  // gradient on scores: p_k - q_k
  const grad=probs.map((p,k)=>p-(k===targetIdx?1:0));
  const w=corpW[centreIdx];
  // Update each C_k: C_k -= eta * grad[k] * W
  for(let k=0;k<CORP_N;k++){
    corpC[k][0]-=CORP_ETA*grad[k]*w[0];
    corpC[k][1]-=CORP_ETA*grad[k]*w[1];
  }
  // Update W: W -= eta * sum_k grad[k] * C_k (use PRE-update C for cleaner semantics)
  // Actually standard SGD uses the pre-step C, so we saved the original C already, but we've now modified C. Redo with a snapshot:
  // Simpler: compute delta W using the current-step C_pre. Let's redo properly.
}
// Cleaner: compute both updates from a snapshot
function corpTrainPairProper(centreIdx,targetIdx){
  const {probs}=corpForward(centreIdx);
  const grad=probs.map((p,k)=>p-(k===targetIdx?1:0));
  const wSnap=[corpW[centreIdx][0],corpW[centreIdx][1]];
  const cSnap=corpC.map(c=>[c[0],c[1]]);
  // ΔW
  let dw=[0,0];
  for(let k=0;k<CORP_N;k++){
    dw[0]+=grad[k]*cSnap[k][0];
    dw[1]+=grad[k]*cSnap[k][1];
  }
  corpW[centreIdx][0]-=CORP_ETA*dw[0];
  corpW[centreIdx][1]-=CORP_ETA*dw[1];
  // ΔC_k for each k
  for(let k=0;k<CORP_N;k++){
    corpC[k][0]-=CORP_ETA*grad[k]*wSnap[0];
    corpC[k][1]-=CORP_ETA*grad[k]*wSnap[1];
  }
  return -Math.log(Math.max(1e-12,probs[targetIdx]));
}
function corpRunEpoch(){
  // Shuffle pairs each epoch for stochasticity
  const shuffled=[...CORP_PAIRS].sort(()=>Math.random()-0.5);
  let totalLoss=0;
  for(const [c,t] of shuffled){
    totalLoss+=corpTrainPairProper(corpWIdx[c],corpWIdx[t]);
  }
  corpEpoch++;
  return totalLoss/shuffled.length;
}

function cosineSim(a,b){
  const dot=a[0]*b[0]+a[1]*b[1];
  const na=Math.hypot(...a),nb=Math.hypot(...b);
  if(na<1e-8||nb<1e-8)return 0;
  return dot/(na*nb);
}

function renderCorpSims(){
  // Within group: dog-cat, I-You
  const within=[['dog','cat'],['I','You']];
  const cross=[['dog','I'],['love','my'],['I','dog'],['You','cat']];

  function makeRow(pair,featured){
    const [a,b]=pair;
    const s=cosineSim(corpW[corpWIdx[a]],corpW[corpWIdx[b]]);
    const isFeatured=featured;
    // Within-group is good when positive and high. Cross-group is good when NOT high-positive.
    const isGood=(featured&&s>0.6)||(!featured&&s<0.3);
    const pct=Math.abs(s)*48;
    const barHTML=s>=0
      ? `<div class="corp-sim-zero"></div><div class="corp-sim-fill pos" style="left:50%;width:${pct}%"></div>`
      : `<div class="corp-sim-zero"></div><div class="corp-sim-fill neg" style="right:50%;width:${pct}%"></div>`;
    return `
      <div class="corp-sim-row${isFeatured?' featured':''}">
        <span class="pair ${isGood?'match':''}">${a} ↔ ${b}</span>
        <div class="corp-sim-bar">${barHTML}</div>
        <span class="corp-sim-val ${isGood?'good':''}">${s.toFixed(2)}</span>
      </div>
    `;
  }

  document.getElementById('corpWithin').innerHTML=within.map(p=>makeRow(p,true)).join('');
  document.getElementById('corpCross').innerHTML=cross.map(p=>makeRow(p,false)).join('');
}

function drawCorp(){
  const canvas=document.getElementById('corpCanvas');
  const {ctx,W,H}=setupCanvas(canvas,700,420);
  drawAxes(ctx,W,H);
  const cx=W/2,cy=H/2;
  const SCALE=55;

  // Assign visual colours and groups
  const GROUPS={
    'I':{col:'#7c4dbc',grp:'pronoun'},
    'You':{col:'#7c4dbc',grp:'pronoun'},
    'love':{col:'#b5541c',grp:'verb'},
    'my':{col:'#b5541c',grp:'verb'},
    'dog':{col:'#0a7d52',grp:'animal'},
    'cat':{col:'#0a7d52',grp:'animal'}
  };

  // Find a reasonable scale so vectors fit
  let maxNorm=0;
  for(const v of corpW){maxNorm=Math.max(maxNorm,Math.hypot(v[0],v[1]));}
  const dynScale=maxNorm>1e-6?Math.min(SCALE,140/maxNorm):SCALE;

  // Draw centre vectors W_word
  CORP_WORDS.forEach((word,i)=>{
    const v=corpW[i];
    const col=GROUPS[word].col;
    drawArrow(ctx,cx,cy,v[0]*dynScale,v[1]*dynScale,col,2.5,word);
  });

  // Origin
  ctx.fillStyle='#57503f';
  ctx.beginPath();ctx.arc(cx,cy,3,0,Math.PI*2);ctx.fill();

  renderCorpSims();
}

function corpStepEpoch(){
  const avgLoss=corpRunEpoch();
  document.getElementById('corpEpoch').textContent=corpEpoch;
  document.getElementById('corpLoss').textContent=avgLoss.toFixed(3);
  drawCorp();
}

document.getElementById('corpStep').addEventListener('click',()=>corpStepEpoch());
document.getElementById('corpRun').addEventListener('click',()=>{
  if(corpRunHandle){clearInterval(corpRunHandle);corpRunHandle=null;document.getElementById('corpRun').textContent='Train 50 epochs';corpRunning=false;return;}
  corpRunning=true;
  document.getElementById('corpRun').textContent='Stop';
  let count=0;
  corpRunHandle=setInterval(()=>{
    corpStepEpoch();
    count++;
    if(count>=50){
      clearInterval(corpRunHandle);corpRunHandle=null;corpRunning=false;
      document.getElementById('corpRun').textContent='Train 50 more epochs';
    }
  },60);
});
document.getElementById('corpReset').addEventListener('click',()=>{
  if(corpRunHandle){clearInterval(corpRunHandle);corpRunHandle=null;document.getElementById('corpRun').textContent='Train 50 epochs';corpRunning=false;}
  // new random seed each reset
  initCorp(Math.floor(Math.random()*10000));
  drawCorp();
});
initCorp(42);
drawCorp();
window.addEventListener('resize',drawCorp);

</script>
{% endraw %}
