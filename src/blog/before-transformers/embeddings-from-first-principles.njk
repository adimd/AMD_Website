<script>
// ═══════════════════════════════════════════════════════════════════════════
// VIZ 1: CORPUS BUILDER + LIVE MATRIX + GRAPH
// ═══════════════════════════════════════════════════════════════════════════
const PRESETS={
  default:['I love my dog','I love my cat','You love my dog','You love my cat'],
  pets:['I love my dog','I love my cat','You love my dog','You love my cat','I love my rabbit','You love my rabbit','I love my hamster','You love my hamster'],
  food:['I love my pizza','I love my pasta','You love my pizza','You love my pasta'],
  clear:[]
};
let sentences=[...PRESETS.default];
let windowSize=1;

function tokenise(s){
  return s.trim().split(/\s+/).filter(Boolean);
}
// Build vocab preserving first-seen order
function buildVocab(sents){
  const seen=new Map(); // lower -> original case
  const order=[];
  sents.forEach(s=>{
    tokenise(s).forEach(w=>{
      const k=w.toLowerCase();
      if(!seen.has(k)){seen.set(k,w);order.push(k);}
    });
  });
  return{order,display:k=>seen.get(k)};
}
function buildCooc(sents,vocab,win){
  const n=vocab.order.length;
  const M=Array.from({length:n},()=>new Array(n).fill(0));
  const idx=new Map(vocab.order.map((w,i)=>[w,i]));
  sents.forEach(s=>{
    const toks=tokenise(s).map(t=>t.toLowerCase());
    for(let i=0;i<toks.length;i++){
      const ii=idx.get(toks[i]);
      if(ii===undefined)continue;
      const maxJ=win>=99?toks.length-1:Math.min(toks.length-1,i+win);
      for(let j=i+1;j<=maxJ;j++){
        const jj=idx.get(toks[j]);
        if(jj===undefined)continue;
        M[ii][jj]++;M[jj][ii]++;
      }
    }
  });
  return M;
}
function colorClass(v,max){
  if(v===0)return'c0';
  if(max<=1)return v>0?'c1':'c0';
  const r=v/max;
  if(r>=0.9)return'c4';
  if(r>=0.65)return'c3';
  if(r>=0.35)return'c2';
  return'c1';
}
function findTwins(M,vocab){
  // groups of words with identical rows (only returns groups of size >= 2)
  const n=vocab.order.length;
  const groups=new Map(); // key=row signature -> [word indices]
  for(let i=0;i<n;i++){
    const key=M[i].join(',');
    if(!groups.has(key))groups.set(key,[]);
    groups.get(key).push(i);
  }
  const twins=[];
  groups.forEach((arr,key)=>{
    if(arr.length>=2&&key!==new Array(n).fill(0).join(','))twins.push(arr);
  });
  return twins;
}
function renderMatrix(){
  const vocab=buildVocab(sentences);
  const M=buildCooc(sentences,vocab,windowSize);
  const host=document.getElementById('matrixHost');
  if(vocab.order.length===0){
    host.innerHTML='<div style="padding:2rem;text-align:center;color:var(--muted);font-style:italic">No sentences yet.</div>';
    renderGraph(vocab,M,[]);
    document.getElementById('matrixInsight').className='matrix-insight none';
    document.getElementById('matrixInsight').textContent='Add some sentences to see the structure appear.';
    return;
  }
  let max=0;
  for(let i=0;i<M.length;i++)for(let j=0;j<M[i].length;j++)if(i!==j&&M[i][j]>max)max=M[i][j];
  const twins=findTwins(M,vocab);
  const twinSet=new Set();
  twins.forEach(g=>g.forEach(i=>twinSet.add(i)));

  // header
  let html='<table class="cooc-matrix"><thead><tr><th></th>';
  vocab.order.forEach(w=>{html+=`<th>${vocab.display(w)}</th>`;});
  html+='</tr></thead><tbody>';
  vocab.order.forEach((w,i)=>{
    const twinClass=twinSet.has(i)?'twin':'';
    html+=`<tr class="${twinClass}"><th>${vocab.display(w)}</th>`;
    M[i].forEach(v=>{
      html+=`<td class="${colorClass(v,max)}">${v}</td>`;
    });
    html+='</tr>';
  });
  html+='</tbody></table>';
  host.innerHTML=html;

  // insight
  const ins=document.getElementById('matrixInsight');
  if(twins.length>0){
    const parts=twins.map(g=>g.map(i=>`"${vocab.display(vocab.order[i])}"`).join(' / '));
    ins.className='matrix-insight';
    ins.innerHTML=`<span class="twin-badge">identical rows</span>${parts.join('<br><span class="twin-badge">identical rows</span>')} — these words are neighbour-twins. Nothing told the machine they're similar. They behave the same way in the corpus.`;
  }else if(vocab.order.length<2){
    ins.className='matrix-insight none';
    ins.textContent='Add more sentences to start seeing patterns.';
  }else{
    ins.className='matrix-insight none';
    ins.textContent='No two words have exactly the same row. Try adding a sentence that uses a new word in the same position as an existing one.';
  }

  renderGraph(vocab,M,twinSet);
}


// ── Graph renderer ──────────────────────────────────────────────────────────
const gCanvas=document.getElementById('graphCanvas');
function renderGraph(vocab,M,twinSet){
  const dpr=window.devicePixelRatio||1;
  const W=gCanvas.clientWidth||560,H=340;
  gCanvas.width=W*dpr;gCanvas.height=H*dpr;gCanvas.style.height=H+'px';
  const ctx=gCanvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  const n=vocab.order.length;
  if(n===0){
    ctx.fillStyle='rgba(138,129,114,0.5)';
    ctx.font='italic 13px "Source Sans 3",sans-serif';
    ctx.textAlign='center';
    ctx.fillText('No words yet.',W/2,H/2);
    return;
  }

  // compute node degrees for radius and layout
  const degree=M.map(row=>row.reduce((a,b)=>a+b,0));
  // Place nodes on a circle, sorted by degree (hubs toward center would be ideal,
  // but a circle keeps layout stable & predictable for the pedagogical point)
  const positions=[];
  const cx=W/2,cy=H/2;
  const minDim=Math.min(W,H);
  const radius=minDim*0.36;
  for(let i=0;i<n;i++){
    const ang=-Math.PI/2+(i/n)*Math.PI*2;
    positions.push({x:cx+Math.cos(ang)*radius,y:cy+Math.sin(ang)*radius});
  }

  // find max weight for edge styling
  let maxW=0;
  for(let i=0;i<n;i++)for(let j=i+1;j<n;j++)if(M[i][j]>maxW)maxW=M[i][j];

  // draw edges
  for(let i=0;i<n;i++){
    for(let j=i+1;j<n;j++){
      if(M[i][j]===0)continue;
      const w=M[i][j];
      const alpha=0.25+0.55*(w/Math.max(maxW,1));
      const thick=2+6*(w/Math.max(maxW,1));
      ctx.strokeStyle=`rgba(181,84,28,${alpha})`;
      ctx.lineWidth=thick;
      ctx.beginPath();
      ctx.moveTo(positions[i].x,positions[i].y);
      ctx.lineTo(positions[j].x,positions[j].y);
      ctx.stroke();
      // weight label
      if(n<=12){
        const mx=(positions[i].x+positions[j].x)/2;
        const my=(positions[i].y+positions[j].y)/2;
        ctx.fillStyle='rgba(138,129,114,0.55)';
        ctx.font='600 11px "Courier New",monospace';
        ctx.textAlign='center';
        ctx.fillText(w,mx,my-2);
      }
    }
  }

  // draw nodes
  const maxDeg=Math.max(...degree,1);
  for(let i=0;i<n;i++){
    const p=positions[i];
    const isHub=degree[i]/maxDeg>0.7;
    const isTwin=twinSet.has(i);
    const nodeR=Math.max(14,Math.min(26,14+10*(degree[i]/maxDeg)));
    // fill
    if(isTwin){
      ctx.fillStyle='rgba(10,125,82,0.18)';
      ctx.strokeStyle='rgba(10,125,82,0.55)';
    }else if(isHub){
      ctx.fillStyle='rgba(181,84,28,0.2)';
      ctx.strokeStyle='rgba(181,84,28,0.55)';
    }else{
      ctx.fillStyle='rgba(138,129,114,0.06)';
      ctx.strokeStyle='rgba(138,129,114,0.22)';
    }
    ctx.lineWidth=2;
    ctx.beginPath();
    ctx.arc(p.x,p.y,nodeR,0,Math.PI*2);
    ctx.fill();ctx.stroke();
    // label
    ctx.fillStyle='#57503f';
    ctx.font='600 12px "Source Sans 3",sans-serif';
    ctx.textAlign='center';
    ctx.textBaseline='middle';
    const label=vocab.display(vocab.order[i]);
    // truncate long labels
    const displayLabel=label.length>10?label.slice(0,9)+'…':label;
    ctx.fillText(displayLabel,p.x,p.y);
  }
}

// ── list of sentence chips ──────────────────────────────────────────────────
function renderList(){
  const host=document.getElementById('sentenceList');
  if(sentences.length===0){
    host.innerHTML='<div style="padding:.8rem;color:var(--muted);font-style:italic;font-size:.9rem">No sentences yet. Type one above or pick a preset.</div>';
    return;
  }
  host.innerHTML=sentences.map((s,i)=>
    `<div class="sentence-chip"><span class="sentence-text">${s.replace(/</g,'&lt;')}</span><button class="sentence-remove" data-idx="${i}" title="Remove">×</button></div>`
  ).join('');
  host.querySelectorAll('.sentence-remove').forEach(b=>{
    b.addEventListener('click',()=>{
      const i=parseInt(b.dataset.idx);
      sentences.splice(i,1);
      renderAll();
    });
  });
}
function renderAll(){renderList();renderMatrix();}

// input wiring
const inp=document.getElementById('sentenceInput');
const btnAdd=document.getElementById('btnAdd');
function tryAdd(){
  const v=inp.value.trim();
  if(!v)return;
  if(tokenise(v).length===0)return;
  sentences.push(v);
  inp.value='';
  renderAll();
}
btnAdd.addEventListener('click',tryAdd);
inp.addEventListener('keydown',e=>{if(e.key==='Enter')tryAdd();});

document.querySelectorAll('.preset-btn').forEach(b=>{
  b.addEventListener('click',()=>{
    const p=b.dataset.preset;
    if(p==='pets')sentences=[...PRESETS.pets];
    else if(p==='food')sentences=[...PRESETS.food];
    else if(p==='clear')sentences=[];
    else sentences=[...PRESETS.default];
    renderAll();
  });
});
document.querySelectorAll('.window-btn').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('.window-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    windowSize=parseInt(b.dataset.window);
    renderMatrix();
  });
});

renderAll();
window.addEventListener('resize',()=>renderMatrix());

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: sparse vs dense
// ═══════════════════════════════════════════════════════════════════════════
const vSlider=document.getElementById('vSlider');
const dSlider=document.getElementById('dSlider');
const vVal=document.getElementById('vVal');
const dVal=document.getElementById('dVal');

function fmt(n){
  if(n>=1e6)return(n/1e6).toFixed(1)+'M';
  if(n>=1e3)return(n/1e3).toFixed(0)+'K';
  return n.toString();
}
function bytes(n){
  // assume 4 bytes per float
  const b=n*4;
  if(b>=1024*1024)return(b/1024/1024).toFixed(1)+' MB';
  if(b>=1024)return(b/1024).toFixed(1)+' KB';
  return b+' B';
}

// build a small sparse matrix viz (12x12 grid)
function renderSparseMatrix(){
  const host=document.getElementById('sparseMatrix');
  const SZ=16;
  host.style.gridTemplateColumns=`repeat(${SZ},1fr)`;
  host.innerHTML='';
  // density: ~3-5% of cells lit, matches real sparse co-occurrence
  const total=SZ*SZ;
  const litCount=Math.floor(total*0.04);
  const lit=new Set();
  while(lit.size<litCount)lit.add(Math.floor(Math.random()*total));
  for(let i=0;i<total;i++){
    const d=document.createElement('div');
    d.className='scale-viz-cell'+(lit.has(i)?' lit':'');
    host.appendChild(d);
  }
}
function renderDenseBars(){
  const host=document.getElementById('denseBars');
  host.innerHTML='';
  const n=24;
  for(let i=0;i<n;i++){
    const b=document.createElement('div');
    b.className='scale-viz-dbar';
    const h=20+Math.random()*80;
    b.style.height=h+'%';
    host.appendChild(b);
  }
}

function updateScale(){
  const v=parseInt(vSlider.value);
  const d=parseInt(dSlider.value);
  vVal.textContent=v.toLocaleString();
  dVal.textContent=d.toLocaleString();
  document.getElementById('sparseShape').textContent=`shape: (${v.toLocaleString()},)`;
  document.getElementById('denseShape').textContent=`shape: (${d.toLocaleString()},)`;
  document.getElementById('sparseSize').textContent=bytes(v);
  document.getElementById('denseSize').textContent=bytes(d);
  // bars: sparse is always 100% relative to itself, dense relative to sparse
  document.getElementById('sparseBar').style.width='100%';
  const ratio=Math.max(0.5,Math.min(100,(d/v)*100));
  document.getElementById('denseBar').style.width=ratio+'%';
}
vSlider.addEventListener('input',updateScale);
dSlider.addEventListener('input',updateScale);
updateScale();
renderSparseMatrix();
renderDenseBars();

</script>
