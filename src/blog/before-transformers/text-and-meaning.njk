<script>
// image zoom
(function(){
  const modal=document.getElementById('img-modal'),mImg=document.getElementById('img-modal-img'),mCap=document.getElementById('img-modal-cap'),mClose=document.querySelector('.img-modal-close');
  if(!modal)return;
  document.querySelectorAll('.img-frame img').forEach(img=>{
    img.addEventListener('click',()=>{
      mImg.src=img.src;mImg.alt=img.alt||'';
      const cap=img.closest('.img-block')?.querySelector('.img-caption');
      mCap.textContent=cap?cap.textContent.trim():(img.alt||'');
      modal.classList.add('open');modal.setAttribute('aria-hidden','false');
    });
  });
  function close(){modal.classList.remove('open');modal.setAttribute('aria-hidden','true');mImg.src='';mCap.textContent='';}
  mClose.addEventListener('click',close);
  modal.addEventListener('click',e=>{if(e.target===modal)close();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))close();});
})();


// ── VIZ 1: Unicode inspector ─────────────────────────────────────────────────
const uniInput=document.getElementById('uniInput');
const uniGrid=document.getElementById('uniGrid');
function renderUnicode(txt){
  uniGrid.innerHTML='';
  // use Array.from to respect surrogate pairs / combining where possible
  const chars=Array.from(txt);
  chars.forEach((ch,i)=>{
    const cp=ch.codePointAt(0);
    const cell=document.createElement('div');
    cell.className='uni-cell'+(ch===' '?' space':'');
    cell.style.animationDelay=(i*0.03)+'s';
    const char=ch===' '?'space':ch;
    const hex='U+'+cp.toString(16).toUpperCase().padStart(4,'0');
    cell.innerHTML=`<div class="uni-cell-char">${char}</div><div class="uni-cell-code">${hex}</div><div class="uni-cell-dec">${cp}</div>`;
    uniGrid.appendChild(cell);
  });
  if(chars.length===0){
    uniGrid.innerHTML='<div style="color:var(--muted);font-style:italic;padding:.5rem">Start typing to see each character become a number.</div>';
  }
}
uniInput.addEventListener('input',e=>renderUnicode(e.target.value));
document.querySelectorAll('.uni-preset').forEach(b=>{
  b.addEventListener('click',()=>{
    uniInput.value=b.dataset.text;
    renderUnicode(b.dataset.text);
  });
});
renderUnicode(uniInput.value);

// ── VIZ 2: similarity ────────────────────────────────────────────────────────
const pairs=[
  {a:'cat',b:'car',human:'low',humanNote:'unrelated (animal vs vehicle)'},
  {a:'cat',b:'dog',human:'high',humanNote:'both animals, very related'},
  {a:'cat',b:'cap',human:'low',humanNote:'unrelated (animal vs hat)'},
  {a:'king',b:'queen',human:'high',humanNote:'both royalty, very related'},
  {a:'king',b:'kind',human:'low',humanNote:'coincidence of letters'}
];
function charOverlap(a,b){
  const sa=new Set(a),sb=new Set(b);
  const inter=[...sa].filter(c=>sb.has(c)).length;
  const union=new Set([...sa,...sb]).size;
  return union===0?0:inter/union;
}
function renderSim(){
  const host=document.getElementById('simRows');
  host.innerHTML='';
  pairs.forEach((p,idx)=>{
    const sim=charOverlap(p.a,p.b);
    const pct=Math.round(sim*100);
    const machineThinks=pct>=50?'similar':'different';
    let verdictClass='',verdictText='';
    if(p.human==='high'&&machineThinks==='similar'){verdictClass='intuitive';verdictText='matches intuition ✓';}
    else if(p.human==='low'&&machineThinks==='different'){verdictClass='intuitive';verdictText='matches intuition ✓';}
    else{verdictClass='misleading';verdictText='misleading! '+p.humanNote;}
    const row=document.createElement('div');
    row.className='sim-row';
    row.style.animationDelay=(idx*0.08)+'s';
    row.innerHTML=`
      <div class="sim-pair"><em>${p.a}</em> vs <em>${p.b}</em></div>
      <div class="sim-bar-wrap"><div class="sim-bar" style="width:0"></div><span class="sim-bar-label">${pct}%</span></div>
      <div class="sim-verdict ${verdictClass}">${verdictText}</div>`;
    host.appendChild(row);
    // animate bar
    setTimeout(()=>{row.querySelector('.sim-bar').style.width=pct+'%';},50+idx*80);
  });
}
renderSim();

// ── VIZ 3: tokeniser ─────────────────────────────────────────────────────────
// demonstration BPE, small hand-crafted vocabulary for recognisable merges
const bpeMerges=[
  'the','The','and','of','in','to','for','with','that','is','was','it','as','on','at',
  'ing','able','ness','tion','ment','ed','ly','er','est','un','re','pre','over','under',
  'forget','eat','cook','taste','pasta','un forget able','over cook ed',
  'hello','world','machine','learning','language','model','text','word'
];
// we will do simple greedy subword: try longest match from a vocab built on top of words
const bpeVocab=new Set([
  'the','The','of','in','to','for','with','and','is','was','it','as','on','at','a','an',
  'over','under','un','re','pre',
  'cook','ed','ing','able','ness','tion','ment','ly','er','est','s',
  'forget','eat','taste','pasta','walk','run','play',
  'hello','world','machine','learn','lang','uage','model','text','word','a','I',
  'of','my'
]);
function tokCharacter(txt){
  return Array.from(txt).map(c=>c===' '?'␣':c).filter(Boolean);
}
function tokWord(txt){
  // split on whitespace but preserve the tokens as typed
  const parts=txt.split(/(\s+)/).filter(x=>x!=='');
  return parts.map(p=>/^\s+$/.test(p)?'␣':p);
}
function tokSubword(txt){
  // split into whitespace-separated words, then greedy longest-match on vocab, fall back to chars
  const out=[];
  const parts=txt.split(/(\s+)/).filter(x=>x!=='');
  parts.forEach(p=>{
    if(/^\s+$/.test(p)){out.push('␣');return;}
    // try whole word lowercase first
    const low=p.toLowerCase();
    if(bpeVocab.has(low)){out.push(p);return;}
    // greedy from left
    let i=0;
    while(i<p.length){
      let matched=null;
      for(let j=p.length;j>i;j--){
        const sub=p.slice(i,j).toLowerCase();
        if(bpeVocab.has(sub)){matched={piece:p.slice(i,j),len:j-i};break;}
      }
      if(matched){
        out.push((i===0?'':'##')+matched.piece);
        i+=matched.len;
      }else{
        out.push((i===0?'':'##')+p[i]);
        i++;
      }
    }
  });
  return out;
}
let tokMode='word';
const tokInput=document.getElementById('tokInput');
const tokOutput=document.getElementById('tokOutput');
const tokCount=document.getElementById('tokCount');
const tokChars=document.getElementById('tokChars');
const tokModeLabel=document.getElementById('tokModeLabel');
function renderTokens(){
  const txt=tokInput.value;
  let tokens=[];
  if(tokMode==='char')tokens=tokCharacter(txt);
  else if(tokMode==='word')tokens=tokWord(txt);
  else tokens=tokSubword(txt);
  tokOutput.innerHTML='';
  tokens.forEach((t,i)=>{
    const chip=document.createElement('span');
    chip.className='tok-chip t'+(i%5);
    chip.textContent=t;
    chip.style.animationDelay=(i*0.015)+'s';
    tokOutput.appendChild(chip);
  });
  if(tokens.length===0){
    tokOutput.innerHTML='<span style="color:var(--muted);font-style:italic">Type something above.</span>';
  }
  tokCount.textContent=tokens.filter(t=>t!=='␣').length;
  tokChars.textContent=txt.length;
  tokModeLabel.textContent=tokMode==='char'?'character':tokMode==='word'?'word':'subword';
}
document.querySelectorAll('.tok-mode-btn').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('.tok-mode-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    tokMode=b.dataset.mode;
    renderTokens();
  });
});
tokInput.addEventListener('input',renderTokens);
renderTokens();

</script>
