    <rect x="250" y="167" width="50" height="3" rx="1.5" fill="#2e5a7d"/>
    <rect x="330" y="168" width="50" height="2" rx="1" fill="#8a8172"/>
    <circle cx="275" cy="168" r="24" fill="none" stroke="#57503f" stroke-width="1.5" stroke-dasharray="4 3"/>
    <line x1="296" y1="156" x2="446" y2="86" stroke="#57503f" stroke-width="1.5" stroke-dasharray="4 3"/>
