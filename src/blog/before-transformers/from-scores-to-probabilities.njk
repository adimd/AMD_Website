        </div>
        <div class="pipe-panels">
          <div class="pipe-panel">
            <div class="pipe-panel-title">Raw scores</div>
            <div class="pipe-panel-formula">v · c<sub>i</sub></div>
            <div class="pipe-panel-bars" id="panelRaw"></div>
            <div class="pipe-sum-line">range: <strong id="pipeRawRange">-</strong></div>
          </div>
          <div class="pipe-panel">
            <div class="pipe-panel-title">After exp</div>
            <div class="pipe-panel-formula">exp(v · c<sub>i</sub>)</div>
            <div class="pipe-panel-bars" id="panelExp"></div>
            <div class="pipe-z-line">Z = Σ exp(…) = <strong id="pipeZ">-</strong></div>
          </div>
          <div class="pipe-panel">
            <div class="pipe-panel-title">After ÷ Z</div>
            <div class="pipe-panel-formula">exp(…) / Z</div>
