<script>


// ═══════════════════════════════════════════════════════════════════════════
// SHARED: softmax helper
// ═══════════════════════════════════════════════════════════════════════════
function softmax(scores){
  // Compute probabilities stably with the max-subtraction trick,
  // but also return TRUE Z and TRUE exps (unshifted) so the displayed
  // numbers match the mathematical definitions users see in the prose.
  const m=Math.max(...scores);
  const shiftedExps=scores.map(s=>Math.exp(s-m));
  const shiftedZ=shiftedExps.reduce((a,b)=>a+b,0);
  const probs=shiftedExps.map(e=>e/shiftedZ);
  const scale=Math.exp(m);
  const exps=shiftedExps.map(e=>e*scale);
  const Z=shiftedZ*scale;
  return{probs,Z,exps,shift:m};
}

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 1: Softmax pipeline builder
// ═══════════════════════════════════════════════════════════════════════════
const PIPE_WORDS=[
  {word:'my',    score:2.4},
  {word:'dog',   score:1.8},
  {word:'friends',score:0.9},
  {word:'music', score:0.0},
  {word:'pizza', score:-1.2}
];
let pipeScores=PIPE_WORDS.map(w=>w.score);

const PIPE_PRESETS={
  balanced:   [1.0,0.8,0.5,0.2,-0.3],
  'one-winner':[3.5,0.5,0.3,0.1,-0.5],
  'two-rivals':[2.2,2.0,0.2,-0.5,-1.0],
  'all-negative':[-0.3,-0.8,-1.2,-1.8,-2.5]
};

function renderPipeSliders(){
  const host=document.getElementById('pipeSliders');
  host.innerHTML='';
  PIPE_WORDS.forEach((w,i)=>{
    const row=document.createElement('div');
    row.className='pipe-slider-row';
    row.innerHTML=`
      <div class="pipe-slider-label">
        <span class="pipe-slider-word">${w.word}</span>
        <span class="pipe-slider-val" id="pipeSlVal${i}">${pipeScores[i].toFixed(1)}</span>
      </div>
      <input type="range" class="pipe-slider" data-idx="${i}" min="-40" max="40" step="1" value="${pipeScores[i]*10}">
    `;
    host.appendChild(row);
  });
  host.querySelectorAll('input').forEach(s=>{
    s.addEventListener('input',e=>{
      const idx=parseInt(e.target.dataset.idx);
      pipeScores[idx]=parseFloat(e.target.value)/10;
      renderPipe();
    });
  });
}

function renderPipe(){
  // update slider readouts
  pipeScores.forEach((s,i)=>{
    const el=document.getElementById('pipeSlVal'+i);
    if(el)el.textContent=s.toFixed(1);
    // update the actual slider position (for presets)
    const input=document.querySelector(`.pipe-slider[data-idx="${i}"]`);
    if(input)input.value=s*10;
  });

  const {probs,Z,exps}=softmax(pipeScores);
  // raw
  renderPipePanel('panelRaw',pipeScores,'raw');
  renderPipePanel('panelExp',exps,'exp');
  renderPipePanel('panelProb',probs,'prob');
  // readouts
  const mn=Math.min(...pipeScores),mx=Math.max(...pipeScores);
  document.getElementById('pipeRawRange').textContent=`[${mn.toFixed(1)}, ${mx.toFixed(1)}]`;
  document.getElementById('pipeZ').textContent=Z.toFixed(2);
  document.getElementById('pipeSum').textContent=probs.reduce((a,b)=>a+b,0).toFixed(2);
}
function renderPipePanel(hostId,values,mode){
  const host=document.getElementById(hostId);
  host.innerHTML='';
  // scale bars relative to max abs value in this panel
  const absMax=Math.max(...values.map(v=>Math.abs(v)),1e-6);
  values.forEach((v,i)=>{
    const row=document.createElement('div');
    row.className='pipe-bar-row';
    // For raw panel, bars can be negative; render centred on the zero line.
    // For exp and prob, all non-negative, render from left.
    const word=PIPE_WORDS[i].word;
    let trackInner='';
    if(mode==='raw'){
      trackInner=`<div class="pipe-bar-zero" style="left:50%"></div>`;
      const pct=Math.abs(v)/absMax*48; // half-width
      if(v>=0){
        trackInner+=`<div class="pipe-bar-fill" style="left:50%;width:${pct}%;background:var(--accent)"></div>`;
      }else{
        trackInner+=`<div class="pipe-bar-fill" style="right:50%;width:${pct}%;background:var(--red)"></div>`;
      }
    }else if(mode==='exp'){
      const pct=v/absMax*98;
      trackInner=`<div class="pipe-bar-fill" style="left:0;width:${pct}%;background:var(--blue)"></div>`;
    }else{
      // prob 0..1
      const pct=v*100;
      trackInner=`<div class="pipe-bar-fill" style="left:0;width:${pct}%;background:var(--green)"></div>`;
    }
    const valStr=mode==='raw'?v.toFixed(1):mode==='exp'?v.toFixed(2):(v*100).toFixed(0)+'%';
    row.innerHTML=`
      <span class="pipe-bar-word">${word}</span>
      <div class="pipe-bar-track">${trackInner}</div>
      <span class="pipe-bar-val">${valStr}</span>
    `;
    host.appendChild(row);
  });
}

document.querySelectorAll('.pipe-preset').forEach(b=>{
  b.addEventListener('click',()=>{
    pipeScores=[...PIPE_PRESETS[b.dataset.preset]];
    renderPipe();
  });
});
renderPipeSliders();
renderPipe();

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 2: Temperature / sharpening
// ═══════════════════════════════════════════════════════════════════════════
const TEMP_WORDS=['my','dog','friends','music','pizza'];
const TEMP_SCORES=[2.0,1.5,0.8,0.2,-0.5];
const TEMP_COLORS=['#b5541c','#2e5a7d','#0a7d52','#7c4dbc','#a83c2c'];

function renderTemp(){
  const beta=parseFloat(document.getElementById('tempSlider').value)/10;
  document.getElementById('tempVal').textContent=beta.toFixed(1);
  const scaled=TEMP_SCORES.map(s=>s*beta);
  const {probs}=softmax(scaled);

  // update mode label
  const modeEl=document.getElementById('tempMode');
  const pmax=Math.max(...probs);
  if(pmax>0.9){modeEl.className='temp-mode peaked';modeEl.textContent='→ approaches argmax';}
  else if(pmax>0.55){modeEl.className='temp-mode peaked';modeEl.textContent='peaked';}
  else if(pmax>0.35){modeEl.className='temp-mode';modeEl.textContent='balanced';}
  else{modeEl.className='temp-mode soft';modeEl.textContent='nearly uniform';}

  // entropy in bits
  let H=0;
  probs.forEach(p=>{if(p>1e-12)H+=-p*Math.log2(p);});
  document.getElementById('tempH').textContent=H.toFixed(2);
  document.getElementById('tempPmax').textContent=pmax.toFixed(3);

  drawTempChart(probs);
}
function drawTempChart(probs){
  const canvas=document.getElementById('tempCanvas');
  const dpr=window.devicePixelRatio||1;
  const W=canvas.clientWidth||700,H=240;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);

  // grid
  ctx.strokeStyle='rgba(138,129,114,.06)';ctx.lineWidth=1;
  for(let i=1;i<10;i++){const y=30+i*(H-70)/10;ctx.beginPath();ctx.moveTo(50,y);ctx.lineTo(W-30,y);ctx.stroke();}

  // baseline
  ctx.strokeStyle='rgba(138,129,114,.2)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(50,H-40);ctx.lineTo(W-30,H-40);ctx.stroke();

  // "1" line
  ctx.strokeStyle='rgba(10,125,82,.5)';ctx.lineWidth=1.5;
  ctx.setLineDash([5,4]);
  ctx.beginPath();ctx.moveTo(50,30);ctx.lineTo(W-30,30);ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle='rgba(10,125,82,.8)';
  ctx.font='11px "Courier New",monospace';
  ctx.textAlign='right';
  ctx.fillText('P = 1',W-35,24);

  // y-axis labels
  ctx.fillStyle='rgba(138,129,114,.6)';
  ctx.font='10px "Courier New",monospace';
  ctx.textAlign='right';
  ctx.fillText('1.0',44,34);
  ctx.fillText('0.5',44,(30+H-40)/2+3);
  ctx.fillText('0.0',44,H-36);

  // bars
  const n=probs.length;
  const gap=14;
  const barW=(W-80-gap*(n-1))/n;
  probs.forEach((p,i)=>{
    const x=60+i*(barW+gap);
    const barH=p*(H-70);
    const y=H-40-barH;
    ctx.fillStyle=TEMP_COLORS[i]+'cc';
    ctx.strokeStyle=TEMP_COLORS[i];
    ctx.lineWidth=1.5;
    ctx.beginPath();
    if(ctx.roundRect)ctx.roundRect(x,y,barW,barH,6);
    else ctx.rect(x,y,barW,barH);
    ctx.fill();ctx.stroke();
    // label
    ctx.fillStyle='#57503f';
    ctx.font='600 11px "Source Sans 3",sans-serif';
    ctx.textAlign='center';
    ctx.fillText(TEMP_WORDS[i],x+barW/2,H-22);
    // value
    ctx.fillStyle=TEMP_COLORS[i];
    ctx.font='600 11px "Courier New",monospace';
    const valTxt=p>=0.01?p.toFixed(2):p.toExponential(1);
    ctx.fillText(valTxt,x+barW/2,y-6);
  });
}
document.getElementById('tempSlider').addEventListener('input',renderTemp);
renderTemp();
window.addEventListener('resize',renderTemp);

// ═══════════════════════════════════════════════════════════════════════════
// VIZ 3: Redistributive pressure
// ═══════════════════════════════════════════════════════════════════════════
const REDIST_WORDS=['my','dog','friends','music','pizza'];
// fixed baseline scores for all other words
const REDIST_BASE=[1.0,0.5,0.0,-0.5];  // dog, friends, music, pizza
let redistBaseline=null; // snapshot of probs when slider is at default

function redistCompute(myScore){
  const scores=[myScore,...REDIST_BASE];
  return softmax(scores).probs;
}

function renderRedist(){
  const raw=parseFloat(document.getElementById('redistSlider').value)/10;
  document.getElementById('redistScore').textContent=raw.toFixed(1);
  const probs=redistCompute(raw);

  // initialise baseline on first call
  if(!redistBaseline)redistBaseline=[...probs];

  const host=document.getElementById('redistRows');
  host.innerHTML='';
  probs.forEach((p,i)=>{
    const base=redistBaseline[i];
    const delta=p-base;
    const isTarget=i===0;
    const row=document.createElement('div');
    row.className='redist-row';
    const pct=p*100;
    // Delta arrow / text
    let deltaStr='';
    let deltaClass='';
    if(Math.abs(delta)<0.003){
      deltaStr='0.0%';
      deltaClass='';
    }else if(delta>0){
      deltaStr='+'+(delta*100).toFixed(1)+'%';
      deltaClass='up';
    }else{
      deltaStr=(delta*100).toFixed(1)+'%';
      deltaClass='down';
    }
    row.innerHTML=`
      <span class="redist-word ${isTarget?'target':''}">${REDIST_WORDS[i]}</span>
      <div class="redist-bar-track">
        <div class="redist-bar-fill ${isTarget?'target':''}" style="width:${pct}%"></div>
      </div>
      <span class="redist-val">${pct.toFixed(1)}%</span>
      <span class="redist-delta ${deltaClass}">${deltaStr}</span>
    `;
    host.appendChild(row);
  });
  document.getElementById('redistSum').textContent=probs.reduce((a,b)=>a+b,0).toFixed(2);
}
document.getElementById('redistSlider').addEventListener('input',renderRedist);
renderRedist();

</script>
