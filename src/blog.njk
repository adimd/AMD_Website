---
layout: base.njk
title: Blog
---

<div class="page-hero">
  <div>
    <h1>Blog</h1>
    <p class="subtitle">Long-form series, read like chapters. I like to understand things from first principles, and that's how these are built.</p>
  </div>
  <div class="hero-device">
    <svg viewBox="0 0 150 120" role="img" aria-label="A stack of open books">
      <rect x="26" y="78" width="98" height="14" rx="3" fill="#8a3e2e"/>
      <rect x="34" y="64" width="86" height="14" rx="3" fill="#2e5a7d"/>
      <g transform="rotate(-6 76 52)">
        <rect x="38" y="46" width="78" height="14" rx="3" fill="#8a6a1e"/>
      </g>
      <path d="M64 30 Q75 22 86 30 L86 40 Q75 33 64 40 Z" fill="#0a7d52"/>
    </svg>
  </div>
</div>

<div class="proj-list">
  {% for key, s in series %}
  <a class="proj-card" href="/blog/{{ key }}/">
    <div class="proj-icon">
      {% if key == 'pointers' %}
      <svg viewBox="0 0 96 96" aria-hidden="true">
        <rect x="8" y="36" width="34" height="26" rx="6" fill="#241f18"/>
        <text x="25" y="53" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" fill="#e0c06a">0x2A</text>
        <line x1="44" y1="49" x2="60" y2="49" stroke="#b5541c" stroke-width="3"/>
        <path d="M56 43 L64 49 L56 55" fill="none" stroke="#b5541c" stroke-width="3"/>
        <rect x="64" y="36" width="26" height="26" rx="6" fill="none" stroke="#0a7d52" stroke-width="3"/>
        <text x="77" y="54" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="13" fill="#0a7d52">5</text>
        <text x="52" y="30" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="18" font-weight="700" fill="#b5541c">*</text>
        <text x="24" y="84" font-family="JetBrains Mono, monospace" font-size="13" fill="#8a8172">&amp;x</text>
      </svg>
      {% elif key == 'the-mathematics-ml-runs-on' %}
      <svg viewBox="0 0 96 96" aria-hidden="true">
        <text x="14" y="46" font-family="JetBrains Mono, monospace" font-size="26" font-weight="700" fill="#b5541c">&#931;</text>
        <line x1="46" y1="38" x2="82" y2="38" stroke="#0a7d52" stroke-width="3" stroke-linecap="round"/>
        <text x="46" y="66" font-family="JetBrains Mono, monospace" font-size="15" fill="#57503f">0.1+0.2</text>
        <text x="24" y="86" font-family="JetBrains Mono, monospace" font-size="13" fill="#8a8172">&#8800; 0.3</text>
      </svg>
      {% else %}
      <svg viewBox="0 0 96 96" aria-hidden="true">
        <circle cx="26" cy="30" r="7" fill="none" stroke="#2e5a7d" stroke-width="3"/>
        <circle cx="70" cy="26" r="7" fill="none" stroke="#b5541c" stroke-width="3"/>
        <circle cx="48" cy="62" r="7" fill="none" stroke="#0a7d52" stroke-width="3"/>
        <line x1="32" y1="34" x2="42" y2="56" stroke="#8a8172" stroke-width="2"/>
        <line x1="64" y1="31" x2="54" y2="56" stroke="#8a8172" stroke-width="2"/>
        <line x1="33" y1="30" x2="63" y2="27" stroke="#8a8172" stroke-width="2" stroke-dasharray="4 3"/>
        <text x="24" y="88" font-family="JetBrains Mono, monospace" font-size="12" fill="#8a8172">softmax</text>
      </svg>
      {% endif %}
    </div>
    <div>
      {% set liveCount = s.chapters | selectattr("live") | list | length %}
      <p class="proj-status">{% if liveCount == s.chapters | length %}Complete &middot; {{ liveCount }} chapters{% else %}{{ liveCount }} of {{ s.chapters | length }} chapters live{% endif %}</p>
      <h2>{{ s.title }}</h2>
      <p class="summary">{{ s.blurb }}</p>
      <span class="proj-cta">Start at chapter one</span>
    </div>
  </a>
  {% endfor %}

  <div class="proj-card coming">
    <div class="proj-icon">
      <svg viewBox="0 0 96 96" aria-hidden="true">
        <circle cx="48" cy="48" r="30" fill="none" stroke="#c5c0b4" stroke-width="3" stroke-dasharray="6 6"/>
        <line x1="48" y1="36" x2="48" y2="60" stroke="#c5c0b4" stroke-width="3" stroke-linecap="round"/>
        <line x1="36" y1="48" x2="60" y2="48" stroke="#c5c0b4" stroke-width="3" stroke-linecap="round"/>
      </svg>
    </div>
    <div>
      <p class="proj-status" style="color: var(--muted);">Coming</p>
      <h2>Standalone posts</h2>
      <p class="summary">Shorter one-off pieces will live here between the series.</p>
    </div>
  </div>
</div>
