<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}{% if title %} | {% endif %}Adithya MD</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/theme.css">
</head>
<body>

<header class="site-header">
  <div class="nav-container">
    <a href="/" class="brand">
      <span class="brand-mark">{{ nav.brand.initials }}</span>
      <span class="brand-text">{{ nav.brand.name }}</span>
    </a>
    <nav class="nav-links">
      {% for link in nav.links %}
        <a href="{{ link.url }}">{{ link.label }}</a>
      {% endfor %}
    </nav>
    <button class="hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-overlay" id="mobileMenu">
  <a href="/">Home</a>
  {% for link in nav.links %}
    <a href="{{ link.url }}">{{ link.label }}</a>
  {% endfor %}
</div>

{{ content | safe }}

<footer class="site-footer">
  <p class="footer-tagline">{{ nav.footer.tagline }}</p>
  <p class="footer-copy">&copy; <span id="year"></span> {{ nav.footer.copy }}</p>
</footer>

<script>
  document.getElementById("year").textContent = new Date().getFullYear();
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburger.addEventListener('click', () => {
    hamburger.classList.toggle('active');
    mobileMenu.classList.toggle('active');
    document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
  });
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      hamburger.classList.remove('active');
      mobileMenu.classList.remove('active');
      document.body.style.overflow = '';
    });
  });
</script>
</body>
</html>
