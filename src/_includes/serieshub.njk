---
layout: base.njk
---
{% set s = series[seriesKey] %}
<nav class="breadcrumb">
  <a href="/blog/">Blog</a>
  <span>/</span>
  <span>{{ s.title }}</span>
</nav>

<div class="page-hero">
  <div>
    <h1>{{ s.title }}</h1>
    <p class="subtitle">{{ s.chapters | selectattr("live") | list | length }} of {{ s.chapters | length }} chapters live &middot; read in order</p>
  </div>
</div>

<div class="arc-wrap">
  <p style="font-size:1.02rem; max-width:680px; margin-bottom:1.2rem;">{{ s.blurb }}</p>
  {% for ch in s.chapters %}
    {% if ch.live %}
  <a class="class-row" href="/blog/{{ seriesKey }}/{{ ch.slug }}/">
    <span class="no">{{ loop.index if loop.index > 9 else '0' + loop.index }}</span>
    <span class="ti">{{ ch.short }}<span style="display:block; font-family:var(--mono); font-size:0.72rem; color:var(--muted); margin-top:0.1rem;">{{ ch.note }}</span></span>
    <span class="st">read</span>
  </a>
    {% else %}
  <div class="class-row soon">
    <span class="no">{{ loop.index if loop.index > 9 else '0' + loop.index }}</span>
    <span class="ti">{{ ch.short }}<span style="display:block; font-family:var(--mono); font-size:0.72rem; color:var(--muted); margin-top:0.1rem;">{{ ch.note }}</span></span>
    <span class="st">coming</span>
  </div>
    {% endif %}
  {% endfor %}
</div>
