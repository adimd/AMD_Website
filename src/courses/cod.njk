      - { n: 4,  ti: "Why binary, and where does decimal go?", file: COD-04-why-binary.html }                                       # CHECK
      - { n: 5,  ti: How do we move between bases?, file: COD-05-how-do-we-move-between-bases.html }                                # CHECK
      - { n: 6,  ti: Does the base matter?, file: COD-06-does-the-base-matter.html }                                                # CHECK
      - { n: 7,  ti: What if the container is finite?, file: COD-07-what-if-the-container-is-finite.html }                           # CHECK
      - { n: 8,  ti: How do we represent negative numbers?, file: COD-08-how-do-we-represent-negative-numbers.html }                 # CHECK
      - { n: 9,  ti: What about fractions?, file: COD-09-what-about-fractions.html }                                                # CHECK
      - { n: 10, ti: What if the point could move?, file: COD-10-what-if-the-point-could-move.html }                                 # CHECK
      - { n: 11, ti: How does IEEE 754 actually work?, file: COD-11-how-does-ieee-754-actually-work.html }                           # CHECK
