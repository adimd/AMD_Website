<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · {{ subtitle }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Source+Sans+3:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#15171b;
    --paper:#f7f5f0;
    --card:#fffefb;
    --rule:#ddd8cd;
    --mute:#6b665d;
    --accent:#23408f;
    --ok:#146b5c;
    --amber:#b06a12;
    --hi:#e8952b;
    --violet:#6b3fa0;
    --fail:#a8231f;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Source Sans 3',system-ui,sans-serif;
    font-size:17px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:860px;margin:0 auto;padding:64px 24px 120px}

  /* masthead */
  header.top{border-bottom:2px solid var(--ink);padding-bottom:26px;margin-bottom:46px}
  header.top .course{
    font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--accent);margin:0 0 14px
  }
  header.top h1{
    font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:46px;
    line-height:1.06;margin:0 0 10px;letter-spacing:-.01em
  }
  header.top .sub{
    font-family:'Fraunces',Georgia,serif;font-style:italic;font-weight:400;
    font-size:23px;color:var(--mute);margin:0 0 22px
  }
  header.top .meta{
    font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--mute);margin:0
  }
  header.top .count{color:var(--ok);font-weight:600}

  /* arc block */
  .arc{margin:0 0 52px}
  .arc .range{
    font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.12em;
    text-transform:uppercase;color:var(--accent);margin:0 0 4px
  }
  .arc h2{
    font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:27px;
    margin:0 0 4px;letter-spacing:-.005em
  }
  .arc .opens{
    font-family:'Fraunces',Georgia,serif;font-style:italic;font-size:17.5px;
    color:var(--mute);margin:0 0 18px
  }

  /* rows */
  .class-row{
    display:flex;align-items:baseline;gap:16px;
    padding:11px 16px;margin:0 0 6px;
    background:var(--card);border:1px solid var(--rule);border-radius:3px;
    text-decoration:none;color:inherit;
    transition:border-color .13s,transform .13s,background .13s;
  }
  a.class-row:hover{
    border-color:var(--accent);transform:translateX(3px);background:#fff
  }
  a.class-row:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .class-row .no{
    font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:600;
    color:var(--accent);min-width:26px;text-align:right;flex:none
  }
  .class-row .ti{flex:1;font-size:17px}
  .class-row .st{
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.07em;
    text-transform:uppercase;color:var(--ok);flex:none
  }
  .class-row.soon{background:transparent;border-style:dashed;border-color:#e2ded4}
  .class-row.soon .no,.class-row.soon .ti{color:#9a948a}
  .class-row.soon .st{color:#b3ada2}

  footer.foot{
    margin-top:72px;padding-top:22px;border-top:1px solid var(--rule);
    font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mute)
  }
  footer.foot p{margin:0 0 6px}
  footer.foot kbd{
    font-family:'JetBrains Mono',monospace;font-size:11px;
    background:#eceae3;border:1px solid var(--rule);border-radius:3px;
    padding:1px 5px;color:var(--ink)
  }

  @media (max-width:620px){
    .wrap{padding:40px 16px 80px}
    header.top h1{font-size:34px}
    header.top .sub{font-size:19px}
    .class-row{gap:11px;padding:10px 12px}
    .class-row .st{display:none}
  }
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <p class="course">Chanakya University · EAI213</p>
    <h1>{{ title }}</h1>
    <p class="sub">{{ subtitle }}</p>
    <p class="meta">
      {{ meta }} ·
      <span class="count">{{ live }} of 50 decks live</span>
    </p>
  </header>

  {% for a in arcs %}
  <div class="arc">
    <p class="range">{{ a.range }}</p>
    <h2>{{ a.name }}</h2>
    <p class="opens">{{ a.opens }}</p>

    {% for c in a.classes %}
      {% if c.file %}
    <a class="class-row" href="/courses/cod/{{ c.file }}">
      <span class="no">{{ c.n }}</span><span class="ti">{{ c.ti }}</span><span class="st">open deck</span>
    </a>
      {% else %}
    <div class="class-row soon">
      <span class="no">{{ c.n }}</span><span class="ti">{{ c.ti }}</span><span class="st">coming</span>
    </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endfor %}

  <footer class="foot">
    <p>Decks open in a new page. Move with <kbd>&larr;</kbd> <kbd>&rarr;</kbd>, index with <kbd>o</kbd>, cues with <kbd>n</kbd>, fullscreen with <kbd>f</kbd>.</p>
    <p>A computer contains no numbers. It contains voltages, and circuits built to interpret them as numbers.</p>
  </footer>

</div>
</body>
</html>
